  #[9, 0, 5, 7, 2, 4, 10, 15, 14, 1, 11, 12, 6, 8, 3, 13], #[2, 12, 6, 10, 0, 11, 8, 3, 4, 13, 7, 5, 15, 14, 1, 9],
  #[12, 5, 1, 15, 14, 13, 4, 10, 0, 7, 6, 3, 9, 2, 8, 11], #[13, 11, 7, 14, 12, 1, 3, 9, 5, 0, 15, 4, 8, 6, 2, 10],
  #[6, 15, 14, 9, 11, 3, 0, 8, 12, 2, 13, 7, 1, 4, 10, 5], #[10, 2, 8, 4, 7, 6, 1, 5, 15, 11, 9, 14, 3, 12, 13, 0]]
sha256 e2ac8da28f4545eeb56d9249ca2d84961aebfb06a3e061b186909f4b5b3b5724
def M0Crypto.Spec.Blake2s.G : M0Crypto.Spec.Blake2s.Word →
  M0Crypto.Spec.Blake2s.Word →
    M0Crypto.Spec.Blake2s.Word →
      M0Crypto.Spec.Blake2s.Word →
        M0Crypto.Spec.Blake2s.Word →
          M0Crypto.Spec.Blake2s.Word →
            M0Crypto.Spec.Blake2s.Word ×
              M0Crypto.Spec.Blake2s.Word × M0Crypto.Spec.Blake2s.Word × M0Crypto.Spec.Blake2s.Word :=
  fun a b c d x y =>
  have a := a + b + x;
  have d := M0Crypto.Spec.Blake2s.rotr (d ^^^ a) 16;
  have c := c + d;
  have b := M0Crypto.Spec.Blake2s.rotr (b ^^^ c) 12;
  have a := a + b + y;
  have d := M0Crypto.Spec.Blake2s.rotr (d ^^^ a) 8;
  have c := c + d;
  have b := M0Crypto.Spec.Blake2s.rotr (b ^^^ c) 7;
  (a, b, c, d)
