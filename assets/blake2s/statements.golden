        BitVec.toNat (s.regs 13) % 4 = 0 →
          176 ≤ BitVec.toNat (s.regs 13) →
            BitVec.toNat (s.regs 0) % 4 = 0 →
              BitVec.toNat (s.regs 1) % 4 = 0 →
                BitVec.getLsbD (s.regs 14) 0 = Bool.true →
                  M0Crypto.Release.Frame.Disj base M0Crypto.Artifacts.Release.size
                      (M0Crypto.Release.Blake2sCompress.fpOf s) 136 →
                    M0Crypto.Release.Frame.Disj base M0Crypto.Artifacts.Release.size (s.regs 0) 32 →
                      M0Crypto.Release.Frame.Disj (s.regs 0) 32 (M0Crypto.Release.Blake2sCompress.fpOf s) 136 →
                        M0Crypto.Release.Frame.Disj (s.regs 1) 64 (M0Crypto.Release.Blake2sCompress.fpOf s) 136 →
                          M0Crypto.Armv6M.read32 s.mem (s.regs 13) = 0#32 ∨
