inductive M0Crypto.Release.Blake2s.HashConstantTimeHyp : M0Crypto.Release.Blake2s.Init.Ctx →
  M0Crypto.Release.Blake2s.Init.Ctx →
    M0Crypto.Armv6M.State →
      M0Crypto.Armv6M.State →
        M0Crypto.Armv6M.State →
          M0Crypto.Armv6M.State →
            M0Crypto.Armv6M.State →
              M0Crypto.Armv6M.State →
                List (M0Crypto.Armv6M.State × M0Crypto.Armv6M.State) →
                  List (M0Crypto.Armv6M.State × M0Crypto.Armv6M.State) → Prop
  | M0Crypto.Release.Blake2s.HashConstantTimeHyp.mk : ∀ {ci ci' : M0Crypto.Release.Blake2s.Init.Ctx} {s0 s0' t0 t0' sf sf' : M0Crypto.Armv6M.State}
  {calls calls' : List (M0Crypto.Armv6M.State × M0Crypto.Armv6M.State)},
  M0Crypto.Release.Blake2s.Init.Pre ci s0 →
    M0Crypto.Release.Blake2s.Init.Pre ci' s0' →
      ci.pub = ci'.pub →
        (∃ fuel tr, M0Crypto.Thumb.runUntil ci.ret fuel s0 = Except.ok (t0, tr)) →
          (∃ fuel tr, M0Crypto.Thumb.runUntil ci'.ret fuel s0' = Except.ok (t0', tr)) →
            M0Crypto.Release.Blake2s.UpdatesRan ci.base ci.context t0.mem calls →
              M0Crypto.Release.Blake2s.UpdatesRan ci.base ci.context t0'.mem calls' →
                List.map (fun p => M0Crypto.Release.Blake2s.Update.pubAt p.fst) calls =
                    List.map (fun p => M0Crypto.Release.Blake2s.Update.pubAt p.fst) calls' →
                  (List.map (fun p => BitVec.toNat (p.fst.regs 2)) calls).sum < 2 ^ 64 →
                    M0Crypto.Release.Blake2s.ContextKept ci.context (M0Crypto.Release.Blake2s.lastMem t0.mem calls) sf →
                      M0Crypto.Release.Blake2s.ContextKept ci.context (M0Crypto.Release.Blake2s.lastMem t0'.mem calls')
                          sf' →
                        M0Crypto.Release.Blake2s.Final.EntryOn ci.base ci.context sf →
                          M0Crypto.Release.Blake2s.Final.EntryOn ci.base ci.context sf' →
                            M0Crypto.Release.Blake2s.Final.pubAt sf = M0Crypto.Release.Blake2s.Final.pubAt sf' →
                              M0Crypto.Release.Blake2s.HashConstantTimeHyp ci ci' s0 s0' t0 t0' sf sf' calls calls'
