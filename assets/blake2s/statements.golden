  fun s y =>
  (∃ o, o < 160 ∧ y = s.regs 13 - 160#32 + BitVec.ofNat 32 o) ∨
    (∃ o, o < 112 ∧ y = s.regs 0 + BitVec.ofNat 32 o) ∨ ∃ o, o < 32 ∧ y = s.regs 1 + BitVec.ofNat 32 o
def M0Crypto.Release.Blake2sFinal.params : M0Crypto.Armv6M.Word → M0Crypto.Armv6M.State → M0Crypto.Release.ConstantTime.Params :=
  fun base s => { base := base, sp0 := s.regs 13, lr0 := s.regs 14, size := M0Crypto.Artifacts.Release.bytes.length }
