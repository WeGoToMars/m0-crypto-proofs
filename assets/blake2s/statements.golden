def M0Crypto.Release.Blake2s.UpdatesReturn : M0Crypto.Armv6M.Word →
  M0Crypto.Armv6M.Word → M0Crypto.Armv6M.Mem → List M0Crypto.Armv6M.State → (M0Crypto.Armv6M.Mem → Prop) → Prop :=
  fun base c x x_1 x_2 =>
  List.brecOn (motive := fun x => M0Crypto.Armv6M.Mem → (M0Crypto.Armv6M.Mem → Prop) → Prop) x_1
    (M0Crypto.Release.Blake2s.UpdatesReturn._f base c) x x_2
unfold M0Crypto.Release.Blake2s.UpdatesReturn.eq_def : ∀ (base c : M0Crypto.Armv6M.Word) (x : M0Crypto.Armv6M.Mem) (x_1 : List M0Crypto.Armv6M.State)
  (x_2 : M0Crypto.Armv6M.Mem → Prop),
  M0Crypto.Release.Blake2s.UpdatesReturn base c x x_1 x_2 =
    match x, x_1, x_2 with
    | m, [], K => K m
    | m, s :: rest, K =>
      M0Crypto.Release.Blake2s.ContextKept c m s →
        M0Crypto.Release.Blake2s.Update.EntryOn base c s →
          ∃ fuel w tr,
            M0Crypto.Thumb.runUntil (M0Crypto.Release.Blake2s.returnAddr s) fuel s = Except.ok (w, tr) ∧
              M0Crypto.Release.Blake2s.UpdatesReturn base c w.mem rest K
