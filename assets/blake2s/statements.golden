def M0Crypto.Spec.Blake2s.bytesOfWord : M0Crypto.Spec.Blake2s.Word → List M0Crypto.Spec.Blake2s.Byte :=
  fun w => [BitVec.extractLsb' 0 8 w, BitVec.extractLsb' 8 8 w, BitVec.extractLsb' 16 8 w, BitVec.extractLsb' 24 8 w]
sha256 995be107f1f54210c3898e032a2c3edd3e0e6c8ba427d64dd5c94cbc058a68ed
def M0Crypto.Spec.Blake2s.pad : List M0Crypto.Spec.Blake2s.Byte → List M0Crypto.Spec.Blake2s.Byte :=
  fun bs => bs ++ List.replicate (64 - bs.length) 0#8
sha256 fe329a6c5dbea6176e7dcc1a419cfa79cf95d5300b67ebb107368086a9afaf12
def M0Crypto.Spec.Blake2s.blockWords : List M0Crypto.Spec.Blake2s.Byte → Array M0Crypto.Spec.Blake2s.Word :=
  fun bs => (M0Crypto.Spec.Blake2s.wordsOfBytes (M0Crypto.Spec.Blake2s.pad bs)).toArray
sha256 0966fc2f5263b2237825f91d1babc60bd8db2c293a3ddf8679758f836fc41c8c
def M0Crypto.Spec.Blake2s.h0 : Array M0Crypto.Spec.Blake2s.Word :=
  M0Crypto.Spec.Blake2s.IV.set! 0 (M0Crypto.Spec.Blake2s.IV[0]! ^^^ 16842784#32)
sha256 77170a3f47c6eca8430b30cfd05a28253232c1350b9e0a5ff14fc2552c16c25d
def M0Crypto.Spec.Blake2s.digestOf : Array M0Crypto.Spec.Blake2s.Word → List M0Crypto.Spec.Blake2s.Byte :=
  fun h => List.flatMap M0Crypto.Spec.Blake2s.bytesOfWord (List.take 8 h.toList)
sha256 13a883435d124d368a279a1de9e6c1e897ae0b295e1df37bd842f3ced8f8a568
def M0Crypto.Spec.Blake2s.loop : Array M0Crypto.Spec.Blake2s.Word → Nat → List M0Crypto.Spec.Blake2s.Byte → Array M0Crypto.Spec.Blake2s.Word :=
  fun h c msg => M0Crypto.Spec.Blake2s.loop._unary ⟨h, ⟨c, msg⟩⟩
unfold M0Crypto.Spec.Blake2s.loop.eq_def : ∀ (h : Array M0Crypto.Spec.Blake2s.Word) (c : Nat) (msg : List M0Crypto.Spec.Blake2s.Byte),
  M0Crypto.Spec.Blake2s.loop h c msg =
    if hl : 64 < msg.length then
      M0Crypto.Spec.Blake2s.loop
        (M0Crypto.Spec.Blake2s.compress h (M0Crypto.Spec.Blake2s.blockWords (List.take 64 msg)) (c + 64) Bool.false)
        (c + 64) (List.drop 64 msg)
    else M0Crypto.Spec.Blake2s.compress h (M0Crypto.Spec.Blake2s.blockWords msg) (c + msg.length) Bool.true
sha256 cae6be31736f221761ff583189ff776ac09c7e5aed600296392b64eddaa3f2d7
def M0Crypto.Spec.Blake2s.blake2s : List M0Crypto.Spec.Blake2s.Byte → List M0Crypto.Spec.Blake2s.Byte :=
  fun msg => M0Crypto.Spec.Blake2s.digestOf (M0Crypto.Spec.Blake2s.loop M0Crypto.Spec.Blake2s.h0 0 msg)
sha256 459472c3038fa71ee7502e5c040a493bff4f5e517054f06c270414f7a2230aad
inductive M0Crypto.Spec.Blake2s.State : Type
  | M0Crypto.Spec.Blake2s.State.mk : Array M0Crypto.Spec.Blake2s.Word → Nat → List M0Crypto.Spec.Blake2s.Byte → M0Crypto.Spec.Blake2s.State
sha256 53db86374b559d9f94c651dfad83c870035f6edc39e0a64486bc83c14ce431d9
def M0Crypto.Spec.Blake2s.State.init : M0Crypto.Spec.Blake2s.State :=
  { h := M0Crypto.Spec.Blake2s.h0, count := 0, pending := [] }
sha256 8eb6fc8352fb925cfd4772d62f154c1d2e22f7e1b4577db124446727c90cb895
def M0Crypto.Spec.Blake2s.State.push : M0Crypto.Spec.Blake2s.State → M0Crypto.Spec.Blake2s.Byte → M0Crypto.Spec.Blake2s.State :=
  fun s b =>
  if s.pending.length = 64 then
    { h := M0Crypto.Spec.Blake2s.compress s.h (M0Crypto.Spec.Blake2s.blockWords s.pending) (s.count + 64) Bool.false,
      count := s.count + 64, pending := [b] }
  else { h := s.h, count := s.count, pending := s.pending ++ [b] }
sha256 674a753f9f69c16a8d23418c8a7298a69d72addc9291506be6016fd37052a7b0
def M0Crypto.Spec.Blake2s.absorb : M0Crypto.Spec.Blake2s.State → List M0Crypto.Spec.Blake2s.Byte → M0Crypto.Spec.Blake2s.State :=
  fun s bs => List.foldl M0Crypto.Spec.Blake2s.State.push s bs
sha256 fa9b285a4bd4147621724e6d70c24bd7ceaefbe5bebe3cfae5a27af517d9e6ac
def M0Crypto.Spec.Blake2s.finish : M0Crypto.Spec.Blake2s.State → List M0Crypto.Spec.Blake2s.Byte :=
  fun s =>
  M0Crypto.Spec.Blake2s.digestOf
    (M0Crypto.Spec.Blake2s.compress s.h (M0Crypto.Spec.Blake2s.blockWords s.pending) (s.count + s.pending.length)
      Bool.true)
sha256 42f8956e04ba0af1601ba629aa184cc40896baa1a4bafa949f726147c3db3840
