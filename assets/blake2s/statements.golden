        M0Crypto.Armv6M.State → (M0Crypto.Armv6M.Word → Prop) → (M0Crypto.Armv6M.State → Prop) → Prop :=
  fun K n sp0 stop s P Result =>
  M0Crypto.Release.TraceSpec.HandlerRoom K n sp0 P →
    ∀ (H : Nat → M0Crypto.Armv6M.State → M0Crypto.Armv6M.State),
