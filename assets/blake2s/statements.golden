  | M0Crypto.Release.Blake2s.HashCorrectHyp.mk : ∀ {ci : M0Crypto.Release.Blake2s.Init.Ctx} {s0 : M0Crypto.Armv6M.State} {calls : List M0Crypto.Armv6M.State},
  M0Crypto.Release.Blake2s.Init.Pre ci s0 →
    (List.map (fun s => BitVec.toNat (s.regs 2)) calls).sum < 2 ^ 64 →
      M0Crypto.Release.Blake2s.HashCorrectHyp ci s0 calls
