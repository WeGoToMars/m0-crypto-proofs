  | M0Crypto.Release.Blake2s.Update.Pre.mk : ∀ {c : M0Crypto.Release.Blake2s.Update.Ctx} {s : M0Crypto.Armv6M.State},
  M0Crypto.Release.Blake2s.Update.Valid c →
    M0Crypto.Release.Blake2s.Update.Entry c s →
      BitVec.getLsbD (c.regs0 14) 0 = Bool.true →
        ¬M0Crypto.Release.Region c.base M0Crypto.Artifacts.Release.size c.ret → M0Crypto.Release.Blake2s.Update.Pre c s
