def M0Crypto.Release.Blake2s.Update.EntryOn : M0Crypto.Armv6M.Word → M0Crypto.Armv6M.Word → M0Crypto.Armv6M.State → Prop :=
  fun base c s =>
  s.regs 0 = c ∧
    ∀ (st : M0Crypto.Spec.Blake2s.State),
      M0Crypto.Release.Blake2s.ContextHolds s.mem c st →
        st.count + st.pending.length + BitVec.toNat (s.regs 2) < 2 ^ 64 →
          M0Crypto.Release.Blake2s.Update.Pre (M0Crypto.Release.Blake2s.Update.callAt base st s) s
