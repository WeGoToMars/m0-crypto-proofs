      c.regs0 15 = c.base + BitVec.ofNat 32 M0Crypto.Artifacts.Release.blake2s_update →
        c.regs0 13 = c.sp0 →
          c.regs0 0 = c.context → c.regs0 1 = c.input → c.regs0 2 = c.len → M0Crypto.Release.Blake2s.Update.Entry c s
