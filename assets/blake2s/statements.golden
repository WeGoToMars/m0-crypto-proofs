  fun c => M0Crypto.Release.Blake2s.bytesAt c.m0 c.input (BitVec.toNat c.len)
def M0Crypto.Release.Blake2s.Update.Ctx.ret : M0Crypto.Release.Blake2s.Update.Ctx → M0Crypto.Armv6M.Word :=
  fun c => c.regs0 14 &&& ~~~1#32
inductive M0Crypto.Release.Blake2s.Update.Valid : M0Crypto.Release.Blake2s.Update.Ctx → Prop
  | M0Crypto.Release.Blake2s.Update.Valid.mk : ∀ {c : M0Crypto.Release.Blake2s.Update.Ctx},
  BitVec.toNat c.base % 4 = 0 →
    BitVec.toNat c.sp0 % 4 = 0 →
      M0Crypto.Release.Blake2s.streamStackBytes ≤ BitVec.toNat c.sp0 →
        BitVec.toNat c.context % 4 = 0 →
          M0Crypto.Release.Blake2s.ContextHolds c.m0 c.context c.stream →
            c.stream.count + c.stream.pending.length + BitVec.toNat c.len < 2 ^ 64 →
              M0Crypto.Release.Frame.Disj c.base M0Crypto.Artifacts.Release.size c.context
                  M0Crypto.Release.Blake2s.contextBytes →
                M0Crypto.Release.Frame.Disj c.base M0Crypto.Artifacts.Release.size c.fp
                    M0Crypto.Release.Blake2s.streamStackBytes →
                  M0Crypto.Release.Frame.Disj c.context M0Crypto.Release.Blake2s.contextBytes c.fp
                      M0Crypto.Release.Blake2s.streamStackBytes →
                    M0Crypto.Release.Frame.Disj c.input (BitVec.toNat c.len) c.context
                        M0Crypto.Release.Blake2s.contextBytes →
                      M0Crypto.Release.Frame.Disj c.input (BitVec.toNat c.len) c.fp
                          M0Crypto.Release.Blake2s.streamStackBytes →
                        M0Crypto.Thumb.CodeAt c.m0 c.base M0Crypto.Release.B → M0Crypto.Release.Blake2s.Update.Valid c
inductive M0Crypto.Release.Blake2s.Update.Entry : M0Crypto.Release.Blake2s.Update.Ctx → M0Crypto.Armv6M.State → Prop
  | M0Crypto.Release.Blake2s.Update.Entry.mk : ∀ {c : M0Crypto.Release.Blake2s.Update.Ctx} {s : M0Crypto.Armv6M.State},
  s.regs = c.regs0 →
