def M0Crypto.Release.Blake2s.HashConstantTime : Prop :=
  ∀ (ci ci' : M0Crypto.Release.Blake2s.Init.Ctx) (s0 s0' t0 t0' sf sf' : M0Crypto.Armv6M.State)
  (calls calls' : List (M0Crypto.Armv6M.State × M0Crypto.Armv6M.State)),
  M0Crypto.Release.Blake2s.HashConstantTimeHyp ci ci' s0 s0' t0 t0' sf sf' calls calls' →
    M0Crypto.Release.Blake2s.traceOf s0 = M0Crypto.Release.Blake2s.traceOf s0' ∧
      List.map (fun p => M0Crypto.Release.Blake2s.traceOf p.fst) calls =
          List.map (fun p => M0Crypto.Release.Blake2s.traceOf p.fst) calls' ∧
        M0Crypto.Release.Blake2s.traceOf sf = M0Crypto.Release.Blake2s.traceOf sf'
