def M0Crypto.Armv6M.Mem : Type :=
  M0Crypto.Armv6M.Word → BitVec 8
def M0Crypto.Armv6M.read32 : M0Crypto.Armv6M.Mem → M0Crypto.Armv6M.Word → M0Crypto.Armv6M.Word :=
  fun m a => m (a + 3#32) ++ m (a + 2#32) ++ m (a + 1#32) ++ m a
def M0Crypto.Armv6M.write32 : M0Crypto.Armv6M.Mem → M0Crypto.Armv6M.Word → M0Crypto.Armv6M.Word → M0Crypto.Armv6M.Mem :=
  fun m a v x =>
  if x = a then BitVec.extractLsb' 0 8 v
  else
    if x = a + 1#32 then BitVec.extractLsb' 8 8 v
    else if x = a + 2#32 then BitVec.extractLsb' 16 8 v else if x = a + 3#32 then BitVec.extractLsb' 24 8 v else m x
def M0Crypto.Armv6M.Word : Type :=
  BitVec 32
def M0Crypto.Armv6M.Reg : Type :=
  Fin 16
def M0Crypto.Armv6M.LowReg : Type :=
  Fin 8
def M0Crypto.Armv6M.LowReg.toReg : M0Crypto.Armv6M.LowReg → M0Crypto.Armv6M.Reg :=
  fun r => ⟨↑r, M0Crypto.Armv6M.LowReg.toReg._proof_2 r⟩
inductive M0Crypto.Armv6M.State : Type
  | M0Crypto.Armv6M.State.mk : (M0Crypto.Armv6M.Reg → M0Crypto.Armv6M.Word) →
  Bool → Bool → Bool → Bool → (M0Crypto.Armv6M.Word → BitVec 8) → M0Crypto.Armv6M.State
def M0Crypto.Armv6M.State.pc : M0Crypto.Armv6M.State → M0Crypto.Armv6M.Word :=
  fun s => s.regs 15
def M0Crypto.Armv6M.State.reg : M0Crypto.Armv6M.State → M0Crypto.Armv6M.LowReg → M0Crypto.Armv6M.Word :=
  fun s r => s.regs r.toReg
def M0Crypto.Armv6M.State.setReg : M0Crypto.Armv6M.State → M0Crypto.Armv6M.Reg → M0Crypto.Armv6M.Word → M0Crypto.Armv6M.State :=
  fun s r x => { regs := fun i => if i = r then x else s.regs i, n := s.n, z := s.z, c := s.c, v := s.v, mem := s.mem }
def M0Crypto.Armv6M.State.setNZ : M0Crypto.Armv6M.State → M0Crypto.Armv6M.Word → M0Crypto.Armv6M.State :=
  fun s x => { regs := s.regs, n := BitVec.msb x, z := x == 0, c := s.c, v := s.v, mem := s.mem }
def M0Crypto.Armv6M.addWithCarry : M0Crypto.Armv6M.Word → M0Crypto.Armv6M.Word → Bool → M0Crypto.Armv6M.Word × Bool × Bool :=
  fun x y carryIn =>
  have unsignedSum := BitVec.toNat x + BitVec.toNat y + carryIn.toNat;
  have signedSum := BitVec.toInt x + BitVec.toInt y + ↑carryIn.toNat;
  have result := BitVec.ofNat 32 unsignedSum;
  (result, Decidable.decide (result.toNat ≠ unsignedSum), Decidable.decide (result.toInt ≠ signedSum))
def M0Crypto.Armv6M.rorC : M0Crypto.Armv6M.Word → Nat → Bool → M0Crypto.Armv6M.Word × Bool :=
  fun x amount carryIn =>
  if amount = 0 then (x, carryIn)
  else
    have m := amount % 32;
    have result := x >>> m ||| x <<< (32 - m);
    (result, result.msb)
def M0Crypto.Release.Blake2s.contextBytes : Nat :=
  112
def M0Crypto.Release.Blake2s.digestBytes : Nat :=
  32
def M0Crypto.Release.Blake2s.initStackBytes : Nat :=
  4
def M0Crypto.Release.Blake2s.compressLocalsBytes : Nat :=
  100
def M0Crypto.Release.Blake2s.compressSavedBytes : Nat :=
  36
def M0Crypto.Release.Blake2s.compressFrameBytes : Nat :=
  M0Crypto.Release.Blake2s.compressLocalsBytes + M0Crypto.Release.Blake2s.compressSavedBytes
def M0Crypto.Release.Blake2s.streamSavedBytes : Nat :=
  20
def M0Crypto.Release.Blake2s.streamPadBytes : Nat :=
  4
def M0Crypto.Release.Blake2s.streamStackBytes : Nat :=
  M0Crypto.Release.Blake2s.streamSavedBytes + M0Crypto.Release.Blake2s.streamPadBytes +
  M0Crypto.Release.Blake2s.compressFrameBytes
def M0Crypto.Release.Blake2s.bytesAt : M0Crypto.Armv6M.Mem → M0Crypto.Armv6M.Word → Nat → List (BitVec 8) :=
  fun m p n => List.map (fun i => m (p + BitVec.ofNat 32 i)) (List.range n)
inductive M0Crypto.Release.Blake2s.ContextHoldsExceptUsed : M0Crypto.Armv6M.Mem → M0Crypto.Armv6M.Word → M0Crypto.Spec.Blake2s.State → Prop
  | M0Crypto.Release.Blake2s.ContextHoldsExceptUsed.mk : ∀ {m : M0Crypto.Armv6M.Mem} {c : M0Crypto.Armv6M.Word} {st : M0Crypto.Spec.Blake2s.State},
  st.h.size = 8 →
    (∀ (i : Nat), i < 8 → M0Crypto.Armv6M.read32 m (c + BitVec.ofNat 32 (4 * i)) = st.h[i]!) →
      M0Crypto.Armv6M.read32 m (c + 32#32) = BitVec.ofNat 32 st.count →
        M0Crypto.Armv6M.read32 m (c + 36#32) = BitVec.ofNat 32 (st.count / 2 ^ 32) →
          st.count < 2 ^ 64 →
            st.pending.length ≤ 64 →
              M0Crypto.Release.Blake2s.bytesAt m (c + 40#32) st.pending.length = st.pending →
                M0Crypto.Release.Blake2s.ContextHoldsExceptUsed m c st
inductive M0Crypto.Release.Blake2s.ContextHolds : M0Crypto.Armv6M.Mem → M0Crypto.Armv6M.Word → M0Crypto.Spec.Blake2s.State → Prop
  | M0Crypto.Release.Blake2s.ContextHolds.mk : ∀ {m : M0Crypto.Armv6M.Mem} {c : M0Crypto.Armv6M.Word} {st : M0Crypto.Spec.Blake2s.State},
  M0Crypto.Release.Blake2s.ContextHoldsExceptUsed m c st →
    M0Crypto.Armv6M.read32 m (c + 104#32) = BitVec.ofNat 32 st.pending.length →
      M0Crypto.Release.Blake2s.ContextHolds m c st
inductive M0Crypto.Release.Blake2s.Init.Ctx : Type
  | M0Crypto.Release.Blake2s.Init.Ctx.mk : M0Crypto.Armv6M.Word →
  M0Crypto.Armv6M.Word →
    M0Crypto.Armv6M.Word →
