  | M0Crypto.Release.Blake2sFinal.FinalPost.mk : ∀ {s t : M0Crypto.Armv6M.State} {st : M0Crypto.Spec.Blake2s.State},
  t.pc = s.regs 14 &&& ~~~1#32 →
