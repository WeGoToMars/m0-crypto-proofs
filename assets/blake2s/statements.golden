    s.pc = base + BitVec.ofNat 32 M0Crypto.Release.Blake2sStreamCode.fStart →
      M0Crypto.Thumb.CodeAt s.mem base M0Crypto.Release.B →
        BitVec.toNat (s.regs 13) % 4 = 0 →
          200 ≤ BitVec.toNat (s.regs 13) →
            BitVec.toNat (s.regs 0) % 4 = 0 →
              BitVec.getLsbD (s.regs 14) 0 = Bool.true →
