                    M0Crypto.Release.Blake2sHash.Calls base c t0'.mem calls' →
                      M0Crypto.Release.Blake2sHash.All2 (fun p q => M0Crypto.Release.Blake2sHash.PubEq 3 p.fst q.fst)
                          calls calls' →
                        (List.map List.length (M0Crypto.Release.Blake2sHash.inputs calls)).sum < 2 ^ 64 →
                          (List.map List.length (M0Crypto.Release.Blake2sHash.inputs calls')).sum < 2 ^ 64 →
                            sf.regs 0 = c →
                              sf'.regs 0 = c →
                                (∀ (o : Nat),
                                    o < 112 →
                                      sf.mem (c + BitVec.ofNat 32 o) =
                                        M0Crypto.Release.Blake2sHash.lastMem t0.mem calls (c + BitVec.ofNat 32 o)) →
                                  (∀ (o : Nat),
                                      o < 112 →
                                        sf'.mem (c + BitVec.ofNat 32 o) =
                                          M0Crypto.Release.Blake2sHash.lastMem t0'.mem calls' (c + BitVec.ofNat 32 o)) →
                                    (∀ (st : M0Crypto.Spec.Blake2s.State),
                                        M0Crypto.Release.Blake2sStream.Ctx sf.mem (sf.regs 0) st →
                                          M0Crypto.Release.Blake2sHash.total st < 2 ^ 64 →
                                            M0Crypto.Release.Blake2sFinal.FinalEntry base sf st) →
                                      (∀ (st : M0Crypto.Spec.Blake2s.State),
                                          M0Crypto.Release.Blake2sStream.Ctx sf'.mem (sf'.regs 0) st →
                                            M0Crypto.Release.Blake2sHash.total st < 2 ^ 64 →
                                              M0Crypto.Release.Blake2sFinal.FinalEntry base sf' st) →
                                        (∀ (i : Nat),
                                            i < M0Crypto.Artifacts.Release.size →
                                              sf.regs 14 &&& ~~~1#32 ≠ base + BitVec.ofNat 32 i) →
                                          M0Crypto.Release.Blake2sHash.PubEq 2 sf sf' →
                                            M0Crypto.Release.Blake2sHash.TraceEq s0 s0' ∧
                                              M0Crypto.Release.Blake2sHash.All2
                                                  (fun p q => M0Crypto.Release.Blake2sHash.TraceEq p.fst q.fst) calls
                                                  calls' ∧
                                                M0Crypto.Release.Blake2sHash.TraceEq sf sf'
