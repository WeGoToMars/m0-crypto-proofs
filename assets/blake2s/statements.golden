  fun base c s =>
  s.regs 0 = c ∧
    ∀ (st : M0Crypto.Spec.Blake2s.State),
      M0Crypto.Release.Blake2s.ContextHolds s.mem c st →
        st.count + st.pending.length < 2 ^ 64 →
          M0Crypto.Release.Blake2s.Final.Pre (M0Crypto.Release.Blake2s.Final.callAt base st s) s
