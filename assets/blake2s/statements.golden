def M0Crypto.Release.Blake2s.HashCorrect : Prop :=
  ∀ (ci : M0Crypto.Release.Blake2s.Init.Ctx) (s0 : M0Crypto.Armv6M.State) (calls : List M0Crypto.Armv6M.State),
  M0Crypto.Release.Blake2s.HashCorrectHyp ci s0 calls →
    ∃ fuel t0 tr,
      M0Crypto.Thumb.runUntil ci.ret fuel s0 = Except.ok (t0, tr) ∧
        M0Crypto.Release.Blake2s.UpdatesReturn ci.base ci.context t0.mem calls fun m =>
          ∀ (sf : M0Crypto.Armv6M.State),
            M0Crypto.Release.Blake2s.ContextKept ci.context m sf →
              M0Crypto.Release.Blake2s.Final.EntryOn ci.base ci.context sf →
                ∃ fuel tf tr,
                  M0Crypto.Thumb.runUntil (M0Crypto.Release.Blake2s.returnAddr sf) fuel sf = Except.ok (tf, tr) ∧
                    M0Crypto.Release.Blake2s.bytesAt tf.mem (sf.regs 1) M0Crypto.Release.Blake2s.digestBytes =
                      M0Crypto.Spec.Blake2s.blake2s (List.map M0Crypto.Release.Blake2s.inputAt calls).flatten
