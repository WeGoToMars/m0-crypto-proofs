  fun v ia ib ic id x y =>
  match M0Crypto.Spec.Blake2s.G v[ia]! v[ib]! v[ic]! v[id]! x y with
  | (a, b, c, d) => (((Array.set! v ia a).set! ib b).set! ic c).set! id d
sha256 a15c67a2ffcccd816a1ff4b6e7bc857402d5afb1f7c18a35cbc8ffb5190fa875
def M0Crypto.Spec.Blake2s.round : M0Crypto.Spec.Blake2s.Vec → Array M0Crypto.Spec.Blake2s.Word → Nat → M0Crypto.Spec.Blake2s.Vec :=
  fun v m r =>
  have s := M0Crypto.Spec.Blake2s.SIGMA[r % 10]!;
  have v := M0Crypto.Spec.Blake2s.mix v 0 4 8 12 m[s[0]!]! m[s[1]!]!;
  have v := M0Crypto.Spec.Blake2s.mix v 1 5 9 13 m[s[2]!]! m[s[3]!]!;
  have v := M0Crypto.Spec.Blake2s.mix v 2 6 10 14 m[s[4]!]! m[s[5]!]!;
  have v := M0Crypto.Spec.Blake2s.mix v 3 7 11 15 m[s[6]!]! m[s[7]!]!;
  have v := M0Crypto.Spec.Blake2s.mix v 0 5 10 15 m[s[8]!]! m[s[9]!]!;
  have v := M0Crypto.Spec.Blake2s.mix v 1 6 11 12 m[s[10]!]! m[s[11]!]!;
  have v := M0Crypto.Spec.Blake2s.mix v 2 7 8 13 m[s[12]!]! m[s[13]!]!;
  have v := M0Crypto.Spec.Blake2s.mix v 3 4 9 14 m[s[14]!]! m[s[15]!]!;
  v
sha256 99b96bd139bc16dd91f5fd8012e80a3ff305641635a4614810ee091af394d639
def M0Crypto.Spec.Blake2s.rounds : Array M0Crypto.Spec.Blake2s.Word → Nat → M0Crypto.Spec.Blake2s.Vec → M0Crypto.Spec.Blake2s.Vec :=
  fun m x x_1 =>
  Nat.brecOn (motive := fun x => M0Crypto.Spec.Blake2s.Vec → M0Crypto.Spec.Blake2s.Vec) x
    (M0Crypto.Spec.Blake2s.rounds._f m) x_1
unfold M0Crypto.Spec.Blake2s.rounds.eq_def : ∀ (m : Array M0Crypto.Spec.Blake2s.Word) (x : Nat) (x_1 : M0Crypto.Spec.Blake2s.Vec),
  M0Crypto.Spec.Blake2s.rounds m x x_1 =
    match x, x_1 with
    | 0, v => v
    | n.succ, v => M0Crypto.Spec.Blake2s.round (M0Crypto.Spec.Blake2s.rounds m n v) m n
sha256 1d57e4fe1d68126a8ee9bb199b657ce9e2a2cab5a4528483d3c7da7fc5cde959
def M0Crypto.Spec.Blake2s.initVec : Array M0Crypto.Spec.Blake2s.Word → Nat → Bool → M0Crypto.Spec.Blake2s.Vec :=
  fun h t f =>
  have t0 := BitVec.ofNat 32 t;
  have t1 := BitVec.ofNat 32 (t / 2 ^ 32);
  have v := h ++ M0Crypto.Spec.Blake2s.IV;
  have v := v.set! 12 (v[12]! ^^^ t0);
  have v := v.set! 13 (v[13]! ^^^ t1);
  if f = Bool.true then v.set! 14 (v[14]! ^^^ 4294967295#32) else v
sha256 44afee532d30b4a5c1be32c27f0584292ab55cca7df290256a4266393ec03549
def M0Crypto.Spec.Blake2s.compress : Array M0Crypto.Spec.Blake2s.Word → Array M0Crypto.Spec.Blake2s.Word → Nat → Bool → Array M0Crypto.Spec.Blake2s.Word :=
  fun h m t f =>
  have v := M0Crypto.Spec.Blake2s.rounds m 10 (M0Crypto.Spec.Blake2s.initVec h t f);
  Array.map (fun i => h[i]! ^^^ v[i]! ^^^ v[i + 8]!) (List.range 8).toArray
