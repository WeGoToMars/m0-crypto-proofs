  fun s => M0Crypto.Release.Blake2s.wd s.mem (s.regs 1)
def M0Crypto.Release.Blake2sCompress.WrOf : M0Crypto.Armv6M.State → M0Crypto.Armv6M.Word → Prop :=
  fun s y =>
  (∃ o, o < 136 ∧ y = M0Crypto.Release.Blake2sCompress.fpOf s + BitVec.ofNat 32 o) ∨
    ∃ o, o < 32 ∧ y = s.regs 0 + BitVec.ofNat 32 o
inductive M0Crypto.Release.Blake2sCompress.Post : M0Crypto.Armv6M.State → M0Crypto.Armv6M.State → Prop
  | M0Crypto.Release.Blake2sCompress.Post.mk : ∀ {s t : M0Crypto.Armv6M.State},
  t.pc = s.regs 14 &&& ~~~1#32 →
    t.regs 13 = s.regs 13 →
      t.regs 4 = s.regs 4 →
        t.regs 5 = s.regs 5 →
          t.regs 6 = s.regs 6 →
            t.regs 7 = s.regs 7 →
              t.regs 8 = s.regs 8 →
                t.regs 9 = s.regs 9 →
                  t.regs 10 = s.regs 10 →
                    t.regs 11 = s.regs 11 →
                      (∀ (i : Nat),
                          i < 8 →
                            M0Crypto.Armv6M.read32 t.mem (s.regs 0 + BitVec.ofNat 32 (4 * i)) =
                              (M0Crypto.Spec.Blake2s.compress
                                  (M0Crypto.Release.Blake2s.arr8 (M0Crypto.Release.Blake2s.wd s.mem (s.regs 0)))
                                  (M0Crypto.Release.Blake2s.arr16 (M0Crypto.Release.Blake2sCompress.Mw s))
                                  (BitVec.toNat (s.regs 2) + 2 ^ 32 * BitVec.toNat (s.regs 3))
                                  (Decidable.decide (M0Crypto.Armv6M.read32 s.mem (s.regs 13) ≠ 0#32)))[i]!) →
                        (∀ (y : M0Crypto.Armv6M.Word),
                            (∀ (o : Nat), o < 136 → y ≠ M0Crypto.Release.Blake2sCompress.fpOf s + BitVec.ofNat 32 o) →
                              (∀ (o : Nat), o < 32 → y ≠ s.regs 0 + BitVec.ofNat 32 o) → t.mem y = s.mem y) →
                          (∀ (r : M0Crypto.Armv6M.Reg), ↑r < 4 → t.regs r = 0#32) →
                            t.regs 12 = 0#32 →
