def M0Crypto.Release.Blake2s.UpdatesRan : M0Crypto.Armv6M.Word →
  M0Crypto.Armv6M.Word → M0Crypto.Armv6M.Mem → List (M0Crypto.Armv6M.State × M0Crypto.Armv6M.State) → Prop :=
  fun base c x x_1 =>
  List.brecOn (motive := fun x => M0Crypto.Armv6M.Mem → Prop) x_1 (M0Crypto.Release.Blake2s.UpdatesRan._f base c) x
unfold M0Crypto.Release.Blake2s.UpdatesRan.eq_def : ∀ (base c : M0Crypto.Armv6M.Word) (x : M0Crypto.Armv6M.Mem)
  (x_1 : List (M0Crypto.Armv6M.State × M0Crypto.Armv6M.State)),
  M0Crypto.Release.Blake2s.UpdatesRan base c x x_1 =
    match x, x_1 with
    | x, [] => True
    | m, (s, w) :: rest =>
      M0Crypto.Release.Blake2s.ContextKept c m s ∧
        M0Crypto.Release.Blake2s.Update.EntryOn base c s ∧
          (∃ fuel tr, M0Crypto.Thumb.runUntil (M0Crypto.Release.Blake2s.returnAddr s) fuel s = Except.ok (w, tr)) ∧
            M0Crypto.Release.Blake2s.UpdatesRan base c w.mem rest
