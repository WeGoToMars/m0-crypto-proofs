def M0Crypto.Release.Blake2s.Init.Ctx.fp : M0Crypto.Release.Blake2s.Init.Ctx → M0Crypto.Armv6M.Word :=
  fun c => c.sp0 - BitVec.ofNat 32 M0Crypto.Release.Blake2s.initStackBytes
def M0Crypto.Release.Blake2s.Init.Ctx.ret : M0Crypto.Release.Blake2s.Init.Ctx → M0Crypto.Armv6M.Word :=
  fun c => c.regs0 14 &&& ~~~1#32
inductive M0Crypto.Release.Blake2s.Init.Valid : M0Crypto.Release.Blake2s.Init.Ctx → Prop
  | M0Crypto.Release.Blake2s.Init.Valid.mk : ∀ {c : M0Crypto.Release.Blake2s.Init.Ctx},
  BitVec.toNat c.base % 4 = 0 →
    BitVec.toNat c.sp0 % 4 = 0 →
      M0Crypto.Release.Blake2s.initStackBytes ≤ BitVec.toNat c.sp0 →
        BitVec.toNat c.context % 4 = 0 →
          M0Crypto.Release.Frame.Disj c.base M0Crypto.Artifacts.Release.size c.context
              M0Crypto.Release.Blake2s.contextBytes →
            M0Crypto.Release.Frame.Disj c.base M0Crypto.Artifacts.Release.size c.fp
                M0Crypto.Release.Blake2s.initStackBytes →
              M0Crypto.Release.Frame.Disj c.context M0Crypto.Release.Blake2s.contextBytes c.fp
                  M0Crypto.Release.Blake2s.initStackBytes →
                M0Crypto.Thumb.CodeAt c.m0 c.base M0Crypto.Release.B → M0Crypto.Release.Blake2s.Init.Valid c
inductive M0Crypto.Release.Blake2s.Init.Entry : M0Crypto.Release.Blake2s.Init.Ctx → M0Crypto.Armv6M.State → Prop
  | M0Crypto.Release.Blake2s.Init.Entry.mk : ∀ {c : M0Crypto.Release.Blake2s.Init.Ctx} {s : M0Crypto.Armv6M.State},
  s.regs = c.regs0 →
    s.mem = c.m0 →
      c.regs0 15 = c.base + BitVec.ofNat 32 M0Crypto.Artifacts.Release.blake2s_init →
        c.regs0 13 = c.sp0 → c.regs0 0 = c.context → M0Crypto.Release.Blake2s.Init.Entry c s
inductive M0Crypto.Release.Blake2s.Init.Pre : M0Crypto.Release.Blake2s.Init.Ctx → M0Crypto.Armv6M.State → Prop
  | M0Crypto.Release.Blake2s.Init.Pre.mk : ∀ {c : M0Crypto.Release.Blake2s.Init.Ctx} {s : M0Crypto.Armv6M.State},
  M0Crypto.Release.Blake2s.Init.Valid c →
    M0Crypto.Release.Blake2s.Init.Entry c s →
      BitVec.getLsbD (c.regs0 14) 0 = Bool.true →
        ¬M0Crypto.Release.Region c.base M0Crypto.Artifacts.Release.size c.ret → M0Crypto.Release.Blake2s.Init.Pre c s
def M0Crypto.Release.Blake2s.Init.WrOk : M0Crypto.Release.Blake2s.Init.Ctx → M0Crypto.Armv6M.Word → Prop :=
  fun c y =>
  M0Crypto.Release.Region c.fp M0Crypto.Release.Blake2s.initStackBytes y ∨
    M0Crypto.Release.Region c.context M0Crypto.Release.Blake2s.contextBytes y
inductive M0Crypto.Release.Blake2s.Init.Result : M0Crypto.Release.Blake2s.Init.Ctx → M0Crypto.Armv6M.State → Prop
  | M0Crypto.Release.Blake2s.Init.Result.mk : ∀ {c : M0Crypto.Release.Blake2s.Init.Ctx} {t : M0Crypto.Armv6M.State},
  t.pc = c.ret →
    t.regs 13 = c.sp0 →
      (∀ (r : M0Crypto.Armv6M.Reg), 4 ≤ ↑r → ↑r < 12 → t.regs r = c.regs0 r) →
        M0Crypto.Release.Blake2s.ContextHolds t.mem c.context M0Crypto.Spec.Blake2s.State.init →
          (∀ (y : M0Crypto.Armv6M.Word), ¬M0Crypto.Release.Blake2s.Init.WrOk c y → t.mem y = c.m0 y) →
            M0Crypto.Release.Blake2s.Init.Result c t
def M0Crypto.Release.Blake2s.Init.Correct : Prop :=
  ∀ (c : M0Crypto.Release.Blake2s.Init.Ctx) (s : M0Crypto.Armv6M.State),
  M0Crypto.Release.Blake2s.Init.Pre c s →
    ∃ n,
      ∀ (fuel : Nat),
        n ≤ fuel →
          ∃ t tr,
            M0Crypto.Thumb.runUntil c.ret fuel s = Except.ok (t, tr) ∧
              M0Crypto.Release.Blake2s.Init.Result c t ∧
                M0Crypto.Release.WritesTo (M0Crypto.Release.Blake2s.Init.WrOk c) tr
