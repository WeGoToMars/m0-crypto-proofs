  fun c y =>
  M0Crypto.Release.Region c.fp M0Crypto.Release.Blake2s.streamStackBytes y ∨
    M0Crypto.Release.Region c.context M0Crypto.Release.Blake2s.contextBytes y
inductive M0Crypto.Release.Blake2s.Update.Result : M0Crypto.Release.Blake2s.Update.Ctx → M0Crypto.Armv6M.State → Prop
  | M0Crypto.Release.Blake2s.Update.Result.mk : ∀ {c : M0Crypto.Release.Blake2s.Update.Ctx} {t : M0Crypto.Armv6M.State},
  t.pc = c.ret →
    t.regs 13 = c.sp0 →
      (∀ (r : M0Crypto.Armv6M.Reg), 4 ≤ ↑r → ↑r < 12 → t.regs r = c.regs0 r) →
        M0Crypto.Release.Blake2s.ContextHolds t.mem c.context (M0Crypto.Spec.Blake2s.absorb c.stream c.inputB) →
          (∀ (y : M0Crypto.Armv6M.Word), ¬M0Crypto.Release.Blake2s.Update.WrOk c y → t.mem y = c.m0 y) →
            (∀ (r : M0Crypto.Armv6M.Reg), ↑r < 4 → t.regs r = 0) → M0Crypto.Release.Blake2s.Update.Result c t
def M0Crypto.Release.Blake2s.Update.Correct : Prop :=
  ∀ (c : M0Crypto.Release.Blake2s.Update.Ctx) (s : M0Crypto.Armv6M.State),
  M0Crypto.Release.Blake2s.Update.Pre c s →
    ∃ n,
      ∀ (fuel : Nat),
        n ≤ fuel →
          ∃ t tr,
            M0Crypto.Thumb.runUntil c.ret fuel s = Except.ok (t, tr) ∧
              M0Crypto.Release.Blake2s.Update.Result c t ∧
                M0Crypto.Release.WritesTo (M0Crypto.Release.Blake2s.Update.WrOk c) tr
