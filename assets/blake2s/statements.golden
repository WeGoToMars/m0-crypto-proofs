inductive M0Crypto.Release.Blake2sFinal.FinalEntry : M0Crypto.Armv6M.Word → M0Crypto.Armv6M.State → M0Crypto.Spec.Blake2s.State → Prop
  | M0Crypto.Release.Blake2sFinal.FinalEntry.mk : ∀ {base : M0Crypto.Armv6M.Word} {s : M0Crypto.Armv6M.State} {st : M0Crypto.Spec.Blake2s.State},
