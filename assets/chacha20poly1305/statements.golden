          M0Crypto.Release.Frame.Disj c.base M0Crypto.Artifacts.Release.size c.out (BitVec.toNat c.len) →
            M0Crypto.Release.Frame.Disj c.out (BitVec.toNat c.len) c.fp 184 →
              M0Crypto.Release.Frame.Disj c.inp (BitVec.toNat c.len) c.fp 176 →
