M0Crypto.Release.ChaCha20Xor.xor_correct : ∀ (c : M0Crypto.Release.Frame.Ctx) (s : M0Crypto.Armv6M.State),
  M0Crypto.Release.ChaCha20Xor.Pre c s →
    ∃ n,
      ∀ (fuel : Nat),
