sha256 9388c7a0111c909f04562e582b68bed0baa4fc5d82f04d2835f32df15300f7c7
def M0Crypto.Release.Aead.ACall.ret : M0Crypto.Release.Aead.ACall → M0Crypto.Armv6M.Word :=
  fun c => c.regs0 14 &&& ~~~1#32
sha256 a3e9612f846454831ac108a68dd6ff64ba86be36997edbb8863ff6b9af9ce23c
inductive M0Crypto.Release.Aead.AEntry : M0Crypto.Release.Aead.ACall → Nat → M0Crypto.Armv6M.State → Prop
  | M0Crypto.Release.Aead.AEntry.mk : ∀ {c : M0Crypto.Release.Aead.ACall} {e : Nat} {s : M0Crypto.Armv6M.State},
  s.regs = c.regs0 →
    s.mem = c.m0 →
      c.regs0 15 = c.base + BitVec.ofNat 32 e →
        c.regs0 13 = c.sp0 →
          c.regs0 0 = c.out →
            c.regs0 1 = c.tag →
              c.regs0 2 = c.inp →
                c.regs0 3 = c.len →
                  M0Crypto.Armv6M.read32 c.m0 c.sp0 = c.aad →
                    M0Crypto.Armv6M.read32 c.m0 (c.sp0 + 4#32) = c.alen →
                      M0Crypto.Armv6M.read32 c.m0 (c.sp0 + 8#32) = c.key →
                        M0Crypto.Armv6M.read32 c.m0 (c.sp0 + 12#32) = c.nonce → M0Crypto.Release.Aead.AEntry c e s
