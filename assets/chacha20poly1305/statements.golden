def M0Crypto.Release.TraceSpec.ChaCha20XorConstantTime : Prop :=
  ∀ (c₁ c₂ : M0Crypto.Release.Frame.Ctx) (s₁ s₂ : M0Crypto.Armv6M.State),
  M0Crypto.Release.ChaCha20Xor.Pre c₁ s₁ →
    M0Crypto.Release.ChaCha20Xor.Pre c₂ s₂ →
      c₁.pub = c₂.pub →
        ∀ (fuel : Nat),
          Except.map Prod.snd (M0Crypto.Thumb.runUntil c₁.ret fuel s₁) =
            Except.map Prod.snd (M0Crypto.Thumb.runUntil c₂.ret fuel s₂)
