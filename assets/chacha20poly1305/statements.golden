def M0Crypto.Release.ChaCha20Xor.chSavedRegs : List M0Crypto.Armv6M.Reg :=
  [8, 9, 10, 11, 4, 5, 6, 7, 14]
sha256 982b902f071e634aedd4b0f18c017e778b7547f3b2fb066ede23193f75e8e4e8
inductive M0Crypto.Release.ChaCha20Xor.Result : M0Crypto.Release.Frame.Ctx → M0Crypto.Armv6M.State → Prop
  | M0Crypto.Release.ChaCha20Xor.Result.mk : ∀ {c : M0Crypto.Release.Frame.Ctx} {t : M0Crypto.Armv6M.State},
  t.pc = c.regs0 14 &&& ~~~1#32 →
    t.regs 13 = c.sp0 →
      (∀ (r : M0Crypto.Armv6M.Reg), 4 ≤ ↑r → ↑r < 12 → t.regs r = c.regs0 r) →
        (t.regs 0 =
            if M0Crypto.Spec.Aead.counterOk (BitVec.toNat c.ctr) (BitVec.toNat c.len) = Bool.true then 0 else ~~~0) →
          (∀ (r : M0Crypto.Armv6M.Reg),
              1 ≤ ↑r ∧ ↑r < 4 ∨ ↑r = 12 →
                t.regs r =
                  if M0Crypto.Spec.Aead.counterOk (BitVec.toNat c.ctr) (BitVec.toNat c.len) = Bool.true ∧ c.len ≠ 0 then
                    0
                  else c.regs0 r) →
            (∀ (y : M0Crypto.Armv6M.Word),
                M0Crypto.Release.ChaCha20Xor.OutS c y →
                  t.mem y =
                    if
                        M0Crypto.Spec.Aead.counterOk (BitVec.toNat c.ctr) (BitVec.toNat c.len) = Bool.true ∧
                          M0Crypto.Release.Region c.out (BitVec.toNat c.len) y then
                      c.outB (c.oidx y)
                    else c.m0 y) →
              (∀ (i : Nat),
                  i < M0Crypto.Release.ChaCha20Layout.chFrameWords →
                    M0Crypto.Armv6M.read32 t.mem (M0Crypto.Armv6M.slot c.fp i) =
                      if
                          M0Crypto.Spec.Aead.counterOk (BitVec.toNat c.ctr) (BitVec.toNat c.len) = Bool.true ∧
                            c.len ≠ 0 then
