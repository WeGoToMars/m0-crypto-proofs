                      else M0Crypto.Armv6M.read32 c.m0 (M0Crypto.Armv6M.slot c.fp i)) →
                (∀ (i : Nat),
                    i < 9 →
                      M0Crypto.Armv6M.read32 t.mem
                          (M0Crypto.Armv6M.slot c.fp (M0Crypto.Release.ChaCha20Layout.chFrameWords + i)) =
                        c.regs0 M0Crypto.Release.ChaCha20Xor.chSavedRegs[i]!) →
                  M0Crypto.Release.ChaCha20Xor.Result c t
