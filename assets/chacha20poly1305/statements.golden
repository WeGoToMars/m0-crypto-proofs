  ∀ (c : M0Crypto.Release.Aead.ACall) (s : M0Crypto.Armv6M.State),
    M0Crypto.Release.Aead.APre c M0Crypto.Release.Aead.decOff s →
      ∃ n,
        ∀ (fuel : Nat),
          n ≤ fuel →
            ∃ t tr,
              M0Crypto.Thumb.runUntil c.ret fuel s = Except.ok (t, tr) ∧
                M0Crypto.Release.Aead.DecryptResult c t ∧
                  M0Crypto.Release.WritesTo (M0Crypto.Release.Aead.DAllowed c) tr ∧
                    t.regs 12 = 0#32 ∧
                      M0Crypto.Release.Frame.Ctx.bytesAt t.mem (c.sp0 - 320#32) 320 =
                        window c.regs0 c.nonce (Decidable.decide (c.expected = c.tagB))
                          (M0Crypto.Release.Frame.Ctx.bytesAt c.m0 (c.sp0 - 320#32) 320)
