def M0Crypto.Spec.Ed25519.encodePoint : M0Crypto.Spec.Ed25519.Point → List M0Crypto.Spec.Ed25519.Byte :=
  fun P =>
  match P.xy with
  | (x, y) => M0Crypto.Spec.Ed25519.encodeInt (y + 2 ^ 255 * (x % 2))
sha256 90032f8f89cb0027a3383a47472607cb8ca20b1c147e465b6ff6f97afa509dca
def M0Crypto.Spec.Ed25519.decodePoint : List M0Crypto.Spec.Ed25519.Byte → Option M0Crypto.Spec.Ed25519.Point :=
  fun s =>
  have n := M0Crypto.Spec.Ed25519.decodeInt s;
  have x_0 := n / 2 ^ 255 % 2;
  have y := n % 2 ^ 255;
  if y ≥ M0Crypto.Spec.Ed25519.p then Option.none
  else
    have u := M0Crypto.Spec.Ed25519.fsub (y ^ 2) 1;
    have v := (M0Crypto.Spec.Ed25519.d * y ^ 2 + 1) % M0Crypto.Spec.Ed25519.p;
    have x :=
      u * v ^ 3 * M0Crypto.Spec.Ed25519.powp (u * v ^ 7) ((M0Crypto.Spec.Ed25519.p - 5) / 8) % M0Crypto.Spec.Ed25519.p;
    have x? :=
      if v * x ^ 2 % M0Crypto.Spec.Ed25519.p = u then Option.some x
      else
        if v * x ^ 2 % M0Crypto.Spec.Ed25519.p = M0Crypto.Spec.Ed25519.fsub 0 u then
          Option.some (x * M0Crypto.Spec.Ed25519.powp 2 ((M0Crypto.Spec.Ed25519.p - 1) / 4) % M0Crypto.Spec.Ed25519.p)
        else Option.none;
    match x? with
    | Option.none => Option.none
    | Option.some x =>
      if x = 0 ∧ x_0 = 1 then Option.none
      else
        if x_0 ≠ x % 2 then Option.some (M0Crypto.Spec.Ed25519.Point.ofXY (M0Crypto.Spec.Ed25519.p - x) y)
        else Option.some (M0Crypto.Spec.Ed25519.Point.ofXY x y)
