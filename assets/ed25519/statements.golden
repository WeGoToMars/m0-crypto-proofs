sha256 e72d544c4e80ba70577578dd052dab05dca210dec47d86ff085fb9716714f8c6
def M0Crypto.Release.Ed25519.Call.MemOut : M0Crypto.Release.Ed25519.Call →
  Nat → M0Crypto.Armv6M.Word → Nat → List M0Crypto.Release.Ed25519.Byte → M0Crypto.Armv6M.State → Prop :=
  fun k n out len bs t =>
  ∀ (y : M0Crypto.Armv6M.Word),
    ¬M0Crypto.Release.Region (k.fp n) n y →
      t.mem y = if M0Crypto.Release.Region out len y then bs[BitVec.toNat (y - out)]! else k.m0 y
sha256 a1a44c7ebecb0763996f8049b4c8b3ffbb81aef783eb188290e1d6d453ced848
inductive M0Crypto.Release.Ed25519.Call.Wiped : M0Crypto.Release.Ed25519.Call → Nat → M0Crypto.Armv6M.State → Prop
  | M0Crypto.Release.Ed25519.Call.Wiped.mk : ∀ {k : M0Crypto.Release.Ed25519.Call} {n : Nat} {t : M0Crypto.Armv6M.State},
  t.regs 1 = 0 →
    t.regs 2 = 0 →
      t.regs 3 = 0 →
        t.regs 12 = 0 →
          (∀ (y : M0Crypto.Armv6M.Word),
              M0Crypto.Release.Region (k.fp n) (n - M0Crypto.Release.Ed25519.savedBytes) y → t.mem y = 0) →
            (∀ (i : Nat),
                i < 9 →
                  M0Crypto.Armv6M.read32 t.mem
                      (k.fp n + BitVec.ofNat 32 (n - M0Crypto.Release.Ed25519.savedBytes + 4 * i)) =
                    k.regs0 M0Crypto.Release.Ed25519.savedRegs[i]!) →
              k.Wiped n t
sha256 65b6a62fac5051284b55205156e25d24bc67322c996a59df0342d27bc9e5a6c6
def M0Crypto.Release.Ed25519.Call.Returns : M0Crypto.Release.Ed25519.Call →
  M0Crypto.Armv6M.State → (M0Crypto.Armv6M.State → Prop) → (M0Crypto.Armv6M.Word → Prop) → Prop :=
  fun k s R W =>
  ∃ n,
    ∀ (fuel : Nat),
      n ≤ fuel → ∃ t tr, M0Crypto.Thumb.runUntil k.ret fuel s = Except.ok (t, tr) ∧ R t ∧ M0Crypto.Release.WritesTo W tr
