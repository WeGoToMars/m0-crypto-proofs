sha256 891898a11a073cb3d2b944b039c110c3b5c145c2b6f3ee7dce73bfaa68d948e1
def M0Crypto.Spec.Sha512.pad : List M0Crypto.Spec.Sha512.Byte → List M0Crypto.Spec.Sha512.Byte :=
  fun M =>
  have l := 8 * M.length;
  have k := (896 + 1023 - l % 1024) % 1024;
  M ++ [128#8] ++ List.replicate ((k - 7) / 8) 0#8 ++ M0Crypto.Spec.Sha512.bytesBE 16 l
sha256 779684982975054af7e95be53daa6bb6a4a58ddb170171370c93daccc934f120
def M0Crypto.Spec.Sha512.toWord : List M0Crypto.Spec.Sha512.Byte → M0Crypto.Spec.Sha512.Word :=
  fun bs => BitVec.ofNat 64 (List.foldl (fun a b => 256 * a + BitVec.toNat b) 0 bs)
sha256 1cf8578130fce32ec7e37a2695e5b882335fddc70f4dd3237bbad06153056d0e
def M0Crypto.Spec.Sha512.parse : List M0Crypto.Spec.Sha512.Byte → Array M0Crypto.Spec.Sha512.Word :=
  fun block =>
  (List.map (fun j => M0Crypto.Spec.Sha512.toWord (List.take 8 (List.drop (8 * j) block))) (List.range 16)).toArray
