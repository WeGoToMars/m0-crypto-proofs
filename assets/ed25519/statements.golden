def M0Crypto.Spec.Sha512.H0 : Array M0Crypto.Spec.Sha512.Word :=
  #[7640891576956012808#64, 13503953896175478587#64, 4354685564936845355#64, 11912009170470909681#64,
  5840696475078001361#64, 11170449401992604703#64, 2270897969802886507#64, 6620516959819538809#64]
sha256 09481a9abb0d8d9036266ea6fc1e158463e23b9a10318299d80a6c419fb357a3
def M0Crypto.Spec.Sha512.schedule : Array M0Crypto.Spec.Sha512.Word → Array M0Crypto.Spec.Sha512.Word :=
  fun M =>
  List.foldl
    (fun W t =>
      W.push (M0Crypto.Spec.Sha512.sigma1 W[t - 2]! + W[t - 7]! + M0Crypto.Spec.Sha512.sigma0 W[t - 15]! + W[t - 16]!))
    M (List.range' 16 64)
sha256 f16b53a964e345c3977f5e0be86b83fbfc453734410d00cbe8814ab6a10a7e85
inductive M0Crypto.Spec.Sha512.Vars : Type
  | M0Crypto.Spec.Sha512.Vars.mk : M0Crypto.Spec.Sha512.Word →
  M0Crypto.Spec.Sha512.Word →
    M0Crypto.Spec.Sha512.Word →
      M0Crypto.Spec.Sha512.Word →
        M0Crypto.Spec.Sha512.Word →
          M0Crypto.Spec.Sha512.Word → M0Crypto.Spec.Sha512.Word → M0Crypto.Spec.Sha512.Word → M0Crypto.Spec.Sha512.Vars
sha256 d422d45b4ffd4cec936a1fa4022a4fe353f7256db1a87da17852c11cec40357e
def M0Crypto.Spec.Sha512.round : Array M0Crypto.Spec.Sha512.Word → M0Crypto.Spec.Sha512.Vars → Nat → M0Crypto.Spec.Sha512.Vars :=
  fun W v t =>
  have T1 :=
    v.h + M0Crypto.Spec.Sha512.Sigma1 v.e + M0Crypto.Spec.Sha512.Ch v.e v.f v.g + M0Crypto.Spec.Sha512.K[t]! + W[t]!;
  have T2 := M0Crypto.Spec.Sha512.Sigma0 v.a + M0Crypto.Spec.Sha512.Maj v.a v.b v.c;
  { a := T1 + T2, b := v.a, c := v.b, d := v.c, e := v.d + T1, f := v.e, g := v.f, h := v.g }
sha256 4b238554338b733a28adee1b0db85280ab123deeaf53c9e5426f150de47bd502
def M0Crypto.Spec.Sha512.compress : Array M0Crypto.Spec.Sha512.Word → List M0Crypto.Spec.Sha512.Byte → Array M0Crypto.Spec.Sha512.Word :=
  fun H block =>
  have W := M0Crypto.Spec.Sha512.schedule (M0Crypto.Spec.Sha512.parse block);
  have v :=
    List.foldl (M0Crypto.Spec.Sha512.round W)
      { a := H[0]!, b := H[1]!, c := H[2]!, d := H[3]!, e := H[4]!, f := H[5]!, g := H[6]!, h := H[7]! }
      (List.range 80);
  #[v.a + H[0]!, v.b + H[1]!, v.c + H[2]!, v.d + H[3]!, v.e + H[4]!, v.f + H[5]!, v.g + H[6]!, v.h + H[7]!]
sha256 4a5dcda30eee13e87df156f375bccfa1d2c803b4a0c51b45f13dda73885ac69e
def M0Crypto.Spec.Sha512.hash : Array M0Crypto.Spec.Sha512.Word → List M0Crypto.Spec.Sha512.Byte → Array M0Crypto.Spec.Sha512.Word :=
  fun H a => M0Crypto.Spec.Sha512.hash._unary ⟨H, a⟩
unfold M0Crypto.Spec.Sha512.hash.eq_def : ∀ (H : Array M0Crypto.Spec.Sha512.Word) (x : List M0Crypto.Spec.Sha512.Byte),
  M0Crypto.Spec.Sha512.hash H x =
    match x with
    | [] => H
    | b :: M =>
      M0Crypto.Spec.Sha512.hash (M0Crypto.Spec.Sha512.compress H (List.take 128 (b :: M))) (List.drop 128 (b :: M))
sha256 08de609baa00e54d08300f579b3ea5652e08a3dc57a17959466d26af4a47f140
def M0Crypto.Spec.Sha512.sha512 : List M0Crypto.Spec.Sha512.Byte → List M0Crypto.Spec.Sha512.Byte :=
  fun M =>
  List.flatMap (fun w => M0Crypto.Spec.Sha512.bytesBE 8 (BitVec.toNat w))
    (M0Crypto.Spec.Sha512.hash M0Crypto.Spec.Sha512.H0 (M0Crypto.Spec.Sha512.pad M)).toList
