  | M0Crypto.Release.Ed25519.Verify.Valid.mk : ∀ {b : M0Crypto.Release.Ed25519.Build} {c : M0Crypto.Release.Ed25519.Verify.Ctx},
  c.Valid b M0Crypto.Release.Ed25519.Verify.stackBytes →
    BitVec.toNat c.len < 2 ^ 32 - 64 →
      M0Crypto.Release.Frame.Disj c.sig 64 c.fp M0Crypto.Release.Ed25519.Verify.stackBytes →
        c.len = 0 ∨
            M0Crypto.Release.Frame.Disj c.msg (BitVec.toNat c.len) c.fp M0Crypto.Release.Ed25519.Verify.stackBytes →
          M0Crypto.Release.Frame.Disj c.pk 32 c.fp M0Crypto.Release.Ed25519.Verify.stackBytes →
            M0Crypto.Release.Ed25519.Verify.Valid b c
sha256 0803ecefb4f28bec141467988a5d3050f665587ee8505e627f3e4956939d23e0
inductive M0Crypto.Release.Ed25519.Verify.Entry : M0Crypto.Release.Ed25519.Build → M0Crypto.Release.Ed25519.Verify.Ctx → M0Crypto.Armv6M.State → Prop
  | M0Crypto.Release.Ed25519.Verify.Entry.mk : ∀ {b : M0Crypto.Release.Ed25519.Build} {c : M0Crypto.Release.Ed25519.Verify.Ctx} {s : M0Crypto.Armv6M.State},
  c.Entry b.verifyAt s →
    c.regs0 0 = c.sig →
      c.regs0 1 = c.msg → c.regs0 2 = c.len → c.regs0 3 = c.pk → M0Crypto.Release.Ed25519.Verify.Entry b c s
sha256 8863fe4e138e733f35f500fb3fb7cfa9ccaa6031ebaa8555db6339fb01d73d2d
inductive M0Crypto.Release.Ed25519.Verify.Pre : M0Crypto.Release.Ed25519.Build → M0Crypto.Release.Ed25519.Verify.Ctx → M0Crypto.Armv6M.State → Prop
  | M0Crypto.Release.Ed25519.Verify.Pre.mk : ∀ {b : M0Crypto.Release.Ed25519.Build} {c : M0Crypto.Release.Ed25519.Verify.Ctx} {s : M0Crypto.Armv6M.State},
  M0Crypto.Release.Ed25519.Verify.Valid b c →
    M0Crypto.Release.Ed25519.Verify.Entry b c s → M0Crypto.Release.Ed25519.Verify.Pre b c s
sha256 87f8e77902262fb5516dfce192f14c1977292030487739333a4bd4652bc99c96
inductive M0Crypto.Release.Ed25519.Verify.Result : M0Crypto.Release.Ed25519.Verify.Ctx → M0Crypto.Armv6M.State → Prop
  | M0Crypto.Release.Ed25519.Verify.Result.mk : ∀ {c : M0Crypto.Release.Ed25519.Verify.Ctx} {t : M0Crypto.Armv6M.State},
  c.Returned t →
    (t.regs 0 = if M0Crypto.Spec.Ed25519.verify c.sigB c.msgB c.pkB = Bool.true then 0 else 4294967295#32) →
      (∀ (y : M0Crypto.Armv6M.Word),
          ¬M0Crypto.Release.Region c.fp M0Crypto.Release.Ed25519.Verify.stackBytes y → t.mem y = c.m0 y) →
        M0Crypto.Release.Ed25519.Verify.Result c t
