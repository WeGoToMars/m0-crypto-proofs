sha256 19078a4f2881ad49b2cabfee812a449eee0d7d8151b347cafc6149d09c956796
def M0Crypto.Thumb.asrC : M0Crypto.Armv6M.Word → Nat → M0Crypto.Armv6M.Word × Bool :=
