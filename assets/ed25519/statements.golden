unfold M0Crypto.Spec.Ed25519.scalarMul.eq_def : ∀ (s : Nat) (P : M0Crypto.Spec.Ed25519.Point),
  M0Crypto.Spec.Ed25519.scalarMul s P =
    if s = 0 then M0Crypto.Spec.Ed25519.neutral
    else
      have Q := M0Crypto.Spec.Ed25519.scalarMul (s / 2) (M0Crypto.Spec.Ed25519.add P P);
      if s % 2 = 1 then M0Crypto.Spec.Ed25519.add Q P else Q
