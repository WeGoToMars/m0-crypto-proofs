  | M0Crypto.Release.Ed25519.Call.Entry.mk : ∀ {k : M0Crypto.Release.Ed25519.Call} {off : Nat} {s : M0Crypto.Armv6M.State},
  s.regs = k.regs0 → s.mem = k.m0 → k.regs0 15 = k.base + BitVec.ofNat 32 off → k.regs0 13 = k.sp0 → k.Entry off s
