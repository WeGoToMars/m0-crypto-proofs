def M0Crypto.Release.Ed25519.Verify.Correct : Prop :=
  ∀ (b : M0Crypto.Release.Ed25519.Build) (c : M0Crypto.Release.Ed25519.Verify.Ctx) (s : M0Crypto.Armv6M.State),
  M0Crypto.Release.Ed25519.Verify.Pre b c s →
    c.Returns s (M0Crypto.Release.Ed25519.Verify.Result c) (M0Crypto.Release.Ed25519.Verify.WrOk c)
sha256 7ee1eab42bea1e6e09682e57af0924a5e16bd2cef8e343f3cd84e0a181412c36
def M0Crypto.Release.Ed25519.TraceEq : {C P : Type} →
  (M0Crypto.Release.Ed25519.Build → C → M0Crypto.Armv6M.State → Prop) →
    (C → M0Crypto.Release.Ed25519.Call) → (C → P) → Prop :=
  fun {C P} Pre call pub =>
  ∀ (b : M0Crypto.Release.Ed25519.Build) (c₁ c₂ : C) (s₁ s₂ : M0Crypto.Armv6M.State),
    Pre b c₁ s₁ →
      Pre b c₂ s₂ →
        pub c₁ = pub c₂ →
          ∀ (fuel : Nat),
            Except.map Prod.snd (M0Crypto.Thumb.runUntil (call c₁).ret fuel s₁) =
              Except.map Prod.snd (M0Crypto.Thumb.runUntil (call c₂).ret fuel s₂)
sha256 d26801703dfb442bcd0fd4587e70da5b58c567988be92f4383b0db6231d7d674
def M0Crypto.Release.Ed25519.ReadsIn : {C : Type} →
  (M0Crypto.Release.Ed25519.Build → C → M0Crypto.Armv6M.State → Prop) →
    (C → M0Crypto.Release.Ed25519.Call) → (M0Crypto.Release.Ed25519.Build → C → M0Crypto.Armv6M.Word → Prop) → Prop :=
  fun {C} Pre call Rd =>
  ∀ (b : M0Crypto.Release.Ed25519.Build) (c : C) (s : M0Crypto.Armv6M.State),
    Pre b c s →
      ∃ n,
        ∀ (fuel : Nat),
          n ≤ fuel →
            ∃ t tr,
              M0Crypto.Thumb.runUntil (call c).ret fuel s = Except.ok (t, tr) ∧
                M0Crypto.Release.TraceSpec.ReadsFrom (Rd b c) tr
sha256 c15cbf6319d84c9d00dc23ff949f105a9127c16b76248c5563f363d2a3916057
def M0Crypto.Release.Ed25519.StackIn : {C : Type} →
  (M0Crypto.Release.Ed25519.Build → C → M0Crypto.Armv6M.State → Prop) → (C → M0Crypto.Release.Ed25519.Call) → Nat → Prop :=
  fun {C} Pre call n =>
  ∀ (b : M0Crypto.Release.Ed25519.Build) (c : C) (s : M0Crypto.Armv6M.State),
    Pre b c s →
      ∃ m,
        ∀ (fuel : Nat),
          m ≤ fuel →
            ∃ states tr,
              M0Crypto.Release.runStates (call c).ret fuel s = Except.ok (states, tr) ∧
                ∀ (st : M0Crypto.Armv6M.State),
                  st ∈ states → M0Crypto.Release.TraceSpec.InStackWindow (call c).sp0 n (st.regs 13)
sha256 cae4ed0ca24ceb6b1ee4f9372facf6950871274de36e76c9da3399f2098337ca
def M0Crypto.Release.Ed25519.DisciplineIn : {C : Type} →
  (M0Crypto.Release.Ed25519.Build → C → M0Crypto.Armv6M.State → Prop) → (C → M0Crypto.Release.Ed25519.Call) → Nat → Prop :=
  fun {C} Pre call n =>
  ∀ (b : M0Crypto.Release.Ed25519.Build) (c : C) (s : M0Crypto.Armv6M.State),
    Pre b c s →
      ∃ m,
        ∀ (fuel : Nat),
          m ≤ fuel →
            ∃ states tr,
              M0Crypto.Release.runStates (call c).ret fuel s = Except.ok (states, tr) ∧
                M0Crypto.Release.TraceSpec.StackDiscipline (call c).sp0 n states tr
sha256 cb114c846fdd82a17b5a9f272b7c8aa2b1a824204d42503ce92bf9248d5cbd1e
def M0Crypto.Release.Ed25519.InterruptedIn : {C : Type} →
  (M0Crypto.Release.Ed25519.Build → C → M0Crypto.Armv6M.State → Prop) →
    (C → M0Crypto.Release.Ed25519.Call) →
      Nat →
        (M0Crypto.Release.Ed25519.Build → C → M0Crypto.Armv6M.Word → Prop) → (C → M0Crypto.Armv6M.State → Prop) → Prop :=
  fun {C} Pre call n P Result =>
  ∀ (K : Nat) (b : M0Crypto.Release.Ed25519.Build) (c : C) (s : M0Crypto.Armv6M.State),
    Pre b c s → M0Crypto.Release.TraceSpec.InterruptedCall K n (call c).sp0 (call c).ret s (P b c) (Result c)
