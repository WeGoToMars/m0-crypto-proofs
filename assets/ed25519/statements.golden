              M0Crypto.Armv6M.Word ×
                List M0Crypto.Release.Ed25519.Byte ×
                  List M0Crypto.Release.Ed25519.Byte × List M0Crypto.Release.Ed25519.Byte :=
  fun c => (c.base, c.sp0, c.regs0 14, c.sig, c.msg, c.len, c.pk, c.sigB, c.msgB, c.pkB)
