def M0Crypto.Spec.Ed25519.secretScalar : List M0Crypto.Spec.Ed25519.Byte → Nat :=
  fun h =>
  have buf := List.take 32 h;
  have buf := buf.set 0 (buf.getD 0 0 &&& 248#8);
  have buf := buf.set 31 (buf.getD 31 0 &&& 127#8 ||| 64#8);
  M0Crypto.Spec.Ed25519.decodeInt buf
sha256 e93e40d87442523b44c93c22c447f52672f8446e847e5d4cbf89b679a6a5f793
def M0Crypto.Spec.Ed25519.publicKey : List M0Crypto.Spec.Ed25519.Byte → List M0Crypto.Spec.Ed25519.Byte :=
  fun privKey =>
  have h := M0Crypto.Spec.Sha512.sha512 privKey;
  have s := M0Crypto.Spec.Ed25519.secretScalar h;
  M0Crypto.Spec.Ed25519.encodePoint (M0Crypto.Spec.Ed25519.scalarMul s M0Crypto.Spec.Ed25519.B)
sha256 72b7b43ab3de555e2a2c4dc691844e447ca0da0c84e1168c1aae76809ac1538f
def M0Crypto.Spec.Ed25519.signWith : List M0Crypto.Spec.Ed25519.Byte →
  List M0Crypto.Spec.Ed25519.Byte → List M0Crypto.Spec.Ed25519.Byte → List M0Crypto.Spec.Ed25519.Byte :=
  fun privKey A M =>
  have h := M0Crypto.Spec.Sha512.sha512 privKey;
  have s := M0Crypto.Spec.Ed25519.secretScalar h;
  have «prefix» := List.drop 32 h;
  have r := M0Crypto.Spec.Ed25519.decodeInt (M0Crypto.Spec.Sha512.sha512 («prefix» ++ M));
  have R :=
    M0Crypto.Spec.Ed25519.encodePoint
      (M0Crypto.Spec.Ed25519.scalarMul (r % M0Crypto.Spec.Ed25519.L) M0Crypto.Spec.Ed25519.B);
  have k := M0Crypto.Spec.Ed25519.decodeInt (M0Crypto.Spec.Sha512.sha512 (R ++ A ++ M));
  have S := (r + k * s) % M0Crypto.Spec.Ed25519.L;
  R ++ M0Crypto.Spec.Ed25519.encodeInt S
