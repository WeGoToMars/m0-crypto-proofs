sha256 4ebc10aefa77caf224b3c6d8f6ad51d80e46b1e802d658397ba3be812e606278
def M0Crypto.Spec.Ed25519.add : M0Crypto.Spec.Ed25519.Point → M0Crypto.Spec.Ed25519.Point → M0Crypto.Spec.Ed25519.Point :=
  fun P Q =>
  have A := M0Crypto.Spec.Ed25519.fsub P.Y P.X * M0Crypto.Spec.Ed25519.fsub Q.Y Q.X % M0Crypto.Spec.Ed25519.p;
  have B := (P.Y + P.X) * (Q.Y + Q.X) % M0Crypto.Spec.Ed25519.p;
  have C := P.T * 2 * M0Crypto.Spec.Ed25519.d * Q.T % M0Crypto.Spec.Ed25519.p;
  have D := P.Z * 2 * Q.Z % M0Crypto.Spec.Ed25519.p;
  have E := M0Crypto.Spec.Ed25519.fsub B A;
  have F := M0Crypto.Spec.Ed25519.fsub D C;
  have G := (D + C) % M0Crypto.Spec.Ed25519.p;
  have H := (B + A) % M0Crypto.Spec.Ed25519.p;
  { X := E * F % M0Crypto.Spec.Ed25519.p, Y := G * H % M0Crypto.Spec.Ed25519.p, Z := F * G % M0Crypto.Spec.Ed25519.p,
    T := E * H % M0Crypto.Spec.Ed25519.p }
