sha256 431db4e25d228851b8ca62d9068a3b93066d30b86eb69184cef168197583448b
def M0Crypto.Thumb.revBytes : M0Crypto.Armv6M.Word → M0Crypto.Armv6M.Word :=
  fun x => BitVec.extractLsb' 0 8 x ++ BitVec.extractLsb' 8 8 x ++ BitVec.extractLsb' 16 8 x ++ BitVec.extractLsb' 24 8 x
sha256 305d807402f17516c7f16b684c1b6e739d509dc35da789f07a9261453742239e
def M0Crypto.Thumb.condPassed : BitVec 4 → M0Crypto.Armv6M.State → Bool :=
  fun cond s =>
  match cond.toNat with
  | 0 => s.z
  | 1 => !s.z
  | 2 => s.c
  | 3 => !s.c
  | 4 => s.n
  | 5 => !s.n
  | 6 => s.v
  | 7 => !s.v
  | 8 => s.c && !s.z
  | 9 => !s.c || s.z
  | 10 => s.n == s.v
  | 11 => s.n != s.v
  | 12 => !s.z && s.n == s.v
  | 13 => s.z || s.n != s.v
  | x => Bool.false
sha256 1c565adf896b843739fe757f686c08d662864c8db4738989fb4c0d8af8d14362
def M0Crypto.Thumb.listRegs : BitVec 8 → List M0Crypto.Armv6M.LowReg :=
  fun l => List.filter (fun i => l.getLsbD ↑i) (List.finRange 8)
sha256 83198bb4f908a84d34f0ad080e0a348b093dd88754ac364f93e977c239f65132
def M0Crypto.Thumb.bitCount : BitVec 8 → Nat :=
