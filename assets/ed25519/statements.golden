  M0Crypto.Release.Region c.sig 64 y ∨
    M0Crypto.Release.Region c.msg (BitVec.toNat c.len) y ∨
      M0Crypto.Release.Region c.pk 32 y ∨
        M0Crypto.Release.Region c.base b.size y ∨
          M0Crypto.Release.Region c.fp M0Crypto.Release.Ed25519.Verify.stackBytes y
