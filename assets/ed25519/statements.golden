sha256 355fbeb3615f99d7364f0b2e7004eda05facd7531b16cd8538f5f7bc015ef9e9
inductive M0Crypto.Release.Ed25519.Call.Valid : M0Crypto.Release.Ed25519.Call → M0Crypto.Release.Ed25519.Build → Nat → Prop
  | M0Crypto.Release.Ed25519.Call.Valid.mk : ∀ {k : M0Crypto.Release.Ed25519.Call} {b : M0Crypto.Release.Ed25519.Build} {n : Nat},
  BitVec.toNat k.base % 4 = 0 →
    BitVec.toNat k.sp0 % 4 = 0 →
      n ≤ BitVec.toNat k.sp0 →
        M0Crypto.Release.Frame.Disj k.base b.size (k.fp n) n →
          M0Crypto.Thumb.CodeAt k.m0 k.base b.bytes →
            BitVec.getLsbD (k.regs0 14) 0 = Bool.true → ¬M0Crypto.Release.Region k.base b.size k.ret → k.Valid b n
