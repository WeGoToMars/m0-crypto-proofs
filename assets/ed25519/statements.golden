sha256 258805d2a9ae711965ad9086ffa93ff6eb6069e927018736c03dc18351fa36c0
def M0Crypto.Thumb.lslRegC : M0Crypto.Armv6M.Word → Nat → Bool → M0Crypto.Armv6M.Word × Bool :=
  fun x n c => if n = 0 then (x, c) else (x <<< n, (BitVec.toNat x <<< n).testBit 32)
sha256 3341937e8ba4662bee289931ed9259b8da9bcb3c453f5869ca8ff80753488111
def M0Crypto.Thumb.lsrRegC : M0Crypto.Armv6M.Word → Nat → Bool → M0Crypto.Armv6M.Word × Bool :=
