inductive M0Crypto.Release.Ed25519.Call.Returned : M0Crypto.Release.Ed25519.Call → M0Crypto.Armv6M.State → Prop
  | M0Crypto.Release.Ed25519.Call.Returned.mk : ∀ {k : M0Crypto.Release.Ed25519.Call} {t : M0Crypto.Armv6M.State},
  t.pc = k.ret →
