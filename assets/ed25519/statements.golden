sha256 ef043aaa81f4f0e0ddae57dc777b5f5ebd20a9b5d10c9197dadc544a770cb9e5
def M0Crypto.Spec.Ed25519.verify : List M0Crypto.Spec.Ed25519.Byte → List M0Crypto.Spec.Ed25519.Byte → List M0Crypto.Spec.Ed25519.Byte → Bool :=
  fun signature M A =>
  have Rs := List.take 32 signature;
  have S := M0Crypto.Spec.Ed25519.decodeInt (List.drop 32 signature);
  match M0Crypto.Spec.Ed25519.decodePoint Rs, M0Crypto.Spec.Ed25519.decodePoint A with
  | Option.some R, Option.some A' =>
    have k := M0Crypto.Spec.Ed25519.decodeInt (M0Crypto.Spec.Sha512.sha512 (Rs ++ A ++ M));
    Decidable.decide (S < M0Crypto.Spec.Ed25519.L) &&
      (M0Crypto.Spec.Ed25519.scalarMul S M0Crypto.Spec.Ed25519.B).xy ==
        (M0Crypto.Spec.Ed25519.add R (M0Crypto.Spec.Ed25519.scalarMul (k % M0Crypto.Spec.Ed25519.L) A')).xy
  | x, x_1 => Bool.false
