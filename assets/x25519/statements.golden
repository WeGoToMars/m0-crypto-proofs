def M0Crypto.Release.Region : M0Crypto.Armv6M.Word → Nat → M0Crypto.Armv6M.Word → Prop :=
  fun a n y => BitVec.toNat (y - a) < n
sha256 b444adf17d080d05534540acc0ec39895dd11005e6ed43eb55e4b2991c4609d4
def M0Crypto.Release.WritesTo : (M0Crypto.Armv6M.Word → Prop) → List M0Crypto.Thumb.Event → Prop :=
  fun Wr tr =>
  ∀ (e : M0Crypto.Thumb.Event), e ∈ tr → ∀ (y : M0Crypto.Armv6M.Word), M0Crypto.Thumb.Writes e.accesses y → Wr y
sha256 56af25871ce05a8a39274a18bab4121df468b3b8da3d0518fdae1ab8474048d5
def M0Crypto.Release.runStates : M0Crypto.Armv6M.Word →
  Nat → M0Crypto.Armv6M.State → Except M0Crypto.Thumb.Fault (List M0Crypto.Armv6M.State × List M0Crypto.Thumb.Event) :=
  fun stop x x_1 =>
  Nat.brecOn (motive := fun x =>
    M0Crypto.Armv6M.State → Except M0Crypto.Thumb.Fault (List M0Crypto.Armv6M.State × List M0Crypto.Thumb.Event)) x
    (M0Crypto.Release.runStates._f stop) x_1
unfold M0Crypto.Release.runStates.eq_def : ∀ (stop : M0Crypto.Armv6M.Word) (x : Nat) (x_1 : M0Crypto.Armv6M.State),
  M0Crypto.Release.runStates stop x x_1 =
    match x, x_1 with
    | fuel, s =>
      if s.pc = stop then Except.ok ([s], [])
      else
        match fuel with
        | 0 => Except.error M0Crypto.Thumb.Fault.fuel
        | n.succ =>
          match M0Crypto.Thumb.step s with
          | Except.error e => Except.error e
          | Except.ok (s', e) =>
            match M0Crypto.Release.runStates stop n s' with
            | Except.error e' => Except.error e'
            | Except.ok (states, es) => Except.ok (s :: states, e :: es)
sha256 400d6ec434d3ec319549100c8ad912b4bcec5dedfcb9e9312ae8b10f92c43a6f
def M0Crypto.Release.Frame.Ctx.bytesAt : M0Crypto.Armv6M.Mem → M0Crypto.Armv6M.Word → Nat → List (BitVec 8) :=
  fun m x x_1 =>
  Nat.brecOn (motive := fun x => M0Crypto.Armv6M.Word → List (BitVec 8)) x_1 (M0Crypto.Release.Frame.Ctx.bytesAt._f m) x
unfold M0Crypto.Release.Frame.Ctx.bytesAt.eq_def : ∀ (m : M0Crypto.Armv6M.Mem) (x : M0Crypto.Armv6M.Word) (x_1 : Nat),
  M0Crypto.Release.Frame.Ctx.bytesAt m x x_1 =
    match x, x_1 with
    | x, 0 => []
    | a, n.succ => m a :: M0Crypto.Release.Frame.Ctx.bytesAt m (a + 1#32) n
sha256 5cb18749722a03f6f00b3257d734b9ad37ca26f2619135396d562b4ec1333f04
def M0Crypto.Release.Frame.Disj : M0Crypto.Armv6M.Word → Nat → M0Crypto.Armv6M.Word → Nat → Prop :=
  fun a n b m =>
  BitVec.toNat a + n ≤ 2 ^ 32 ∧
    BitVec.toNat b + m ≤ 2 ^ 32 ∧ (BitVec.toNat a + n ≤ BitVec.toNat b ∨ BitVec.toNat b + m ≤ BitVec.toNat a)
sha256 634527797766e48d84e62903d3e27129e6ab0f50341249c806ec4e3fe15595d4
def M0Crypto.Release.TraceSpec.ReadsFrom : (M0Crypto.Armv6M.Word → Prop) → List M0Crypto.Thumb.Event → Prop :=
  fun Rd tr =>
  ∀ (e : M0Crypto.Thumb.Event), e ∈ tr → ∀ (y : M0Crypto.Armv6M.Word), M0Crypto.Thumb.Reads e.accesses y → Rd y
sha256 996b7d69939c1281c812c19e99ad6bce15422433ed1f7a493550c6c0e2aab44e
def M0Crypto.Release.TraceSpec.InStackWindow : M0Crypto.Armv6M.Word → Nat → M0Crypto.Armv6M.Word → Prop :=
  fun sp0 stackBytes sp => ∃ o, o ≤ stackBytes ∧ sp = sp0 - BitVec.ofNat 32 o
sha256 1caab14beb4dcaebb8da2c7f60aff77e64e908d4f1cb099e2556734b67e21940
def M0Crypto.Release.TraceSpec.BelowEntry : M0Crypto.Armv6M.Word → Nat → M0Crypto.Armv6M.Word → Prop :=
  fun sp0 n y => M0Crypto.Release.Region (sp0 - BitVec.ofNat 32 n) n y
sha256 25bc373f8268d5aea8ce505a041c61e59b8ba122e1d451fbf8e84e7d836ad01c
def M0Crypto.Release.TraceSpec.AtOrAboveSp : M0Crypto.Armv6M.Word → M0Crypto.Armv6M.Word → M0Crypto.Armv6M.Word → Prop :=
  fun sp0 sp y => M0Crypto.Release.Region sp (BitVec.toNat (sp0 - sp)) y
sha256 16548dc85fa9cdfcd7b6b22d6ea974003f20075e45dc5fd1456132f401e8737b
def M0Crypto.Release.TraceSpec.StackAccessesAboveSp : M0Crypto.Armv6M.Word → Nat → List M0Crypto.Armv6M.State → List M0Crypto.Thumb.Event → Prop :=
  fun sp0 n states tr =>
  ∀ (k : Nat) (e : M0Crypto.Thumb.Event) (u u' : M0Crypto.Armv6M.State),
    tr[k]? = Option.some e →
      states[k]? = Option.some u →
        states[k + 1]? = Option.some u' →
          ∀ (y : M0Crypto.Armv6M.Word),
            M0Crypto.Thumb.Reads e.accesses y ∨ M0Crypto.Thumb.Writes e.accesses y →
              M0Crypto.Release.TraceSpec.BelowEntry sp0 n y →
                M0Crypto.Release.TraceSpec.AtOrAboveSp sp0 u.sp y ∨ M0Crypto.Release.TraceSpec.AtOrAboveSp sp0 u'.sp y
sha256 1c2c4e5d9a3bc2f08a9ebcbf740b8754d6c75fff4bbfb5d935c707e67566ad43
def M0Crypto.Release.TraceSpec.WrittenSinceAllocated : M0Crypto.Armv6M.Word → List M0Crypto.Armv6M.State → List M0Crypto.Thumb.Event → Nat → M0Crypto.Armv6M.Word → Prop :=
  fun sp0 states tr k y =>
  ∃ j,
    j < k ∧
      (∃ e, tr[j]? = Option.some e ∧ M0Crypto.Thumb.Writes e.accesses y) ∧
        ∀ (i : Nat) (u : M0Crypto.Armv6M.State),
          j < i → i ≤ k → states[i]? = Option.some u → M0Crypto.Release.TraceSpec.AtOrAboveSp sp0 u.sp y
sha256 71ca6b2c4f28d47a144d69fcce00d0eaf4a85f27217fdddcc588f0b005375c76
def M0Crypto.Release.TraceSpec.StackReadsWritten : M0Crypto.Armv6M.Word → Nat → List M0Crypto.Armv6M.State → List M0Crypto.Thumb.Event → Prop :=
  fun sp0 n states tr =>
  ∀ (k : Nat) (e : M0Crypto.Thumb.Event),
    tr[k]? = Option.some e →
      ∀ (y : M0Crypto.Armv6M.Word),
        M0Crypto.Thumb.Reads e.accesses y →
          M0Crypto.Release.TraceSpec.BelowEntry sp0 n y →
            M0Crypto.Release.TraceSpec.WrittenSinceAllocated sp0 states tr k y
sha256 664429e88dc91d5b884a55afd7904f16359ad2795da18bebe064558e7d2b9c88
def M0Crypto.Release.TraceSpec.StackDiscipline : M0Crypto.Armv6M.Word → Nat → List M0Crypto.Armv6M.State → List M0Crypto.Thumb.Event → Prop :=
  fun sp0 n states tr =>
  M0Crypto.Release.TraceSpec.StackAccessesAboveSp sp0 n states tr ∧
    M0Crypto.Release.TraceSpec.StackReadsWritten sp0 n states tr
sha256 57aaa35cdb9c4573d2740d8dddc3292aef514a61d8c3770144ce2cd80545a238
def M0Crypto.Release.TraceSpec.SameOn : (M0Crypto.Armv6M.Word → Prop) → M0Crypto.Armv6M.State → M0Crypto.Armv6M.State → Prop :=
  fun Q t t' =>
  t'.regs = t.regs ∧
    t'.n = t.n ∧ t'.z = t.z ∧ t'.c = t.c ∧ t'.v = t.v ∧ ∀ (y : M0Crypto.Armv6M.Word), Q y → t'.mem y = t.mem y
sha256 ae775cdcac07a68548f1cfe88ab41d35bfa7cbb350719af692451705a580091f
def M0Crypto.Release.TraceSpec.Handlers : Nat → (M0Crypto.Armv6M.Word → Prop) → (Nat → M0Crypto.Armv6M.State → M0Crypto.Armv6M.State) → Prop :=
  fun K P H =>
  ∀ (k : Nat) (s : M0Crypto.Armv6M.State),
    M0Crypto.Release.TraceSpec.SameOn (fun y => P y ∧ ¬M0Crypto.Release.Region (s.sp - BitVec.ofNat 32 K) K y) s (H k s)
sha256 59d833696afd66dbf43b92c9af0639af509af7072347486bac8f543967b4fc80
def M0Crypto.Release.TraceSpec.irunStates : (Nat → M0Crypto.Armv6M.State → M0Crypto.Armv6M.State) →
  M0Crypto.Armv6M.Word →
    Nat →
      Nat → M0Crypto.Armv6M.State → Except M0Crypto.Thumb.Fault (List M0Crypto.Armv6M.State × List M0Crypto.Thumb.Event) :=
  fun H stop x x_1 x_2 =>
  Nat.brecOn (motive := fun x =>
    Nat → M0Crypto.Armv6M.State → Except M0Crypto.Thumb.Fault (List M0Crypto.Armv6M.State × List M0Crypto.Thumb.Event))
    x (M0Crypto.Release.TraceSpec.irunStates._f H stop) x_1 x_2
unfold M0Crypto.Release.TraceSpec.irunStates.eq_def : ∀ (H : Nat → M0Crypto.Armv6M.State → M0Crypto.Armv6M.State) (stop : M0Crypto.Armv6M.Word) (x x_1 : Nat)
  (x_2 : M0Crypto.Armv6M.State),
  M0Crypto.Release.TraceSpec.irunStates H stop x x_1 x_2 =
    match x, x_1, x_2 with
    | fuel, k, s =>
      if s.pc = stop then Except.ok ([s], [])
      else
        match fuel with
        | 0 => Except.error M0Crypto.Thumb.Fault.fuel
        | n.succ =>
          match M0Crypto.Thumb.step (H k s) with
          | Except.error e => Except.error e
          | Except.ok (s', e) =>
            match M0Crypto.Release.TraceSpec.irunStates H stop n (k + 1) s' with
            | Except.error e' => Except.error e'
            | Except.ok (states, es) => Except.ok (s :: states, e :: es)
sha256 41ef631002930bf1b7f70cccb898a57d670f7809f3f3fba76323dc4f087b986c
def M0Crypto.Release.TraceSpec.HandlerRoom : Nat → Nat → M0Crypto.Armv6M.Word → (M0Crypto.Armv6M.Word → Prop) → Prop :=
  fun K n sp0 P =>
  n + K ≤ BitVec.toNat sp0 ∧
    ∀ (y : M0Crypto.Armv6M.Word), M0Crypto.Release.Region (sp0 - BitVec.ofNat 32 (n + K)) K y → ¬P y
sha256 a12af0a2a461389a43da9f7e148996ba93f3046ebb461d1dbc1feac98188c5a3
def M0Crypto.Release.TraceSpec.InterruptedCall : Nat →
  Nat →
    M0Crypto.Armv6M.Word →
      M0Crypto.Armv6M.Word →
        M0Crypto.Armv6M.State → (M0Crypto.Armv6M.Word → Prop) → (M0Crypto.Armv6M.State → Prop) → Prop :=
  fun K n sp0 stop s P Result =>
  M0Crypto.Release.TraceSpec.HandlerRoom K n sp0 P →
    ∀ (H : Nat → M0Crypto.Armv6M.State → M0Crypto.Armv6M.State),
      M0Crypto.Release.TraceSpec.Handlers K P H →
        ∃ m,
          ∀ (fuel : Nat),
            m ≤ fuel →
              ∃ t₀ tr states t,
                M0Crypto.Thumb.runUntil stop fuel s = Except.ok (t₀, tr) ∧
                  Result t₀ ∧
                    M0Crypto.Release.TraceSpec.irunStates H stop fuel 0 s = Except.ok (states, tr) ∧
                      states.getLast? = Option.some t ∧
                        M0Crypto.Release.TraceSpec.SameOn
                            (fun y => P y ∧ ¬M0Crypto.Release.TraceSpec.BelowEntry sp0 n y) t₀ t ∧
                          ∀ (u : M0Crypto.Armv6M.State),
                            u ∈ states → M0Crypto.Release.TraceSpec.InStackWindow sp0 n u.sp
