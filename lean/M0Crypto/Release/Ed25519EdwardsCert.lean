/-- The y-coordinates of `(P1 + P2) + P3` and `P1 + (P2 + P3)` agree, cross-multiplied. -/
theorem assoc_y {a d x1 y1 x2 y2 x3 y3 : R}
    (h1 : a * x1^2 + y1^2 = 1 + d * x1^2 * y1^2)
    (h2 : a * x2^2 + y2^2 = 1 + d * x2^2 * y2^2)
    (h3 : a * x3^2 + y3^2 = 1 + d * x3^2 * y3^2) :
    ((y1 * y2 - a * x1 * x2) * (1 + d * x1 * x2 * y1 * y2) * y3 - a * (x1 * y2 + y1 * x2) * (1 - d * x1 * x2 * y1 * y2) * x3) * ((1 + d * x2 * x3 * y2 * y3) * (1 - d * x2 * x3 * y2 * y3) - d * x1 * y1 * (x2 * y3 + y2 * x3) * (y2 * y3 - a * x2 * x3))
      = (y1 * (y2 * y3 - a * x2 * x3) * (1 + d * x2 * x3 * y2 * y3) - a * x1 * (x2 * y3 + y2 * x3) * (1 - d * x2 * x3 * y2 * y3)) * ((1 + d * x1 * x2 * y1 * y2) * (1 - d * x1 * x2 * y1 * y2) - d * (x1 * y2 + y1 * x2) * (y1 * y2 - a * x1 * x2) * x3 * y3) := by
  have e1 : a * x1^2 + y1^2 - 1 - d * x1^2 * y1^2 = 0 := by grind
  have e2 : a * x2^2 + y2^2 - 1 - d * x2^2 * y2^2 = 0 := by grind
  have e3 : a * x3^2 + y3^2 - 1 - d * x3^2 * y3^2 = 0 := by grind
  have key := assoc_y_identity a d x1 y1 x2 y2 x3 y3
  rw [e1, e2, e3] at key
  grind

end M0Crypto.Release.Ed25519EdwardsCert
