      + (a^(3 : Nat)*x1^(3 : Nat)*x2^(3 : Nat)*y3 + a^(3 : Nat)*x1^(3 : Nat)*x2^(2 : Nat)*x3*y2 + a^(3 : Nat)*x1^(2 : Nat)*x2^(3 : Nat)*x3*y1 + a^(2 : Nat)*x1^(3 : Nat)*x2*y2^(2 : Nat)*y3 - a^(2 : Nat)*x1^(3 : Nat)*x2*y3 + a^(2 : Nat)*x1^(3 : Nat)*x3*y2^(3 : Nat) - a^(2 : Nat)*x1^(3 : Nat)*x3*y2 - a^(2 : Nat)*x1^(2 : Nat)*x2^(2 : Nat)*y1*y2*y3 + a^(2 : Nat)*x1^(2 : Nat)*x2*x3*y1*y2^(2 : Nat) - a^(2 : Nat)*x1^(2 : Nat)*x2*x3*y1 + a^(2 : Nat)*x1*x2^(3 : Nat)*y1^(2 : Nat)*y3 - a^(2 : Nat)*x1*x2^(3 : Nat)*y3 + a^(2 : Nat)*x1*x2^(2 : Nat)*x3*y1^(2 : Nat)*y2 - a^(2 : Nat)*x1*x2^(2 : Nat)*x3*y2 + a^(2 : Nat)*x2^(3 : Nat)*x3*y1^(3 : Nat) - a^(2 : Nat)*x2^(3 : Nat)*x3*y1 + a*d*x1^(2 : Nat)*x2^(2 : Nat)*y1*y2*y3 - a*d*x1^(2 : Nat)*x2*x3*y1*y2^(2 : Nat) - a*d*x1*x2^(2 : Nat)*x3*y1^(2 : Nat)*y2 - a*x1^(2 : Nat)*y1*y2^(3 : Nat)*y3 + a*x1^(2 : Nat)*y1*y2*y3 + a*x1*x2*y1^(2 : Nat)*y2^(2 : Nat)*y3 - a*x1*x2*y1^(2 : Nat)*y3 - a*x1*x2*y2^(2 : Nat)*y3 + a*x1*x2*y3 + a*x1*x3*y1^(2 : Nat)*y2^(3 : Nat) - a*x1*x3*y1^(2 : Nat)*y2 - a*x1*x3*y2^(3 : Nat) + a*x1*x3*y2 - a*x2^(2 : Nat)*y1^(3 : Nat)*y2*y3 + a*x2^(2 : Nat)*y1*y2*y3 + a*x2*x3*y1^(3 : Nat)*y2^(2 : Nat) - a*x2*x3*y1^(3 : Nat) - a*x2*x3*y1*y2^(2 : Nat) + a*x2*x3*y1 - d*x1*x2*y1^(2 : Nat)*y2^(2 : Nat)*y3 - y1^(3 : Nat)*y2^(3 : Nat)*y3 + y1^(3 : Nat)*y2*y3 + y1*y2^(3 : Nat)*y3 - y1*y2*y3)
        * (a * x3^2 + y3^2 - 1 - d * x3^2 * y3^2) := by
