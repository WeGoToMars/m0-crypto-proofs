  M0Crypto.Release.ChaCha20Round.RotRegs s →
    have s' := M0Crypto.Thumb.execAll M0Crypto.Release.ChaCha20Round.core s;
    (s'.regs 0, s'.regs 1, s'.regs 2, s'.regs 3) =
      M0Crypto.Spec.ChaCha20.quarterRound (s.regs 0) (s.regs 1) (s.regs 2) (s.regs 3)
M0Crypto.Release.ChaCha20Round.qr_effect : ∀ (s : M0Crypto.Armv6M.State) (a b c : Nat) (dreg : M0Crypto.Armv6M.Reg)
  (haveA keepA : Bool),
  a < 64 →
    b < 64 →
      c < 64 →
        M0Crypto.Release.ChaCha20Round.DReg dreg →
          M0Crypto.Release.ChaCha20Round.RotRegs s →
            have s' := M0Crypto.Thumb.execAll (M0Crypto.Release.ChaCha20Round.qr a b c dreg haveA keepA) s;
            have A :=
              if haveA = Bool.true then s.regs 0 else M0Crypto.Armv6M.read32 s.mem (M0Crypto.Armv6M.slot (s.regs 13) a);
            have q :=
              M0Crypto.Spec.ChaCha20.quarterRound A (M0Crypto.Armv6M.read32 s.mem (M0Crypto.Armv6M.slot (s.regs 13) b))
                (M0Crypto.Armv6M.read32 s.mem (M0Crypto.Armv6M.slot (s.regs 13) c)) (s.regs dreg);
            s'.regs 0 = q.fst ∧
              s'.regs dreg = q.snd.snd.snd ∧
                s'.mem =
                    M0Crypto.Armv6M.write32
                      (M0Crypto.Armv6M.write32
                        (if keepA = Bool.true then s.mem
                        else M0Crypto.Armv6M.write32 s.mem (M0Crypto.Armv6M.slot (s.regs 13) a) q.fst)
                        (M0Crypto.Armv6M.slot (s.regs 13) b) q.snd.fst)
                      (M0Crypto.Armv6M.slot (s.regs 13) c) q.snd.snd.fst ∧
                  ∀ (r : M0Crypto.Armv6M.Reg), 4 ≤ ↑r → ↑r ≤ 14 → r ≠ dreg → s'.regs r = s.regs r
M0Crypto.Thumb.alignedAll_sp : ∀ (is : List M0Crypto.Thumb.Instr) (s : M0Crypto.Armv6M.State),
  (M0Crypto.Thumb.SpBlock is fun p => p.snd % 4 = 0) →
    BitVec.toNat (s.regs 13) % 4 = 0 → M0Crypto.Thumb.alignedAll is s = Bool.true
M0Crypto.Thumb.execAll_mem_sp : ∀ (is : List M0Crypto.Thumb.Instr) (s : M0Crypto.Armv6M.State)
  (y : M0Crypto.Armv6M.Word),
  (M0Crypto.Thumb.SpBlock is fun p =>
      p.fst = M0Crypto.Thumb.Kind.read ∨
        ∀ (j : Nat), j < 4 → y ≠ s.regs 13 + BitVec.ofNat 32 p.snd + BitVec.ofNat 32 j) →
    (M0Crypto.Thumb.execAll is s).mem y = s.mem y
M0Crypto.Thumb.traceAll_sp_congr : ∀ (is : List M0Crypto.Thumb.Instr) (s t : M0Crypto.Armv6M.State),
  (M0Crypto.Thumb.SpBlock is fun x => True) →
    is.all M0Crypto.Thumb.Instr.falls = Bool.true →
      s.pc = t.pc → s.regs 13 = t.regs 13 → M0Crypto.Thumb.traceAll is s = M0Crypto.Thumb.traceAll is t
M0Crypto.Release.ChaCha20Round.qr_view : ∀ (s : M0Crypto.Armv6M.State) (a b c d : Nat) (haveA keepA : Bool),
  a < 12 →
    b < 12 →
      c < 12 →
        12 ≤ d →
          d < 16 →
            a ≠ b →
              a ≠ c →
                b ≠ c →
                  M0Crypto.Release.ChaCha20Round.RotRegs s →
                    M0Crypto.Release.ChaCha20Round.view (if keepA = Bool.true then Option.some a else Option.none)
                        (M0Crypto.Thumb.execAll
                          (M0Crypto.Release.ChaCha20Round.qr a b c (M0Crypto.Release.ChaCha20Round.dregOf d) haveA
                            keepA)
                          s) =
                      M0Crypto.Proofs.ChaCha20DoubleRound.qroundF
                        (M0Crypto.Release.ChaCha20Round.view (if haveA = Bool.true then Option.some a else Option.none)
                          s)
                        a b c d
M0Crypto.Release.ChaCha20Round.dround_view : ∀ (s : M0Crypto.Armv6M.State),
  M0Crypto.Release.ChaCha20Round.RotRegs s →
    M0Crypto.Release.ChaCha20Round.view (Option.some 2)
        (M0Crypto.Thumb.execAll M0Crypto.Release.ChaCha20Round.dround s) =
      M0Crypto.Proofs.ChaCha20DoubleRound.innerBlockF (M0Crypto.Release.ChaCha20Round.view (Option.some 2) s)
M0Crypto.Release.ChaCha20Round.dround_aligned : ∀ (s : M0Crypto.Armv6M.State),
  BitVec.toNat (s.regs 13) % 4 = 0 → M0Crypto.Thumb.alignedAll M0Crypto.Release.ChaCha20Round.dround s = Bool.true
M0Crypto.Release.ChaCha20Round.dround_mem : ∀ (s : M0Crypto.Armv6M.State) (y : M0Crypto.Armv6M.Word),
  (∀ (o : Nat), o < M0Crypto.Release.ChaCha20Round.droundBytes → y ≠ s.regs 13 + BitVec.ofNat 32 o) →
    (M0Crypto.Thumb.execAll M0Crypto.Release.ChaCha20Round.dround s).mem y = s.mem y
M0Crypto.Release.ChaCha20Round.dround_regs : ∀ (s : M0Crypto.Armv6M.State) (r : M0Crypto.Armv6M.Reg),
  ↑r ≠ 15 →
    3 < ↑r ∧ (↑r < 8 ∨ 11 < ↑r) → (M0Crypto.Thumb.execAll M0Crypto.Release.ChaCha20Round.dround s).regs r = s.regs r
M0Crypto.Release.ChaCha20Round.dround_trace_congr : ∀ (s t : M0Crypto.Armv6M.State),
  s.pc = t.pc →
    s.regs 13 = t.regs 13 →
      M0Crypto.Thumb.traceAll M0Crypto.Release.ChaCha20Round.dround s =
        M0Crypto.Thumb.traceAll M0Crypto.Release.ChaCha20Round.dround t
@M0Crypto.Thumb.runH_block : ∀ {bytes : List (BitVec 8)} {base : M0Crypto.Armv6M.Word},
  BitVec.toNat base % 2 = 0 →
    bytes.length < 2 ^ 32 →
      ∀ (is : List M0Crypto.Thumb.Instr) (off : Nat) (s : M0Crypto.Armv6M.State),
        s.pc = base + BitVec.ofNat 32 off →
          off % 2 = 0 →
            M0Crypto.Thumb.seqAt bytes off is = Bool.true →
              is.all M0Crypto.Thumb.Instr.falls = Bool.true →
                M0Crypto.Thumb.alignedAll is s = Bool.true →
                  ∀ (n : Nat),
                    M0Crypto.Thumb.runH bytes base (is.length + n) s =
                      match M0Crypto.Thumb.runH bytes base n (M0Crypto.Thumb.execAll is s) with
                      | Except.error e => Except.error e
                      | Except.ok (s2, t2) => Except.ok (s2, M0Crypto.Thumb.traceAll is s ++ t2)
@M0Crypto.Thumb.stepH_of_instr : ∀ {bytes : List (BitVec 8)} {base : M0Crypto.Armv6M.Word},
  BitVec.toNat base % 2 = 0 →
    bytes.length < 2 ^ 32 →
      ∀ {s s' : M0Crypto.Armv6M.State} {off : Nat} {i : M0Crypto.Thumb.Instr},
        s.pc = base + BitVec.ofNat 32 off →
          off % 2 = 0 →
            M0Crypto.Thumb.instrAt bytes off = Option.some i →
              off + i.size ≤ bytes.length →
                (i.accesses s).all M0Crypto.Thumb.Access.aligned = Bool.true →
                  i.exec s = Except.ok s' →
                    M0Crypto.Thumb.stepH bytes base s =
                      Except.ok (s', { pc := s.pc, instr := i, accesses := i.accesses s })
M0Crypto.Thumb.traceAll_writes_sp : ∀ (is : List M0Crypto.Thumb.Instr) (s : M0Crypto.Armv6M.State) (n : Nat),
  (M0Crypto.Thumb.SpBlock is fun p => p.fst = M0Crypto.Thumb.Kind.read ∨ p.snd + 4 ≤ n) →
    M0Crypto.Thumb.WritesIn (M0Crypto.Thumb.traceAll is s) (s.regs 13) n
@M0Crypto.Release.ChaCha20Loop.loop : ∀ {base : M0Crypto.Armv6M.Word},
  BitVec.toNat base % 4 = 0 →
    ∀ (n : Nat),
      1 ≤ n →
        n < 2 ^ 32 →
          ∀ (s : M0Crypto.Armv6M.State),
            s.pc = base + BitVec.ofNat 32 M0Crypto.Release.ChaCha20Layout.droundOff →
              M0Crypto.Release.ChaCha20Round.RotRegs s →
                BitVec.toNat (s.regs 13) % 4 = 0 →
                  s.regs 12 = BitVec.ofNat 32 n →
                    ∃ s' tr,
                      M0Crypto.Thumb.runH M0Crypto.Release.ChaCha20Loop.B base (161 * n - 1) s = Except.ok (s', tr) ∧
                        s'.pc = base + BitVec.ofNat 32 M0Crypto.Release.ChaCha20Layout.postOff ∧
                          M0Crypto.Release.ChaCha20Round.view (Option.some 2) s' =
                              M0Crypto.Release.ChaCha20Loop.iter M0Crypto.Proofs.ChaCha20DoubleRound.innerBlockF n
                                (M0Crypto.Release.ChaCha20Round.view (Option.some 2) s) ∧
                            M0Crypto.Release.ChaCha20Round.RotRegs s' ∧
                              s'.regs 13 = s.regs 13 ∧
                                s'.regs 14 = s.regs 14 ∧
                                  s'.regs 12 = 0 ∧
                                    (∀ (y : M0Crypto.Armv6M.Word),
                                        (∀ (o : Nat),
                                            o < M0Crypto.Release.ChaCha20Round.droundBytes →
                                              y ≠ s.regs 13 + BitVec.ofNat 32 o) →
                                          s'.mem y = s.mem y) ∧
                                      M0Crypto.Thumb.WritesIn tr (s.regs 13) M0Crypto.Release.ChaCha20Round.droundBytes
M0Crypto.Release.ChaCha20Loop.iter_toArr : ∀ (n : Nat) (f : Nat → M0Crypto.Armv6M.Word),
  M0Crypto.Proofs.ChaCha20DoubleRound.toArr
      (M0Crypto.Release.ChaCha20Loop.iter M0Crypto.Proofs.ChaCha20DoubleRound.innerBlockF n f) =
    M0Crypto.Spec.ChaCha20.innerBlocks n (M0Crypto.Proofs.ChaCha20DoubleRound.toArr f)
@M0Crypto.Release.Reach.runUntil : ∀ {base : M0Crypto.Armv6M.Word} {Wr : M0Crypto.Armv6M.Word → Prop}
  {s : M0Crypto.Armv6M.State} {stop : M0Crypto.Armv6M.Word} {P : M0Crypto.Armv6M.State → Prop},
  M0Crypto.Thumb.CodeAt s.mem base M0Crypto.Release.B →
    (∀ (y : M0Crypto.Armv6M.Word), Wr y → ∀ (i : Nat), i < M0Crypto.Release.B.length → y ≠ base + BitVec.ofNat 32 i) →
      (∀ (i : Nat), i < M0Crypto.Release.B.length → stop ≠ base + BitVec.ofNat 32 i) →
        (M0Crypto.Release.Reach base Wr s fun s' => s'.pc = stop ∧ P s') →
          ∃ n,
            ∀ (fuel : Nat),
              n ≤ fuel →
                ∃ s' tr,
                  M0Crypto.Thumb.runUntil stop fuel s = Except.ok (s', tr) ∧ P s' ∧ M0Crypto.Release.WritesTo Wr tr
M0Crypto.Release.ChaCha20Spec.chacha20_get : ∀ (key nonce msg : List M0Crypto.Spec.ChaCha20.Byte) (c i : Nat)
  (hi : i < msg.length),
  (M0Crypto.Spec.Aead.chacha20 key c nonce msg)[i]? =
    Option.some (msg[i] ^^^ (M0Crypto.Spec.ChaCha20.block key (BitVec.ofNat 32 (c + i / 64)) nonce)[i % 64])
M0Crypto.Release.ChaCha20Spec.block_get : ∀ (key nonce : List M0Crypto.Spec.ChaCha20.Byte)
  (c : M0Crypto.Spec.ChaCha20.Word) (j : Nat),
  j < 64 →
    (M0Crypto.Spec.ChaCha20.block key c nonce)[j]? =
      (M0Crypto.Spec.ChaCha20.bytesOfWord
          ((M0Crypto.Spec.ChaCha20.initState key c nonce)[j / 4]! +
            (M0Crypto.Spec.ChaCha20.innerBlocks 10 (M0Crypto.Spec.ChaCha20.initState key c nonce))[j / 4]!))[j % 4]?
M0Crypto.Release.ChaCha20Return.ret : ∀ (c : M0Crypto.Release.Frame.Ctx),
  M0Crypto.Release.Frame.Valid c →
    ∀ (Wr : M0Crypto.Armv6M.Word → Prop) (s : M0Crypto.Armv6M.State),
      s.pc = c.base + BitVec.ofNat 32 M0Crypto.Release.ChaCha20Layout.epiOff →
        s.regs 13 = c.fp →
          (∀ (i : Nat),
              i < 9 →
                M0Crypto.Armv6M.read32 s.mem
                    (M0Crypto.Armv6M.slot c.fp (M0Crypto.Release.ChaCha20Layout.slotSaved + i)) =
                  M0Crypto.Release.Frame.saved c.regs0 i) →
            BitVec.getLsbD (c.regs0 14) 0 = Bool.true →
              M0Crypto.Release.Reach c.base Wr s fun t =>
                t.pc = c.regs0 14 &&& ~~~1#32 ∧
                  t.regs 13 = c.sp0 ∧
                    (∀ (r : M0Crypto.Armv6M.Reg), 4 ≤ ↑r → ↑r < 12 → t.regs r = c.regs0 r) ∧
                      (∀ (r : M0Crypto.Armv6M.Reg), ↑r < 4 ∨ ↑r = 12 → t.regs r = s.regs r) ∧ t.mem = s.mem
M0Crypto.Release.ChaCha20Setup.checks : ∀ (c : M0Crypto.Release.Frame.Ctx),
  M0Crypto.Release.Frame.Valid c →
    ∀ (Wr : M0Crypto.Armv6M.Word → Prop),
      (∀ (o : Nat), o < M0Crypto.Release.ChaCha20Layout.chStackBytes → Wr (c.fp + BitVec.ofNat 32 o)) →
        ∀ (s : M0Crypto.Armv6M.State),
          M0Crypto.Release.ChaCha20Setup.Entry c s →
            ∀ (Q : M0Crypto.Armv6M.State → Prop),
              (∀ (t : M0Crypto.Armv6M.State),
                  t.pc = c.base + BitVec.ofNat 32 M0Crypto.Release.ChaCha20Layout.zOff →
                    t.regs 13 = c.fp → t.mem = c.mP → c.len = 0 → M0Crypto.Release.Reach c.base Wr t Q) →
                (∀ (t : M0Crypto.Armv6M.State),
                    t.pc = c.base + BitVec.ofNat 32 M0Crypto.Release.ChaCha20Layout.errOff →
                      t.regs 13 = c.fp →
                        t.mem = c.mP →
                          c.len ≠ 0 →
                            M0Crypto.Spec.Aead.counterOk (BitVec.toNat c.ctr) (BitVec.toNat c.len) = Bool.false →
                              M0Crypto.Release.Reach c.base Wr t Q) →
                  (∀ (t : M0Crypto.Armv6M.State),
                      M0Crypto.Release.ChaCha20Setup.Acc c t → M0Crypto.Release.Reach c.base Wr t Q) →
                    M0Crypto.Release.Reach c.base Wr s Q
M0Crypto.Release.ChaCha20Init.init : ∀ (c : M0Crypto.Release.Frame.Ctx),
  M0Crypto.Release.Frame.Valid c →
    ∀ (t : M0Crypto.Armv6M.State),
      M0Crypto.Release.ChaCha20Setup.Acc c t →
        ∀ (Q : M0Crypto.Armv6M.State → Prop),
          (∀ (t' : M0Crypto.Armv6M.State),
              M0Crypto.Release.Frame.BlockInv c 0 t' → M0Crypto.Release.Reach c.base c.Wr t' Q) →
            M0Crypto.Release.Reach c.base c.Wr t Q
M0Crypto.Release.ChaCha20Block.block_setup : ∀ (c : M0Crypto.Release.Frame.Ctx),
  M0Crypto.Release.Frame.Valid c →
    ∀ (k : Nat) (t : M0Crypto.Armv6M.State),
      M0Crypto.Release.Frame.BlockInv c k t →
        ∀ (Q : M0Crypto.Armv6M.State → Prop),
          (∀ (u : M0Crypto.Armv6M.State),
              u.pc = c.base + BitVec.ofNat 32 M0Crypto.Release.ChaCha20Layout.droundOff →
                M0Crypto.Release.ChaCha20Round.RotRegs u →
                  u.regs 13 = c.fp →
                    u.regs 12 = 10#32 →
                      M0Crypto.Release.ChaCha20Round.view (Option.some 2) u = c.J k →
                        (∀ (j : Nat), 12 ≤ j → j < 64 → c.fw u j = c.fw t j) →
                          c.MemOk (64 * k) u.mem → M0Crypto.Release.Reach c.base c.Wr u Q) →
            M0Crypto.Release.Reach c.base c.Wr t Q
M0Crypto.Release.ChaCha20Block.block_keystream : ∀ (c : M0Crypto.Release.Frame.Ctx) (k j : Nat),
  j < 64 →
    (M0Crypto.Spec.ChaCha20.block c.keyB (c.ctr + BitVec.ofNat 32 k) c.nonceB)[j]? =
      (M0Crypto.Spec.ChaCha20.bytesOfWord (M0Crypto.Release.ChaCha20Block.ks c k (j / 4)))[j % 4]?
M0Crypto.Release.ChaCha20Block.block_rounds : ∀ (c : M0Crypto.Release.Frame.Ctx),
  M0Crypto.Release.Frame.Valid c →
    ∀ (k : Nat) (t : M0Crypto.Armv6M.State),
      M0Crypto.Release.Frame.BlockInv c k t →
        ∀ (Q : M0Crypto.Armv6M.State → Prop),
          (∀ (v : M0Crypto.Armv6M.State),
              v.pc = c.base + BitVec.ofNat 32 M0Crypto.Release.ChaCha20Layout.postOff →
                v.regs 13 = c.fp →
                  M0Crypto.Release.ChaCha20Round.view (Option.some 2) v =
                      M0Crypto.Release.ChaCha20Loop.iter M0Crypto.Proofs.ChaCha20DoubleRound.innerBlockF 10 (c.J k) →
                    (∀ (j : Nat), 12 ≤ j → j < 64 → c.fw v j = c.fw t j) →
                      c.MemOk (64 * k) v.mem → M0Crypto.Release.Reach c.base c.Wr v Q) →
            M0Crypto.Release.Reach c.base c.Wr t Q
M0Crypto.Release.ChaCha20Output.output_byte_eq : ∀ (c : M0Crypto.Release.Frame.Ctx) (n : Nat),
  n < BitVec.toNat c.len →
    c.outB n = c.m0 (c.inp + BitVec.ofNat 32 n) ^^^ M0Crypto.Release.ChaCha20Output.kb c (n / 64) (n % 64)
M0Crypto.Release.ChaCha20Output.block_post : ∀ (c : M0Crypto.Release.Frame.Ctx),
  M0Crypto.Release.Frame.Valid c →
    ∀ (k : Nat) (t : M0Crypto.Armv6M.State),
      M0Crypto.Release.Frame.BlockInv c k t →
        ∀ (Q : M0Crypto.Armv6M.State → Prop),
          (∀ (u : M0Crypto.Armv6M.State),
              M0Crypto.Release.ChaCha20Output.Post c k u → M0Crypto.Release.Reach c.base c.Wr u Q) →
            M0Crypto.Release.Reach c.base c.Wr t Q
M0Crypto.Release.ChaCha20Output.block_output : ∀ (c : M0Crypto.Release.Frame.Ctx),
  M0Crypto.Release.Frame.Valid c →
    ∀ (k : Nat) (t : M0Crypto.Armv6M.State),
      M0Crypto.Release.ChaCha20Output.Post c k t →
        ∀ (Q : M0Crypto.Armv6M.State → Prop),
          (∀ (u : M0Crypto.Armv6M.State),
              M0Crypto.Release.ChaCha20Output.Out c k u → M0Crypto.Release.Reach c.base c.Wr u Q) →
            M0Crypto.Release.Reach c.base c.Wr t Q
M0Crypto.Release.ChaCha20Xor.loop_next : ∀ (c : M0Crypto.Release.Frame.Ctx),
  M0Crypto.Release.Frame.Valid c →
    ∀ (k : Nat) (t : M0Crypto.Armv6M.State),
      M0Crypto.Release.ChaCha20Output.Out c k t →
        ∀ (Q : M0Crypto.Armv6M.State → Prop),
          (∀ (u : M0Crypto.Armv6M.State),
              u.pc = c.base + BitVec.ofNat 32 M0Crypto.Release.ChaCha20Layout.clrOff →
                u.regs 13 = c.fp → c.MemOk (BitVec.toNat c.len) u.mem → M0Crypto.Release.Reach c.base c.Wr u Q) →
            (∀ (u : M0Crypto.Armv6M.State),
                M0Crypto.Release.Frame.BlockInv c (k + 1) u → M0Crypto.Release.Reach c.base c.Wr u Q) →
              M0Crypto.Release.Reach c.base c.Wr t Q
M0Crypto.Release.ChaCha20Xor.blocks : ∀ (c : M0Crypto.Release.Frame.Ctx),
  M0Crypto.Release.Frame.Valid c →
    ∀ (Q : M0Crypto.Armv6M.State → Prop),
      (∀ (u : M0Crypto.Armv6M.State),
          u.pc = c.base + BitVec.ofNat 32 M0Crypto.Release.ChaCha20Layout.clrOff →
            u.regs 13 = c.fp → c.MemOk (BitVec.toNat c.len) u.mem → M0Crypto.Release.Reach c.base c.Wr u Q) →
        ∀ (m k : Nat) (t : M0Crypto.Armv6M.State),
          BitVec.toNat c.len ≤ 64 * (k + m) →
            M0Crypto.Release.Frame.BlockInv c k t → M0Crypto.Release.Reach c.base c.Wr t Q
M0Crypto.Release.ChaCha20Xor.xor_reach : ∀ (c : M0Crypto.Release.Frame.Ctx),
  M0Crypto.Release.Frame.Valid c →
    ∀ (s : M0Crypto.Armv6M.State),
      M0Crypto.Release.ChaCha20Setup.Entry c s →
        BitVec.getLsbD (c.regs0 14) 0 = Bool.true →
          M0Crypto.Release.Reach c.base (M0Crypto.Release.ChaCha20Xor.WrOk c) s fun u =>
            u.pc = c.regs0 14 &&& ~~~1#32 ∧ M0Crypto.Release.ChaCha20Xor.Result c u
M0Crypto.Release.ChaCha20Xor.xor_correct : ∀ (c : M0Crypto.Release.Frame.Ctx) (s : M0Crypto.Armv6M.State),
  M0Crypto.Release.ChaCha20Xor.Pre c s →
    ∃ n,
      ∀ (fuel : Nat),
        n ≤ fuel →
          ∃ s' tr,
            M0Crypto.Thumb.runUntil c.ret fuel s = Except.ok (s', tr) ∧
              M0Crypto.Release.ChaCha20Xor.Result c s' ∧
                M0Crypto.Release.WritesTo (M0Crypto.Release.ChaCha20Xor.WrOk c) tr
M0Crypto.Release.ChaCha20Xor.result_output : ∀ (c : M0Crypto.Release.Frame.Ctx),
  M0Crypto.Release.Frame.Valid c →
    ∀ {t : M0Crypto.Armv6M.State},
      M0Crypto.Release.ChaCha20Xor.Result c t →
        M0Crypto.Spec.Aead.counterOk (BitVec.toNat c.ctr) (BitVec.toNat c.len) = Bool.true →
          M0Crypto.Release.Frame.Ctx.bytesAt t.mem c.out (BitVec.toNat c.len) =
            M0Crypto.Spec.Aead.chacha20 c.keyB (BitVec.toNat c.ctr) c.nonceB c.msg
M0Crypto.Release.Poly1305Arith.mul_fold : ∀ (h0 h1 h2 h3 h4 r0 q1 q2 q3 : Nat),
  M0Crypto.Release.Poly1305Arith.val5 h0 h1 h2 h3 h4 *
        M0Crypto.Release.Poly1305Arith.val4 r0 (4 * q1) (4 * q2) (4 * q3) +
      5 *
        (h1 * q3 + h2 * q2 + h3 * q1 + (h2 * q3 + h3 * q2 + h4 * q1) * 2 ^ 32 + (h3 * q3 + h4 * q2) * 2 ^ 64 +
          h4 * q3 * 2 ^ 96) =
    h0 * r0 + h1 * (5 * q3) + h2 * (5 * q2) + h3 * (5 * q1) +
              2 ^ 32 * (h0 * (4 * q1) + h1 * r0 + h2 * (5 * q3) + h3 * (5 * q2) + h4 * (5 * q1)) +
            2 ^ 64 * (h0 * (4 * q2) + h1 * (4 * q1) + h2 * r0 + h3 * (5 * q3) + h4 * (5 * q2)) +
          2 ^ 96 * (h0 * (4 * q3) + h1 * (4 * q2) + h2 * (4 * q1) + h3 * r0 + h4 * (5 * q3)) +
        2 ^ 128 * (h4 * r0) +
      2 ^ 130 *
        (h1 * q3 + h2 * q2 + h3 * q1 + (h2 * q3 + h3 * q2 + h4 * q1) * 2 ^ 32 + (h3 * q3 + h4 * q2) * 2 ^ 64 +
          h4 * q3 * 2 ^ 96)
M0Crypto.Release.Poly1305Arith.carry_fold : ∀
  (P00 P10 P20 P30 P40 P01 P02 P03 P11 P12 P21 S13 S22 S31 S23 S32 S33 S41 S42 S43 e0 e1 e2 e3 g c o K HR : Nat),
  P00 ≤ (2 ^ 32 - 1) * (2 ^ 28 - 1) →
    P10 ≤ (2 ^ 32 - 1) * (2 ^ 28 - 1) →
      P20 ≤ (2 ^ 32 - 1) * (2 ^ 28 - 1) →
        P30 ≤ (2 ^ 32 - 1) * (2 ^ 28 - 1) →
          P40 ≤ 6 * (2 ^ 28 - 1) →
            P01 ≤ (2 ^ 32 - 1) * (2 ^ 28 - 1) →
              P02 ≤ (2 ^ 32 - 1) * (2 ^ 28 - 1) →
                P03 ≤ (2 ^ 32 - 1) * (2 ^ 28 - 1) →
                  P11 ≤ (2 ^ 32 - 1) * (2 ^ 28 - 1) →
                    P12 ≤ (2 ^ 32 - 1) * (2 ^ 28 - 1) →
                      P21 ≤ (2 ^ 32 - 1) * (2 ^ 28 - 1) →
                        S13 ≤ (2 ^ 32 - 1) * (5 * 2 ^ 26) →
                          S22 ≤ (2 ^ 32 - 1) * (5 * 2 ^ 26) →
                            S31 ≤ (2 ^ 32 - 1) * (5 * 2 ^ 26) →
                              S23 ≤ (2 ^ 32 - 1) * (5 * 2 ^ 26) →
                                S32 ≤ (2 ^ 32 - 1) * (5 * 2 ^ 26) →
                                  S33 ≤ (2 ^ 32 - 1) * (5 * 2 ^ 26) →
                                    S41 ≤ 6 * (5 * 2 ^ 26) →
                                      S42 ≤ 6 * (5 * 2 ^ 26) →
                                        S43 ≤ 6 * (5 * 2 ^ 26) →
                                          e0 = ((((0 + P00) % 2 ^ 64 + S13) % 2 ^ 64 + S22) % 2 ^ 64 + S31) % 2 ^ 64 →
                                            e1 =
                                                (((((e0 / 2 ^ 32 + P01) % 2 ^ 64 + P10) % 2 ^ 64 + S23) % 2 ^ 64 +
                                                        S32) %
                                                      2 ^ 64 +
                                                    S41 % 2 ^ 32) %
                                                  2 ^ 64 →
                                              e2 =
                                                  (((((e1 / 2 ^ 32 + P02) % 2 ^ 64 + P11) % 2 ^ 64 + P20) % 2 ^ 64 +
                                                          S33) %
                                                        2 ^ 64 +
                                                      S42 % 2 ^ 32) %
                                                    2 ^ 64 →
                                                e3 =
                                                    (((((e2 / 2 ^ 32 + P03) % 2 ^ 64 + P12) % 2 ^ 64 + P21) % 2 ^ 64 +
                                                            P30) %
                                                          2 ^ 64 +
                                                        S43 % 2 ^ 32) %
                                                      2 ^ 64 →
                                                  g = (e3 / 2 ^ 32 + P40 % 2 ^ 32) % 2 ^ 32 →
                                                    c = (g / 4 + (g - g % 4)) % 2 ^ 32 →
                                                      o =
                                                          (e0 % 2 ^ 32 + 2 ^ 32 * (e1 % 2 ^ 32) +
                                                                    2 ^ 64 * (e2 % 2 ^ 32) +
                                                                  2 ^ 96 * (e3 % 2 ^ 32) +
                                                                2 ^ 128 * (g % 4) +
                                                              c) %
                                                            2 ^ 160 →
                                                        HR + 5 * K =
                                                            P00 + S13 + S22 + S31 +
                                                                      2 ^ 32 * (P01 + P10 + S23 + S32 + S41) +
                                                                    2 ^ 64 * (P02 + P11 + P20 + S33 + S42) +
                                                                  2 ^ 96 * (P03 + P12 + P21 + P30 + S43) +
                                                                2 ^ 128 * P40 +
                                                              2 ^ 130 * K →
                                                          HR = o + M0Crypto.Spec.Aead.p * (K + g / 4) ∧ o < 5 * 2 ^ 128
M0Crypto.Release.Poly1305Arith.block_arith : ∀
  (h0 h1 h2 h3 h4 m0 m1 m2 m3 pad r0 r1 r2 r3 s1 s2 s3 H0 H1 H2 H3 H4 e0 e1 e2 e3 g c o : Nat),
  h0 < 2 ^ 32 ∧ h1 < 2 ^ 32 ∧ h2 < 2 ^ 32 ∧ h3 < 2 ^ 32 ∧ h4 ≤ 4 →
    m0 < 2 ^ 32 ∧ m1 < 2 ^ 32 ∧ m2 < 2 ^ 32 ∧ m3 < 2 ^ 32 →
      pad ≤ 1 →
        r0 < 2 ^ 28 ∧ r1 < 2 ^ 28 ∧ r2 < 2 ^ 28 ∧ r3 < 2 ^ 28 →
          r1 % 4 = 0 ∧ r2 % 4 = 0 ∧ r3 % 4 = 0 →
            s1 = r1 + r1 / 4 ∧ s2 = r2 + r2 / 4 ∧ s3 = r3 + r3 / 4 →
              H0 < 2 ^ 32 ∧ H1 < 2 ^ 32 ∧ H2 < 2 ^ 32 ∧ H3 < 2 ^ 32 ∧ H4 < 2 ^ 32 →
                M0Crypto.Release.Poly1305Arith.val5 H0 H1 H2 H3 H4 =
                    (M0Crypto.Release.Poly1305Arith.val5 h0 h1 h2 h3 h4 +
                          M0Crypto.Release.Poly1305Arith.val4 m0 m1 m2 m3 +
                        2 ^ 128 * pad) %
                      2 ^ 160 →
                  e0 = ((((0 + H0 * r0) % 2 ^ 64 + H1 * s3) % 2 ^ 64 + H2 * s2) % 2 ^ 64 + H3 * s1) % 2 ^ 64 →
                    e1 =
                        (((((e0 / 2 ^ 32 + H0 * r1) % 2 ^ 64 + H1 * r0) % 2 ^ 64 + H2 * s3) % 2 ^ 64 + H3 * s2) %
                              2 ^ 64 +
                            H4 * s1 % 2 ^ 32) %
                          2 ^ 64 →
                      e2 =
                          (((((e1 / 2 ^ 32 + H0 * r2) % 2 ^ 64 + H1 * r1) % 2 ^ 64 + H2 * r0) % 2 ^ 64 + H3 * s3) %
                                2 ^ 64 +
                              H4 * s2 % 2 ^ 32) %
                            2 ^ 64 →
                        e3 =
                            (((((e2 / 2 ^ 32 + H0 * r3) % 2 ^ 64 + H1 * r2) % 2 ^ 64 + H2 * r1) % 2 ^ 64 + H3 * r0) %
                                  2 ^ 64 +
                                H4 * s3 % 2 ^ 32) %
                              2 ^ 64 →
                          g = (e3 / 2 ^ 32 + H4 * r0 % 2 ^ 32) % 2 ^ 32 →
                            c = (g / 4 + (g - g % 4)) % 2 ^ 32 →
                              o =
                                  (M0Crypto.Release.Poly1305Arith.val4 (e0 % 2 ^ 32) (e1 % 2 ^ 32) (e2 % 2 ^ 32)
                                          (e3 % 2 ^ 32) +
                                        2 ^ 128 * (g % 4) +
                                      c) %
                                    2 ^ 160 →
                                o % M0Crypto.Spec.Aead.p =
                                    (M0Crypto.Release.Poly1305Arith.val5 h0 h1 h2 h3 h4 +
                                            M0Crypto.Release.Poly1305Arith.val4 m0 m1 m2 m3 +
                                          2 ^ 128 * pad) *
                                        M0Crypto.Release.Poly1305Arith.val4 r0 r1 r2 r3 %
                                      M0Crypto.Spec.Aead.p ∧
                                  o < 5 * 2 ^ 128
M0Crypto.Release.Poly1305Spec.polyBlocks_append : ∀ (r pad acc n : Nat) (a b : List M0Crypto.Spec.ChaCha20.Byte),
  a.length = 16 * n →
    M0Crypto.Release.Poly1305Spec.polyBlocks r pad acc (a ++ b) =
      M0Crypto.Release.Poly1305Spec.polyBlocks r pad (M0Crypto.Release.Poly1305Spec.polyBlocks r pad acc a) b
M0Crypto.Release.Poly1305Spec.polyAcc_eq : ∀ (r : Nat) (msg : List M0Crypto.Spec.ChaCha20.Byte),
  msg.length % 16 = 0 → M0Crypto.Spec.Aead.polyAcc r msg = M0Crypto.Release.Poly1305Spec.polyBlocks r 1 0 msg
M0Crypto.Release.Poly1305Spec.step_mod : ∀ (r pad acc : Nat) (blk : List M0Crypto.Spec.ChaCha20.Byte),
  M0Crypto.Release.Poly1305Spec.step r pad (acc % M0Crypto.Spec.Aead.p) blk =
    M0Crypto.Release.Poly1305Spec.step r pad acc blk
M0Crypto.Release.Poly1305Spec.leNat_bytesAt16 : ∀ (m : M0Crypto.Armv6M.Mem) (a : M0Crypto.Armv6M.Word),
  M0Crypto.Spec.Aead.leNat (M0Crypto.Release.Frame.Ctx.bytesAt m a 16) =
    M0Crypto.Release.Poly1305Arith.val4 (BitVec.toNat (M0Crypto.Armv6M.read32 m a))
      (BitVec.toNat (M0Crypto.Armv6M.read32 m (a + 4#32))) (BitVec.toNat (M0Crypto.Armv6M.read32 m (a + 8#32)))
      (BitVec.toNat (M0Crypto.Armv6M.read32 m (a + 12#32)))
M0Crypto.Release.Poly1305Spec.clamp_words : ∀ (k0 k1 k2 k3 : Nat),
  k0 < 2 ^ 32 →
    k1 < 2 ^ 32 →
      k2 < 2 ^ 32 →
        M0Crypto.Spec.Aead.clamp (M0Crypto.Release.Poly1305Arith.val4 k0 k1 k2 k3) =
          M0Crypto.Release.Poly1305Arith.val4 (k0 &&& 268435455) (k1 &&& 268435452) (k2 &&& 268435452)
            (k3 &&& 268435452)
M0Crypto.Release.Poly1305Spec.tag_byte : ∀ (w0 w1 w2 w3 t j k : Nat),
  w0 < 2 ^ 32 →
    w1 < 2 ^ 32 →
      w2 < 2 ^ 32 →
        j < 4 →
          k < 4 →
            BitVec.ofNat 8 ((M0Crypto.Release.Poly1305Arith.val4 w0 w1 w2 w3 + 2 ^ 128 * t) / 256 ^ (4 * j + k)) =
              BitVec.ofNat 8 ((if j = 0 then w0 else if j = 1 then w1 else if j = 2 then w2 else w3) / 256 ^ k)
M0Crypto.Release.Poly1305Spec.tag_reduce : ∀ (h s : Nat),
  h < 2 * M0Crypto.Spec.Aead.p → (h % M0Crypto.Spec.Aead.p + s) % 2 ^ 128 = (h + 5 * ((h + 5) / 2 ^ 130) + s) % 2 ^ 128
M0Crypto.Release.Poly1305Init.init_reach : ∀ (c : M0Crypto.Release.Poly1305Init.ICtx),
  M0Crypto.Release.Poly1305Init.IValid c →
    ∀ {Wr : M0Crypto.Armv6M.Word → Prop},
      (∀ (y : M0Crypto.Armv6M.Word), M0Crypto.Release.Poly1305Init.IWr c y → Wr y) →
        ∀ (s : M0Crypto.Armv6M.State),
          M0Crypto.Release.Poly1305Init.IEntry c s →
            BitVec.getLsbD (c.regs0 14) 0 = Bool.true →
              M0Crypto.Release.Reach c.base Wr s (M0Crypto.Release.Poly1305Init.IResult c)
M0Crypto.Release.Poly1305Init.init_correct : ∀ (c : M0Crypto.Release.Poly1305Init.ICtx),
  M0Crypto.Release.Poly1305Init.IValid c →
    ∀ (s : M0Crypto.Armv6M.State),
      M0Crypto.Release.Poly1305Init.IEntry c s →
        BitVec.getLsbD (c.regs0 14) 0 = Bool.true →
          (∀ (i : Nat), i < M0Crypto.Artifacts.Release.size → c.regs0 14 &&& ~~~1#32 ≠ c.base + BitVec.ofNat 32 i) →
            ∃ n,
              ∀ (fuel : Nat),
                n ≤ fuel →
                  ∃ s' tr,
                    M0Crypto.Thumb.runUntil (c.regs0 14 &&& ~~~1#32) fuel s = Except.ok (s', tr) ∧
                      M0Crypto.Release.Poly1305Init.IResult c s' ∧
                        M0Crypto.Release.WritesTo (M0Crypto.Release.Poly1305Init.IWr c) tr
@M0Crypto.Release.Poly1305Mac.mac_run : ∀ {base ctx : M0Crypto.Armv6M.Word},
  BitVec.toNat base % 4 = 0 →
    BitVec.toNat ctx % 4 = 0 →
      ∀ {Wr : M0Crypto.Armv6M.Word → Prop} {t : M0Crypto.Armv6M.State} {off : Nat} {h : M0Crypto.Armv6M.Reg} {w : Nat},
        w < 15 →
          M0Crypto.Thumb.seqAt M0Crypto.Release.B off (M0Crypto.Release.Poly1305Mac.mac h (2 * w)) = Bool.true →
            off % 2 = 0 →
              t.pc = base + BitVec.ofNat 32 off →
                t.regs 7 = ctx →
                  ∀ {Q : M0Crypto.Armv6M.State → Prop},
                    (∀ (t' : M0Crypto.Armv6M.State),
                        t'.pc = base + BitVec.ofNat 32 (off + 40) →
                          t'.mem = t.mem →
                            (∀ (r : M0Crypto.Armv6M.Reg), 7 ≤ ↑r → ↑r ≠ 15 → t'.regs r = t.regs r) →
                              M0Crypto.Release.Poly1305Mac.v64 t' =
                                  (M0Crypto.Release.Poly1305Mac.v64 t +
                                      BitVec.toNat (t.regs h) *
                                        BitVec.toNat (M0Crypto.Armv6M.read32 t.mem (ctx + BitVec.ofNat 32 (4 * w)))) %
                                    2 ^ 64 →
                                M0Crypto.Release.Reach base Wr t' Q) →
                      M0Crypto.Release.Reach base Wr t Q
@M0Crypto.Release.Poly1305Mac.narrow_run : ∀ {base ctx : M0Crypto.Armv6M.Word},
  BitVec.toNat base % 4 = 0 →
    BitVec.toNat ctx % 4 = 0 →
      ∀ {Wr : M0Crypto.Armv6M.Word → Prop} {t : M0Crypto.Armv6M.State} {off j : Nat},
        j < 16 →
          M0Crypto.Thumb.seqAt M0Crypto.Release.B off (M0Crypto.Release.Poly1305Mac.narrow j) = Bool.true →
            off % 2 = 0 →
              t.pc = base + BitVec.ofNat 32 off →
                t.regs 7 = ctx →
                  ∀ {Q : M0Crypto.Armv6M.State → Prop},
                    (∀ (t' : M0Crypto.Armv6M.State),
                        t'.pc = base + BitVec.ofNat 32 (off + 12) →
                          t'.mem = t.mem →
                            (∀ (r : M0Crypto.Armv6M.Reg), 7 ≤ ↑r → ↑r ≠ 15 → t'.regs r = t.regs r) →
                              M0Crypto.Release.Poly1305Mac.v64 t' =
                                  (M0Crypto.Release.Poly1305Mac.v64 t +
                                      BitVec.toNat (t.regs 14) *
                                          BitVec.toNat (M0Crypto.Armv6M.read32 t.mem (ctx + BitVec.ofNat 32 (4 * j))) %
                                        2 ^ 32) %
                                    2 ^ 64 →
                                M0Crypto.Release.Reach base Wr t' Q) →
                      M0Crypto.Release.Reach base Wr t Q
@M0Crypto.Release.Poly1305Mac.colend_run : ∀ {base : M0Crypto.Armv6M.Word},
  BitVec.toNat base % 4 = 0 →
    ∀ {Wr : M0Crypto.Armv6M.Word → Prop} {t : M0Crypto.Armv6M.State} {off j : Nat},
      j < M0Crypto.Release.Poly1305Blocks.frameWords →
        M0Crypto.Thumb.seqAt M0Crypto.Release.B off (M0Crypto.Release.Poly1305Mac.colend j) = Bool.true →
          off % 2 = 0 →
            t.pc = base + BitVec.ofNat 32 off →
              BitVec.toNat (t.regs 13) % 4 = 0 →
                (∀ (o : Nat), o < M0Crypto.Release.Poly1305Blocks.frameBytes → Wr (t.regs 13 + BitVec.ofNat 32 o)) →
                  ∀ {Q : M0Crypto.Armv6M.State → Prop},
                    (∀ (t' : M0Crypto.Armv6M.State),
                        t'.pc = base + BitVec.ofNat 32 (off + 6) →
                          t'.mem = M0Crypto.Armv6M.write32 t.mem (M0Crypto.Armv6M.slot (t.regs 13) j) (t.regs 0) →
                            (∀ (r : M0Crypto.Armv6M.Reg), 2 ≤ ↑r → ↑r ≠ 15 → t'.regs r = t.regs r) →
                              M0Crypto.Release.Poly1305Mac.v64 t' = M0Crypto.Release.Poly1305Mac.v64 t / 2 ^ 32 →
                                M0Crypto.Release.Reach base Wr t' Q) →
                      M0Crypto.Release.Reach base Wr t Q
M0Crypto.Release.Poly1305Blocks.segments_at : M0Crypto.Thumb.seqAt M0Crypto.Release.B
      M0Crypto.Release.Poly1305Blocks.testAt M0Crypto.Release.Poly1305Blocks.testAlign =
    Bool.true ∧
  M0Crypto.Thumb.seqAt M0Crypto.Release.B M0Crypto.Release.Poly1305Blocks.loadAAt
        M0Crypto.Release.Poly1305Blocks.loadA =
      Bool.true ∧
    M0Crypto.Thumb.seqAt M0Crypto.Release.B M0Crypto.Release.Poly1305Blocks.loadUAt
          M0Crypto.Release.Poly1305Blocks.loadU =
        Bool.true ∧
      M0Crypto.Thumb.seqAt M0Crypto.Release.B M0Crypto.Release.Poly1305Blocks.bodyAt
            M0Crypto.Release.Poly1305Blocks.body =
          Bool.true ∧
        M0Crypto.Thumb.seqAt M0Crypto.Release.B M0Crypto.Release.Poly1305Blocks.decAt
              M0Crypto.Release.Poly1305Blocks.dec =
            Bool.true ∧
          M0Crypto.Thumb.seqAt M0Crypto.Release.B M0Crypto.Release.Poly1305Blocks.publishAt
              M0Crypto.Release.Poly1305Blocks.publish =
            Bool.true
M0Crypto.Release.Poly1305Blocks.prologue_at : M0Crypto.Thumb.seqAt M0Crypto.Release.B
    M0Crypto.Release.Poly1305Blocks.entryAt M0Crypto.Release.Poly1305Blocks.prologue =
  Bool.true
M0Crypto.Release.Poly1305Blocks.setup_at : M0Crypto.Thumb.seqAt M0Crypto.Release.B
    M0Crypto.Release.Poly1305Blocks.setupAt M0Crypto.Release.Poly1305Blocks.setup =
  Bool.true
M0Crypto.Release.Poly1305Blocks.epilogue_at : M0Crypto.Thumb.seqAt M0Crypto.Release.B
    M0Crypto.Release.Poly1305Blocks.epilogueAt M0Crypto.Release.Poly1305Blocks.epilogue =
  Bool.true
M0Crypto.Release.Poly1305Blocks.load_words : ∀ (s : M0Crypto.Armv6M.State) (j : Nat) (hj : j < 4),
  (M0Crypto.Release.Poly1305Blocks.loadState s).regs
      ⟨j, Decidable.byContradiction fun a => M0Crypto.Release.Poly1305Blocks.loadU_words._proof_1 j hj a⟩ =
    M0Crypto.Armv6M.read32 s.mem
      (M0Crypto.Armv6M.slot
        (M0Crypto.Armv6M.read32 s.mem (M0Crypto.Armv6M.slot (s.regs 13) M0Crypto.Release.Poly1305Blocks.slotMsg)) j)
M0Crypto.Release.Poly1305Blocks.mac4_v : ∀ (s : M0Crypto.Armv6M.State) (a b c d : Nat),
  a < 15 →
    b < 15 →
      c < 15 →
        d < 15 →
          M0Crypto.Release.Poly1305Mac.v64 (M0Crypto.Thumb.execAll (M0Crypto.Release.Poly1305Blocks.mac4 a b c d) s) =
            ((((M0Crypto.Release.Poly1305Mac.v64 s + BitVec.toNat (s.regs 8) * M0Crypto.Release.Poly1305Blocks.cw s a) %
                          2 ^ 64 +
                        BitVec.toNat (s.regs 9) * M0Crypto.Release.Poly1305Blocks.cw s b) %
                      2 ^ 64 +
                    BitVec.toNat (s.regs 10) * M0Crypto.Release.Poly1305Blocks.cw s c) %
                  2 ^ 64 +
                BitVec.toNat (s.regs 11) * M0Crypto.Release.Poly1305Blocks.cw s d) %
              2 ^ 64
@M0Crypto.Release.Poly1305Blocks.body_run : ∀ {base : M0Crypto.Armv6M.Word},
  BitVec.toNat base % 4 = 0 →
    ∀ {Wr : M0Crypto.Armv6M.Word → Prop} (s : M0Crypto.Armv6M.State),
      s.pc = base + BitVec.ofNat 32 M0Crypto.Release.Poly1305Blocks.bodyAt →
        BitVec.toNat (s.regs 13) % 4 = 0 →
          BitVec.toNat (s.regs 7) % 4 = 0 →
            (∀ (o : Nat), o < M0Crypto.Release.Poly1305Blocks.bodyBytes → Wr (s.regs 13 + BitVec.ofNat 32 o)) →
              M0Crypto.Release.Reach base Wr s fun t =>
                t = M0Crypto.Thumb.execAll M0Crypto.Release.Poly1305Blocks.body s
@M0Crypto.Release.Poly1305Blocks.one_run : ∀ {base : M0Crypto.Armv6M.Word},
  BitVec.toNat base % 4 = 0 →
    ∀ {Wr : M0Crypto.Armv6M.Word → Prop} (s : M0Crypto.Armv6M.State),
      s.pc = base + BitVec.ofNat 32 M0Crypto.Release.Poly1305Blocks.testAt →
        BitVec.toNat (s.regs 13) % 4 = 0 →
          BitVec.toNat (s.regs 7) % 4 = 0 →
            (∀ (o : Nat), o < M0Crypto.Release.Poly1305Blocks.belowPadBytes → Wr (s.regs 13 + BitVec.ofNat 32 o)) →
              M0Crypto.Release.Reach base Wr s fun t => t = M0Crypto.Release.Poly1305Blocks.oneBlock s
@M0Crypto.Release.Poly1305Blocks.loop_run : ∀ {base : M0Crypto.Armv6M.Word},
  BitVec.toNat base % 4 = 0 →
    ∀ {Wr : M0Crypto.Armv6M.Word → Prop} (n : Nat),
      0 < n →
        n < 2 ^ 32 →
          ∀ (s : M0Crypto.Armv6M.State),
            s.pc = base + BitVec.ofNat 32 M0Crypto.Release.Poly1305Blocks.testAt →
              BitVec.toNat (s.regs 13) % 4 = 0 →
                BitVec.toNat (s.regs 7) % 4 = 0 →
                  M0Crypto.Armv6M.read32 s.mem
                        (M0Crypto.Armv6M.slot (s.regs 13) M0Crypto.Release.Poly1305Blocks.slotCount) =
                      BitVec.ofNat 32 n →
                    (∀ (o : Nat),
                        o < M0Crypto.Release.Poly1305Blocks.belowPadBytes → Wr (s.regs 13 + BitVec.ofNat 32 o)) →
                      M0Crypto.Release.Reach base Wr s fun t =>
                        t = M0Crypto.Release.Poly1305Blocks.loopState base n s ∧
                          t.pc = base + BitVec.ofNat 32 M0Crypto.Release.Poly1305Blocks.publishAt ∧
                            t.regs 7 = s.regs 7 ∧
                              t.regs 12 = s.regs 12 ∧
                                t.regs 13 = s.regs 13 ∧
                                  M0Crypto.Armv6M.read32 t.mem
                                      (M0Crypto.Armv6M.slot (s.regs 13) M0Crypto.Release.Poly1305Blocks.slotCount) =
                                    0#32
M0Crypto.Release.Poly1305Blocks.loop_mem : ∀ (base : M0Crypto.Armv6M.Word) (n : Nat) (s : M0Crypto.Armv6M.State)
  (y : M0Crypto.Armv6M.Word),
  ¬M0Crypto.Release.Frame.InFrame (s.regs 13) M0Crypto.Release.Poly1305Blocks.slotPad y →
    (M0Crypto.Release.Poly1305Blocks.loopState base n s).mem y = s.mem y
M0Crypto.Release.Poly1305Blocks.blocks_ret : ∀ (c : M0Crypto.Release.Poly1305Blocks.BCtx),
  M0Crypto.Release.Poly1305Blocks.BValid c →
    ∀ (Wr : M0Crypto.Armv6M.Word → Prop) (s : M0Crypto.Armv6M.State),
      s.pc = c.base + BitVec.ofNat 32 M0Crypto.Release.Poly1305Blocks.epilogueAt →
        s.regs 13 = c.fp →
          (∀ (i : Nat),
              i < 9 →
                M0Crypto.Armv6M.read32 s.mem (M0Crypto.Armv6M.slot c.fp (7 + i)) =
                  M0Crypto.Release.Frame.saved c.regs0 i) →
            BitVec.getLsbD (c.regs0 14) 0 = Bool.true →
              M0Crypto.Release.Reach c.base Wr s fun t =>
                t.pc = c.regs0 14 &&& ~~~1#32 ∧
                  t.regs 13 = c.sp0 ∧
                    (∀ (r : M0Crypto.Armv6M.Reg), 4 ≤ ↑r → ↑r < 12 → t.regs r = c.regs0 r) ∧
                      (∀ (r : M0Crypto.Armv6M.Reg), ↑r < 4 ∨ ↑r = 12 ∨ ↑r = 14 → t.regs r = s.regs r) ∧ t.mem = s.mem
M0Crypto.Release.Poly1305Blocks.publish_effect : ∀ (s : M0Crypto.Armv6M.State),
  (M0Crypto.Thumb.execAll M0Crypto.Release.Poly1305Blocks.publish s).mem =
      M0Crypto.Release.Poly1305Blocks.publishMem s ∧
    (∀ (r : M0Crypto.Armv6M.Reg),
        ↑r < 4 ∨ ↑r = 12 ∨ ↑r = 14 → (M0Crypto.Thumb.execAll M0Crypto.Release.Poly1305Blocks.publish s).regs r = 0#32) ∧
      (M0Crypto.Thumb.execAll M0Crypto.Release.Poly1305Blocks.publish s).regs 13 = s.regs 13
M0Crypto.Release.Poly1305Blocks.blocks_reach : ∀ (c : M0Crypto.Release.Poly1305Blocks.BCtx),
  M0Crypto.Release.Poly1305Blocks.BValid c →
    ∀ (s : M0Crypto.Armv6M.State),
      M0Crypto.Release.Poly1305Blocks.BEntry c s →
        BitVec.getLsbD (c.regs0 14) 0 = Bool.true →
          M0Crypto.Release.Reach c.base c.Wr s (M0Crypto.Release.Poly1305Blocks.BResult c s)
M0Crypto.Release.Poly1305Blocks.blocks_execution : ∀ (c : M0Crypto.Release.Poly1305Blocks.BCtx),
  M0Crypto.Release.Poly1305Blocks.BValid c →
    ∀ (s : M0Crypto.Armv6M.State),
      M0Crypto.Release.Poly1305Blocks.BEntry c s →
        BitVec.getLsbD (c.regs0 14) 0 = Bool.true →
          (∀ (i : Nat), i < M0Crypto.Artifacts.Release.size → c.regs0 14 &&& ~~~1#32 ≠ c.base + BitVec.ofNat 32 i) →
            ∃ n,
              ∀ (fuel : Nat),
                n ≤ fuel →
                  ∃ t tr,
                    M0Crypto.Thumb.runUntil (c.regs0 14 &&& ~~~1#32) fuel s = Except.ok (t, tr) ∧
                      M0Crypto.Release.Poly1305Blocks.BResult c s t ∧ M0Crypto.Release.WritesTo c.Wr tr
M0Crypto.Release.Poly1305Blocks.result_frame : ∀ (c : M0Crypto.Release.Poly1305Blocks.BCtx),
  M0Crypto.Release.Poly1305Blocks.BValid c →
    ∀ (s t : M0Crypto.Armv6M.State),
      M0Crypto.Release.Poly1305Blocks.BEntry c s →
        BitVec.getLsbD (c.regs0 14) 0 = Bool.true →
          M0Crypto.Release.Poly1305Blocks.BResult c s t → ∀ (y : M0Crypto.Armv6M.Word), ¬c.Wr y → t.mem y = c.m0 y
M0Crypto.Release.Poly1305Blocks.result_cleared : ∀ (c : M0Crypto.Release.Poly1305Blocks.BCtx)
  (s t : M0Crypto.Armv6M.State),
  M0Crypto.Release.Poly1305Blocks.BEntry c s →
    M0Crypto.Release.Poly1305Blocks.BResult c s t →
      c.count ≠ 0#32 →
        (∀ (r : M0Crypto.Armv6M.Reg), ↑r < 4 ∨ ↑r = 12 ∨ ↑r = 14 → t.regs r = 0#32) ∧
          ∀ (o : Nat), o < M0Crypto.Release.Poly1305Blocks.frameBytes → t.mem (c.fp + BitVec.ofNat 32 o) = 0#8
M0Crypto.Release.Poly1305Blocks.result_h : ∀ (c : M0Crypto.Release.Poly1305Blocks.BCtx),
  M0Crypto.Release.Poly1305Blocks.BValid c →
    ∀ (s t : M0Crypto.Armv6M.State),
      M0Crypto.Release.Poly1305Blocks.BEntry c s →
        M0Crypto.Release.Poly1305Blocks.BResult c s t →
          c.count ≠ 0#32 →
            ∀ (j : Nat) (hj : j < 5),
              M0Crypto.Armv6M.read32 t.mem (M0Crypto.Armv6M.slot c.ctx j) =
                if j < 4 then
                  (M0Crypto.Release.Poly1305Blocks.finalLoop c s).regs
                    ⟨8 + j, Decidable.byContradiction fun a => M0Crypto.Release.Poly1305Blocks.result_h._proof_1 j hj a⟩
                else (M0Crypto.Release.Poly1305Blocks.finalLoop c s).regs 14
M0Crypto.Release.Poly1305Blocks.result_zero : ∀ (c : M0Crypto.Release.Poly1305Blocks.BCtx)
  (s t : M0Crypto.Armv6M.State),
  M0Crypto.Release.Poly1305Blocks.BEntry c s →
    M0Crypto.Release.Poly1305Blocks.BResult c s t →
      c.count = 0#32 → t.mem = c.mP ∧ ∀ (r : M0Crypto.Armv6M.Reg), ↑r < 4 ∨ ↑r = 12 ∨ ↑r = 14 → t.regs r = c.regs0 r
M0Crypto.Release.Poly1305Blocks.result_key_preserved : ∀ (c : M0Crypto.Release.Poly1305Blocks.BCtx),
  M0Crypto.Release.Poly1305Blocks.BValid c →
    ∀ (s t : M0Crypto.Armv6M.State),
      M0Crypto.Release.Poly1305Blocks.BEntry c s →
        BitVec.getLsbD (c.regs0 14) 0 = Bool.true →
          M0Crypto.Release.Poly1305Blocks.BResult c s t →
            ∀ (o : Nat), 20 ≤ o → o < 64 → t.mem (c.ctx + BitVec.ofNat 32 o) = c.m0 (c.ctx + BitVec.ofNat 32 o)
M0Crypto.Release.Poly1305Blocks.blocks_execution_safe : ∀ (c : M0Crypto.Release.Poly1305Blocks.BCtx),
  M0Crypto.Release.Poly1305Blocks.BValid c →
    ∀ (s : M0Crypto.Armv6M.State),
      M0Crypto.Release.Poly1305Blocks.BEntry c s →
        BitVec.getLsbD (c.regs0 14) 0 = Bool.true →
          (∀ (i : Nat), i < M0Crypto.Artifacts.Release.size → c.regs0 14 &&& ~~~1#32 ≠ c.base + BitVec.ofNat 32 i) →
            ∃ n,
              ∀ (fuel : Nat),
                n ≤ fuel →
                  ∃ t tr,
                    M0Crypto.Thumb.runUntil (c.regs0 14 &&& ~~~1#32) fuel s = Except.ok (t, tr) ∧
                      M0Crypto.Release.Poly1305Blocks.BResult c s t ∧
                        M0Crypto.Release.WritesTo c.Wr tr ∧
                          (∀ (y : M0Crypto.Armv6M.Word), ¬c.Wr y → t.mem y = c.m0 y) ∧
                            (c.count ≠ 0#32 →
                              (∀ (r : M0Crypto.Armv6M.Reg), ↑r < 4 ∨ ↑r = 12 ∨ ↑r = 14 → t.regs r = 0#32) ∧
                                ∀ (o : Nat),
                                  o < M0Crypto.Release.Poly1305Blocks.frameBytes →
                                    t.mem (c.fp + BitVec.ofNat 32 o) = 0#8)
M0Crypto.Release.Poly1305Carry.adc5 : ∀ (x0 x1 x2 x3 x4 y0 y1 y2 y3 y4 : M0Crypto.Armv6M.Word),
  have a0 := M0Crypto.Armv6M.addWithCarry x0 y0 Bool.false;
  have a1 := M0Crypto.Armv6M.addWithCarry x1 y1 a0.snd.fst;
  have a2 := M0Crypto.Armv6M.addWithCarry x2 y2 a1.snd.fst;
  have a3 := M0Crypto.Armv6M.addWithCarry x3 y3 a2.snd.fst;
  have a4 := M0Crypto.Armv6M.addWithCarry x4 y4 a3.snd.fst;
  M0Crypto.Release.Poly1305Arith.val5 (BitVec.toNat a0.fst) (BitVec.toNat a1.fst) (BitVec.toNat a2.fst)
        (BitVec.toNat a3.fst) (BitVec.toNat a4.fst) +
      2 ^ 160 * a4.snd.fst.toNat =
    M0Crypto.Release.Poly1305Arith.val5 (BitVec.toNat x0) (BitVec.toNat x1) (BitVec.toNat x2) (BitVec.toNat x3)
        (BitVec.toNat x4) +
      M0Crypto.Release.Poly1305Arith.val5 (BitVec.toNat y0) (BitVec.toNat y1) (BitVec.toNat y2) (BitVec.toNat y3)
        (BitVec.toNat y4)
M0Crypto.Release.Poly1305Carry.adc5_mod : ∀ (x0 x1 x2 x3 x4 y0 y1 y2 y3 y4 : M0Crypto.Armv6M.Word),
  have a0 := M0Crypto.Armv6M.addWithCarry x0 y0 Bool.false;
  have a1 := M0Crypto.Armv6M.addWithCarry x1 y1 a0.snd.fst;
  have a2 := M0Crypto.Armv6M.addWithCarry x2 y2 a1.snd.fst;
  have a3 := M0Crypto.Armv6M.addWithCarry x3 y3 a2.snd.fst;
  have a4 := M0Crypto.Armv6M.addWithCarry x4 y4 a3.snd.fst;
  M0Crypto.Release.Poly1305Arith.val5 (BitVec.toNat a0.fst) (BitVec.toNat a1.fst) (BitVec.toNat a2.fst)
      (BitVec.toNat a3.fst) (BitVec.toNat a4.fst) =
    (M0Crypto.Release.Poly1305Arith.val5 (BitVec.toNat x0) (BitVec.toNat x1) (BitVec.toNat x2) (BitVec.toNat x3)
          (BitVec.toNat x4) +
        M0Crypto.Release.Poly1305Arith.val5 (BitVec.toNat y0) (BitVec.toNat y1) (BitVec.toNat y2) (BitVec.toNat y3)
          (BitVec.toNat y4)) %
      2 ^ 160
M0Crypto.Release.Poly1305Blocks.addMsg_h : ∀ (s : M0Crypto.Armv6M.State),
  M0Crypto.Release.Poly1305Blocks.hval (M0Crypto.Thumb.execAll M0Crypto.Release.Poly1305Blocks.addMsg s) =
    (M0Crypto.Release.Poly1305Blocks.hval s +
          M0Crypto.Release.Poly1305Arith.val4 (BitVec.toNat (s.regs 0)) (BitVec.toNat (s.regs 1))
            (BitVec.toNat (s.regs 2)) (BitVec.toNat (s.regs 3)) +
        2 ^ 128 * BitVec.toNat (s.regs 12)) %
      2 ^ 160
M0Crypto.Release.Poly1305Blocks.fold_h : ∀ (s : M0Crypto.Armv6M.State),
  M0Crypto.Release.Poly1305Blocks.Sep s →
    M0Crypto.Release.Poly1305Blocks.hval (M0Crypto.Thumb.execAll M0Crypto.Release.Poly1305Blocks.fold s) =
      (M0Crypto.Release.Poly1305Arith.val4
              (BitVec.toNat (M0Crypto.Armv6M.read32 s.mem (M0Crypto.Armv6M.slot (s.regs 13) 0)))
              (BitVec.toNat (M0Crypto.Armv6M.read32 s.mem (M0Crypto.Armv6M.slot (s.regs 13) 1)))
              (BitVec.toNat (M0Crypto.Armv6M.read32 s.mem (M0Crypto.Armv6M.slot (s.regs 13) 2)))
              (M0Crypto.Release.Poly1305Mac.v64 s % 2 ^ 32) +
            2 ^ 128 * (BitVec.toNat (M0Crypto.Release.Poly1305Blocks.gw s) % 4) +
          BitVec.toNat (M0Crypto.Release.Poly1305Blocks.fw s)) %
        2 ^ 160
M0Crypto.Release.Poly1305Blocks.body_correct : ∀ (s : M0Crypto.Armv6M.State),
  M0Crypto.Release.Poly1305Blocks.Sep s →
    M0Crypto.Release.Poly1305Blocks.KeyOK s →
      BitVec.toNat (s.regs 14) ≤ 4 →
        BitVec.toNat (s.regs 12) ≤ 1 →
          M0Crypto.Release.Poly1305Blocks.hval (M0Crypto.Thumb.execAll M0Crypto.Release.Poly1305Blocks.body s) %
                M0Crypto.Spec.Aead.p =
              (M0Crypto.Release.Poly1305Blocks.hval s +
                      M0Crypto.Release.Poly1305Arith.val4 (BitVec.toNat (s.regs 0)) (BitVec.toNat (s.regs 1))
                        (BitVec.toNat (s.regs 2)) (BitVec.toNat (s.regs 3)) +
                    2 ^ 128 * BitVec.toNat (s.regs 12)) *
                  M0Crypto.Release.Poly1305Blocks.rval s %
                M0Crypto.Spec.Aead.p ∧
            M0Crypto.Release.Poly1305Blocks.hval (M0Crypto.Thumb.execAll M0Crypto.Release.Poly1305Blocks.body s) <
              5 * 2 ^ 128
M0Crypto.Release.Poly1305Blocks.one_correct : ∀ (s : M0Crypto.Armv6M.State),
  M0Crypto.Release.Poly1305Blocks.Sep s →
    M0Crypto.Release.Poly1305Blocks.KeyOK s →
      BitVec.toNat (s.regs 14) ≤ 4 →
        BitVec.toNat (s.regs 12) ≤ 1 →
          M0Crypto.Release.Poly1305Blocks.hval (M0Crypto.Release.Poly1305Blocks.oneBlock s) % M0Crypto.Spec.Aead.p =
              M0Crypto.Release.Poly1305Spec.step (M0Crypto.Release.Poly1305Blocks.rval s) (BitVec.toNat (s.regs 12))
                (M0Crypto.Release.Poly1305Blocks.hval s)
                (M0Crypto.Release.Frame.Ctx.bytesAt s.mem (M0Crypto.Release.Poly1305Blocks.mp s) 16) ∧
            M0Crypto.Release.Poly1305Blocks.hval (M0Crypto.Release.Poly1305Blocks.oneBlock s) < 5 * 2 ^ 128
M0Crypto.Release.Poly1305Blocks.loop_correct : ∀ (base : M0Crypto.Armv6M.Word) (n : Nat),
  0 < n →
    ∀ (s : M0Crypto.Armv6M.State),
      M0Crypto.Release.Poly1305Blocks.Sep s →
        M0Crypto.Release.Poly1305Blocks.KeyOK s →
          BitVec.toNat (s.regs 14) ≤ 4 →
            BitVec.toNat (s.regs 12) ≤ 1 →
              M0Crypto.Release.Frame.Disj (M0Crypto.Release.Poly1305Blocks.mp s) (16 * n) (s.regs 13)
                  M0Crypto.Release.Poly1305Blocks.frameBytes →
                M0Crypto.Release.Poly1305Blocks.hval (M0Crypto.Release.Poly1305Blocks.loopState base n s) %
                      M0Crypto.Spec.Aead.p =
                    M0Crypto.Release.Poly1305Spec.polyBlocks (M0Crypto.Release.Poly1305Blocks.rval s)
                      (BitVec.toNat (s.regs 12)) (M0Crypto.Release.Poly1305Blocks.hval s % M0Crypto.Spec.Aead.p)
                      (M0Crypto.Release.Frame.Ctx.bytesAt s.mem (M0Crypto.Release.Poly1305Blocks.mp s) (16 * n)) ∧
                  M0Crypto.Release.Poly1305Blocks.hval (M0Crypto.Release.Poly1305Blocks.loopState base n s) <
                    5 * 2 ^ 128
M0Crypto.Release.Poly1305Blocks.result_blocks_correct : ∀ (c : M0Crypto.Release.Poly1305Blocks.BCtx),
  M0Crypto.Release.Poly1305Blocks.BValid c →
    ∀ (s t : M0Crypto.Armv6M.State),
      M0Crypto.Release.Poly1305Blocks.BEntry c s →
        M0Crypto.Release.Poly1305Blocks.BResult c s t →
          M0Crypto.Release.Poly1305Blocks.keyAtOK c.m0 c.ctx →
            M0Crypto.Release.Poly1305Blocks.accAt c.m0 c.ctx < 5 * 2 ^ 128 →
              BitVec.toNat c.pad ≤ 1 →
                M0Crypto.Release.Poly1305Blocks.accAt t.mem c.ctx % M0Crypto.Spec.Aead.p =
                    M0Crypto.Release.Poly1305Spec.polyBlocks (M0Crypto.Release.Poly1305Blocks.keyAt c.m0 c.ctx)
                      (BitVec.toNat c.pad) (M0Crypto.Release.Poly1305Blocks.accAt c.m0 c.ctx % M0Crypto.Spec.Aead.p)
                      (M0Crypto.Release.Frame.Ctx.bytesAt c.m0 c.msg (16 * BitVec.toNat c.count)) ∧
                  M0Crypto.Release.Poly1305Blocks.accAt t.mem c.ctx < 5 * 2 ^ 128
M0Crypto.Release.Poly1305Blocks.blocks_correct : ∀ (c : M0Crypto.Release.Poly1305Blocks.BCtx),
  M0Crypto.Release.Poly1305Blocks.BValid c →
    ∀ (s : M0Crypto.Armv6M.State),
      M0Crypto.Release.Poly1305Blocks.BEntry c s →
        M0Crypto.Release.Poly1305Blocks.keyAtOK c.m0 c.ctx →
          M0Crypto.Release.Poly1305Blocks.accAt c.m0 c.ctx < 5 * 2 ^ 128 →
            BitVec.toNat c.pad ≤ 1 →
              BitVec.getLsbD (c.regs0 14) 0 = Bool.true →
                (∀ (i : Nat),
                    i < M0Crypto.Artifacts.Release.size → c.regs0 14 &&& ~~~1#32 ≠ c.base + BitVec.ofNat 32 i) →
                  ∃ n,
                    ∀ (fuel : Nat),
                      n ≤ fuel →
                        ∃ t tr,
                          M0Crypto.Thumb.runUntil (c.regs0 14 &&& ~~~1#32) fuel s = Except.ok (t, tr) ∧
                            M0Crypto.Release.Poly1305Blocks.BResult c s t ∧
                              M0Crypto.Release.WritesTo c.Wr tr ∧
                                M0Crypto.Release.Poly1305Blocks.accAt t.mem c.ctx % M0Crypto.Spec.Aead.p =
                                    M0Crypto.Release.Poly1305Spec.polyBlocks
                                      (M0Crypto.Release.Poly1305Blocks.keyAt c.m0 c.ctx) (BitVec.toNat c.pad)
                                      (M0Crypto.Release.Poly1305Blocks.accAt c.m0 c.ctx % M0Crypto.Spec.Aead.p)
                                      (M0Crypto.Release.Frame.Ctx.bytesAt c.m0 c.msg (16 * BitVec.toNat c.count)) ∧
                                  M0Crypto.Release.Poly1305Blocks.accAt t.mem c.ctx < 5 * 2 ^ 128
M0Crypto.Release.Poly1305Finish.segments_at : M0Crypto.Thumb.seqAt M0Crypto.Release.B
      M0Crypto.Release.Poly1305Finish.entryAt M0Crypto.Release.Poly1305Finish.header =
    Bool.true ∧
  M0Crypto.Thumb.seqAt M0Crypto.Release.B M0Crypto.Release.Poly1305Finish.arithAt
        M0Crypto.Release.Poly1305Finish.arithmetic =
      Bool.true ∧
    M0Crypto.Thumb.seqAt M0Crypto.Release.B M0Crypto.Release.Poly1305Finish.emitAt
          M0Crypto.Release.Poly1305Finish.emit =
        Bool.true ∧
      M0Crypto.Thumb.seqAt M0Crypto.Release.B M0Crypto.Release.Poly1305Finish.clearAt
            M0Crypto.Release.Poly1305Finish.clear =
          Bool.true ∧
        M0Crypto.Thumb.instrAt M0Crypto.Release.B M0Crypto.Release.Poly1305Finish.popAt =
          Option.some (M0Crypto.Thumb.Instr.pop 240 Bool.true)
M0Crypto.Release.Poly1305Finish.carry_correct : ∀ (s : M0Crypto.Armv6M.State),
  s.regs 6 = 0#32 →
    M0Crypto.Release.Poly1305Finish.hv s < 2 * M0Crypto.Spec.Aead.p →
      BitVec.toNat ((M0Crypto.Thumb.execAll M0Crypto.Release.Poly1305Finish.carry s).regs 1) =
        5 * ((M0Crypto.Release.Poly1305Finish.hv s + 5) / 2 ^ 130)
M0Crypto.Release.Poly1305Finish.arithmetic_correct : ∀ (s : M0Crypto.Armv6M.State),
  s.regs 6 = 0#32 →
    M0Crypto.Release.Poly1305Finish.hv s < 2 * M0Crypto.Spec.Aead.p →
      M0Crypto.Release.Poly1305Finish.low (M0Crypto.Thumb.execAll M0Crypto.Release.Poly1305Finish.arithmetic s) =
        (M0Crypto.Release.Poly1305Finish.hv s % M0Crypto.Spec.Aead.p + M0Crypto.Release.Poly1305Finish.pv s) % 2 ^ 128
M0Crypto.Release.Poly1305Finish.tagMem_bytes : ∀ (s : M0Crypto.Armv6M.State),
  M0Crypto.Release.Frame.Ctx.bytesAt (M0Crypto.Release.Poly1305Finish.tagMem s) (s.regs 12) 16 =
    M0Crypto.Spec.Aead.leBytes 16 (M0Crypto.Release.Poly1305Finish.low s)
M0Crypto.Release.Poly1305Finish.pop_ret : ∀ (c : M0Crypto.Release.Poly1305Finish.FCtx),
  M0Crypto.Release.Poly1305Finish.FValid c →
    ∀ (s : M0Crypto.Armv6M.State),
      s.pc = c.base + BitVec.ofNat 32 M0Crypto.Release.Poly1305Finish.popAt →
        s.regs 13 = c.fp →
          (∀ (j : Nat),
              j < 5 →
                M0Crypto.Armv6M.read32 s.mem (M0Crypto.Armv6M.slot c.fp j) =
                  [c.regs0 4, c.regs0 5, c.regs0 6, c.regs0 7, c.regs0 14].getD j 0#32) →
            BitVec.getLsbD (c.regs0 14) 0 = Bool.true →
              M0Crypto.Release.Reach c.base c.Wr s fun t =>
                t.pc = c.regs0 14 &&& ~~~1#32 ∧
                  t.regs 13 = c.sp0 ∧
                    (∀ (r : M0Crypto.Armv6M.Reg), 4 ≤ ↑r → ↑r < 8 → t.regs r = c.regs0 r) ∧
                      (∀ (r : M0Crypto.Armv6M.Reg), ↑r < 4 ∨ 8 ≤ ↑r → ↑r ≠ 13 → ↑r ≠ 15 → t.regs r = s.regs r) ∧
                        t.mem = s.mem
M0Crypto.Release.Poly1305Finish.emit_writes : ∀ (s : M0Crypto.Armv6M.State),
  M0Crypto.Thumb.WritesIn (M0Crypto.Thumb.traceAll M0Crypto.Release.Poly1305Finish.emit s) (s.regs 12) 16
M0Crypto.Release.Poly1305Finish.finish_reach : ∀ (c : M0Crypto.Release.Poly1305Finish.FCtx),
  M0Crypto.Release.Poly1305Finish.FValid c →
    ∀ (s : M0Crypto.Armv6M.State),
      M0Crypto.Release.Poly1305Finish.FEntry c s →
        BitVec.getLsbD (c.regs0 14) 0 = Bool.true →
          M0Crypto.Release.Reach c.base c.Wr s fun t => M0Crypto.Release.Poly1305Finish.FResult c s t
M0Crypto.Release.Poly1305Finish.result_tag : ∀ (c : M0Crypto.Release.Poly1305Finish.FCtx),
  M0Crypto.Release.Poly1305Finish.FValid c →
    ∀ (s t : M0Crypto.Armv6M.State),
      M0Crypto.Release.Poly1305Finish.FEntry c s →
        M0Crypto.Release.Poly1305Finish.FResult c s t →
          c.acc < 2 * M0Crypto.Spec.Aead.p →
            M0Crypto.Release.Frame.Ctx.bytesAt t.mem c.tag 16 =
              M0Crypto.Spec.Aead.leBytes 16 (c.acc % M0Crypto.Spec.Aead.p + c.padVal)
M0Crypto.Release.Poly1305Finish.result_frame : ∀ (c : M0Crypto.Release.Poly1305Finish.FCtx)
  (s t : M0Crypto.Armv6M.State),
  M0Crypto.Release.Poly1305Finish.FEntry c s →
    M0Crypto.Release.Poly1305Finish.FResult c s t → ∀ (y : M0Crypto.Armv6M.Word), ¬c.Wr y → t.mem y = c.m0 y
M0Crypto.Release.Poly1305Finish.finish_correct : ∀ (c : M0Crypto.Release.Poly1305Finish.FCtx),
  M0Crypto.Release.Poly1305Finish.FValid c →
    ∀ (s : M0Crypto.Armv6M.State),
      M0Crypto.Release.Poly1305Finish.FEntry c s →
        c.acc < 2 * M0Crypto.Spec.Aead.p →
          BitVec.getLsbD (c.regs0 14) 0 = Bool.true →
            (∀ (i : Nat), i < M0Crypto.Artifacts.Release.size → c.regs0 14 &&& ~~~1#32 ≠ c.base + BitVec.ofNat 32 i) →
              ∃ n,
                ∀ (fuel : Nat),
                  n ≤ fuel →
                    ∃ t tr,
                      M0Crypto.Thumb.runUntil (c.regs0 14 &&& ~~~1#32) fuel s = Except.ok (t, tr) ∧
                        M0Crypto.Release.Poly1305Finish.FResult c s t ∧
                          M0Crypto.Release.WritesTo c.Wr tr ∧
                            M0Crypto.Release.Frame.Ctx.bytesAt t.mem c.tag 16 =
                                M0Crypto.Spec.Aead.leBytes 16 (c.acc % M0Crypto.Spec.Aead.p + c.padVal) ∧
                              ∀ (y : M0Crypto.Armv6M.Word), ¬c.Wr y → t.mem y = c.m0 y
M0Crypto.Release.Poly1305Context.init_keyOk : ∀ (c : M0Crypto.Release.Poly1305Init.ICtx) (t : M0Crypto.Armv6M.State),
  M0Crypto.Release.Poly1305Init.IResult c t → M0Crypto.Release.Poly1305Blocks.keyAtOK t.mem c.ctx
M0Crypto.Release.Poly1305Context.init_acc : ∀ (c : M0Crypto.Release.Poly1305Init.ICtx) (t : M0Crypto.Armv6M.State),
  M0Crypto.Release.Poly1305Init.IResult c t → M0Crypto.Release.Poly1305Blocks.accAt t.mem c.ctx = 0
M0Crypto.Release.Poly1305Context.init_key : ∀ (c : M0Crypto.Release.Poly1305Init.ICtx) (t : M0Crypto.Armv6M.State),
  M0Crypto.Release.Poly1305Init.IResult c t →
    M0Crypto.Release.Poly1305Blocks.keyAt t.mem c.ctx =
      M0Crypto.Spec.Aead.clamp (M0Crypto.Spec.Aead.leNat (M0Crypto.Release.Frame.Ctx.bytesAt c.m0 c.key 16))
M0Crypto.Release.Poly1305Context.init_pad : ∀ (c : M0Crypto.Release.Poly1305Init.ICtx) (t : M0Crypto.Armv6M.State),
  M0Crypto.Release.Poly1305Init.IResult c t →
    M0Crypto.Release.Poly1305Context.padAt t.mem c.ctx =
      M0Crypto.Spec.Aead.leNat (M0Crypto.Release.Frame.Ctx.bytesAt c.m0 (c.key + 16#32) 16)
M0Crypto.Release.Poly1305Context.blocks_words : ∀ (c : M0Crypto.Release.Poly1305Blocks.BCtx),
  M0Crypto.Release.Poly1305Blocks.BValid c →
    ∀ (s t : M0Crypto.Armv6M.State),
      M0Crypto.Release.Poly1305Blocks.BEntry c s →
        BitVec.getLsbD (c.regs0 14) 0 = Bool.true →
          M0Crypto.Release.Poly1305Blocks.BResult c s t →
            ∀ (j : Nat),
              5 ≤ j →
                j < 16 →
                  M0Crypto.Release.Poly1305Blocks.wordAt t.mem c.ctx j =
                    M0Crypto.Release.Poly1305Blocks.wordAt c.m0 c.ctx j
M0Crypto.Release.Poly1305Context.blocks_keyOk : ∀ (c : M0Crypto.Release.Poly1305Blocks.BCtx),
  M0Crypto.Release.Poly1305Blocks.BValid c →
    ∀ (s t : M0Crypto.Armv6M.State),
      M0Crypto.Release.Poly1305Blocks.BEntry c s →
        BitVec.getLsbD (c.regs0 14) 0 = Bool.true →
          M0Crypto.Release.Poly1305Blocks.BResult c s t →
            M0Crypto.Release.Poly1305Blocks.keyAtOK c.m0 c.ctx → M0Crypto.Release.Poly1305Blocks.keyAtOK t.mem c.ctx
M0Crypto.Release.Poly1305Context.blocks_pad : ∀ (c : M0Crypto.Release.Poly1305Blocks.BCtx),
  M0Crypto.Release.Poly1305Blocks.BValid c →
    ∀ (s t : M0Crypto.Armv6M.State),
      M0Crypto.Release.Poly1305Blocks.BEntry c s →
        BitVec.getLsbD (c.regs0 14) 0 = Bool.true →
          M0Crypto.Release.Poly1305Blocks.BResult c s t →
            M0Crypto.Release.Poly1305Context.padAt t.mem c.ctx = M0Crypto.Release.Poly1305Context.padAt c.m0 c.ctx
M0Crypto.Release.Poly1305Context.finish_bound : ∀ (h : Nat), h < 5 * 2 ^ 128 → h < 2 * M0Crypto.Spec.Aead.p
M0Crypto.Release.Poly1305Context.finish_acc : ∀ (c : M0Crypto.Release.Poly1305Finish.FCtx),
  c.acc = M0Crypto.Release.Poly1305Blocks.accAt c.m0 c.ctx
M0Crypto.Release.Poly1305Context.finish_pad : ∀ (c : M0Crypto.Release.Poly1305Finish.FCtx),
  c.padVal = M0Crypto.Release.Poly1305Context.padAt c.m0 c.ctx
M0Crypto.Release.Poly1305Context.key_split : ∀ (m : M0Crypto.Armv6M.Mem) (k : M0Crypto.Armv6M.Word),
  List.take 16 (M0Crypto.Release.Frame.Ctx.bytesAt m k 32) = M0Crypto.Release.Frame.Ctx.bytesAt m k 16 ∧
    List.take 16 (List.drop 16 (M0Crypto.Release.Frame.Ctx.bytesAt m k 32)) =
      M0Crypto.Release.Frame.Ctx.bytesAt m (k + 16#32) 16
M0Crypto.Release.Poly1305Context.poly1305_chain : ∀ (c : M0Crypto.Release.Poly1305Init.ICtx)
  (ti : M0Crypto.Armv6M.State),
  M0Crypto.Release.Poly1305Init.IResult c ti →
    ∀ (mf : M0Crypto.Armv6M.Mem) (msg : List M0Crypto.Spec.ChaCha20.Byte),
      msg.length % 16 = 0 →
        M0Crypto.Release.Poly1305Context.padAt mf c.ctx = M0Crypto.Release.Poly1305Context.padAt ti.mem c.ctx →
          M0Crypto.Release.Poly1305Blocks.accAt mf c.ctx % M0Crypto.Spec.Aead.p =
              M0Crypto.Release.Poly1305Spec.polyBlocks (M0Crypto.Release.Poly1305Blocks.keyAt ti.mem c.ctx) 1
                (M0Crypto.Release.Poly1305Blocks.accAt ti.mem c.ctx % M0Crypto.Spec.Aead.p) msg →
            M0Crypto.Spec.Aead.leBytes 16
                (M0Crypto.Release.Poly1305Blocks.accAt mf c.ctx % M0Crypto.Spec.Aead.p +
                  M0Crypto.Release.Poly1305Context.padAt mf c.ctx) =
              M0Crypto.Spec.Aead.poly1305 (M0Crypto.Release.Frame.Ctx.bytesAt c.m0 c.key 32) msg
M0Crypto.Release.Aead.mac_padded : ∀ (base A d n : M0Crypto.Armv6M.Word) (M : M0Crypto.Armv6M.Mem) (m : Nat)
  (i1 i2 : BitVec 25),
  M0Crypto.Release.Aead.MacAt m i1 i2 →
    m % 2 = 0 →
      m + M0Crypto.Release.Aead.macSize ≤ M0Crypto.Artifacts.Release.size →
        M0Crypto.Release.Aead.MacEnv base A d n M →
          ∀ (s : M0Crypto.Armv6M.State),
            s.pc = base + BitVec.ofNat 32 m →
              s.regs 13 = A →
                s.regs 4 = d →
                  s.regs 5 = n →
                    s.mem = M →
                      M0Crypto.Release.Poly1305Blocks.keyAtOK M (A + 8#32) →
                        M0Crypto.Release.Poly1305Blocks.accAt M (A + 8#32) < 5 * 2 ^ 128 →
                          M0Crypto.Release.Reach base (M0Crypto.Release.Aead.MacWr A) s
                            (M0Crypto.Release.Aead.MacPost base A d n M m s)
M0Crypto.Release.Aead.aead_setup : ∀ (c : M0Crypto.Release.Aead.ACall),
  M0Crypto.Release.Aead.AValid c →
    ∀ (e : Nat) (i0 i1 : BitVec 25),
      M0Crypto.Thumb.seqAt M0Crypto.Release.B e M0Crypto.Release.Aead.pro = Bool.true →
        M0Crypto.Thumb.instrAt M0Crypto.Release.B (e + M0Crypto.Release.Aead.proXorOff) =
            Option.some (M0Crypto.Thumb.Instr.bl i0) →
          M0Crypto.Release.Aead.blTarget (e + M0Crypto.Release.Aead.proXorOff) i0 =
              BitVec.ofNat 32 M0Crypto.Release.Aead.xorOff →
            M0Crypto.Thumb.seqAt M0Crypto.Release.B (e + M0Crypto.Release.Aead.copyOff) M0Crypto.Release.Aead.copy =
                Bool.true →
              M0Crypto.Thumb.instrAt M0Crypto.Release.B (e + M0Crypto.Release.Aead.initCallOff) =
                  Option.some (M0Crypto.Thumb.Instr.bl i1) →
                M0Crypto.Release.Aead.blTarget (e + M0Crypto.Release.Aead.initCallOff) i1 =
                    BitVec.ofNat 32 M0Crypto.Release.Aead.initOff →
                  e % 2 = 0 →
                    e + M0Crypto.Release.Aead.setupEnd ≤ M0Crypto.Artifacts.Release.size →
                      ∀ (s : M0Crypto.Armv6M.State),
                        M0Crypto.Release.Aead.AEntry c e s →
                          M0Crypto.Release.Reach c.base (M0Crypto.Release.Aead.SWr c.A) s fun t =>
                            ∃ ic, M0Crypto.Release.Aead.SetupPost c e ic t
M0Crypto.Release.Aead.crypt_reach : ∀ (c : M0Crypto.Release.Aead.ACall),
  M0Crypto.Release.Aead.AValid c →
    M0Crypto.Release.Aead.ABuf c →
      ∀ (off : Nat) (i : BitVec 25),
        M0Crypto.Thumb.seqAt M0Crypto.Release.B off M0Crypto.Release.Aead.crypt = Bool.true →
          M0Crypto.Thumb.instrAt M0Crypto.Release.B (off + M0Crypto.Release.Aead.cryptXorOff) =
              Option.some (M0Crypto.Thumb.Instr.bl i) →
            M0Crypto.Release.Aead.blTarget (off + M0Crypto.Release.Aead.cryptXorOff) i =
                BitVec.ofNat 32 M0Crypto.Release.Aead.xorOff →
              off % 2 = 0 →
                off + M0Crypto.Release.Aead.cryptEnd ≤ M0Crypto.Artifacts.Release.size →
                  ∀ (t : M0Crypto.Armv6M.State),
                    t.pc = c.base + BitVec.ofNat 32 off →
                      t.regs 13 = c.A →
                        M0Crypto.Release.Aead.Hi c t.mem →
                          M0Crypto.Armv6M.read32 t.mem c.A = c.nonce →
                            (∀ (y : M0Crypto.Armv6M.Word), ¬M0Crypto.Release.Aead.SWr c.A y → t.mem y = c.m0 y) →
                              M0Crypto.Release.Reach c.base (M0Crypto.Release.Aead.AWr c) t
                                (M0Crypto.Release.Aead.CryptPost c off t)
M0Crypto.Release.Aead.bytesAt_le64 : ∀ (m : M0Crypto.Armv6M.Mem) (a w : M0Crypto.Armv6M.Word),
  M0Crypto.Armv6M.read32 m a = w →
    M0Crypto.Armv6M.read32 m (a + 4#32) = 0#32 →
      M0Crypto.Release.Frame.Ctx.bytesAt m a 8 = M0Crypto.Spec.Aead.leBytes 8 (BitVec.toNat w)
M0Crypto.Release.Aead.lengthMem_bytes : ∀ (m : M0Crypto.Armv6M.Mem) (A alen len : M0Crypto.Armv6M.Word),
  M0Crypto.Release.Frame.Ctx.bytesAt (M0Crypto.Release.Aead.lengthMem m A alen len) (A + 72#32) 16 =
    M0Crypto.Spec.Aead.leBytes 8 (BitVec.toNat alen) ++ M0Crypto.Spec.Aead.leBytes 8 (BitVec.toNat len)
M0Crypto.Release.Aead.lengths_reach : ∀ (c : M0Crypto.Release.Aead.ACall),
  M0Crypto.Release.Aead.AValid c →
    ∀ (off : Nat) (i : BitVec 25),
      M0Crypto.Thumb.seqAt M0Crypto.Release.B off M0Crypto.Release.Aead.lengths = Bool.true →
        M0Crypto.Thumb.instrAt M0Crypto.Release.B (off + M0Crypto.Thumb.seqSize M0Crypto.Release.Aead.lengths) =
            Option.some (M0Crypto.Thumb.Instr.bl i) →
          M0Crypto.Release.Aead.blTarget (off + M0Crypto.Thumb.seqSize M0Crypto.Release.Aead.lengths) i =
              BitVec.ofNat 32 M0Crypto.Release.Aead.blocksOff →
            off % 2 = 0 →
              off + M0Crypto.Thumb.seqSize M0Crypto.Release.Aead.lengths + M0Crypto.Release.blSize ≤
                  M0Crypto.Artifacts.Release.size →
                ∀ (s : M0Crypto.Armv6M.State),
                  s.pc = c.base + BitVec.ofNat 32 off →
                    s.regs 13 = c.A →
                      M0Crypto.Release.Aead.Hi c s.mem →
                        M0Crypto.Thumb.CodeAt s.mem c.base M0Crypto.Release.B →
                          ∀ (ti : M0Crypto.Armv6M.Mem) (msg : List M0Crypto.Spec.ChaCha20.Byte),
                            M0Crypto.Release.Aead.PInv c.A ti msg s.mem →
                              M0Crypto.Release.Reach c.base (M0Crypto.Release.Aead.MacWr c.A) s
                                (M0Crypto.Release.Aead.LengthPost c off ti msg s)
M0Crypto.Release.Aead.finish_call : ∀ (c : M0Crypto.Release.Aead.ACall),
  M0Crypto.Release.Aead.AValid c →
    ∀ (tag : M0Crypto.Armv6M.Word) (off : Nat) (i : BitVec 25),
      M0Crypto.Thumb.instrAt M0Crypto.Release.B off = Option.some (M0Crypto.Thumb.Instr.bl i) →
        M0Crypto.Release.Aead.blTarget off i = BitVec.ofNat 32 M0Crypto.Release.Aead.finishOff →
          off % 2 = 0 →
            off + M0Crypto.Release.blSize ≤ M0Crypto.Artifacts.Release.size →
              ∀ (s : M0Crypto.Armv6M.State),
                s.pc = c.base + BitVec.ofNat 32 off →
                  s.regs 13 = c.A →
                    s.regs 0 = c.A + 8#32 →
                      s.regs 1 = tag →
                        M0Crypto.Thumb.CodeAt s.mem c.base M0Crypto.Release.B →
                          M0Crypto.Release.Frame.Disj c.base M0Crypto.Artifacts.Release.size tag 16 →
                            M0Crypto.Release.Frame.Disj tag 16 (c.A - 20#32) 20 →
                              ∀ (ic : M0Crypto.Release.Poly1305Init.ICtx) (ti : M0Crypto.Armv6M.State),
                                M0Crypto.Release.Poly1305Init.IResult ic ti →
                                  ic.ctx = c.A + 8#32 →
                                    M0Crypto.Release.Frame.Ctx.bytesAt ic.m0 ic.key 32 =
                                        M0Crypto.Spec.Aead.polyKey c.keyB c.nonceB →
                                      ∀ (msg : List M0Crypto.Spec.ChaCha20.Byte),
                                        M0Crypto.Release.Aead.PInv c.A ti.mem msg s.mem →
                                          M0Crypto.Release.Reach c.base (M0Crypto.Release.Aead.FinishWr c.A tag) s
                                            (M0Crypto.Release.Aead.FinishPost c tag off msg s)
M0Crypto.Release.Aead.clear_reach : ∀ (base A : M0Crypto.Armv6M.Word) (off : Nat),
  M0Crypto.Thumb.seqAt M0Crypto.Release.B off M0Crypto.Release.Aead.clrA = Bool.true →
    M0Crypto.Thumb.seqAt M0Crypto.Release.B (off + M0Crypto.Thumb.seqSize M0Crypto.Release.Aead.clrA)
          M0Crypto.Release.Aead.clrL =
        Bool.true →
      M0Crypto.Thumb.instrAt M0Crypto.Release.B
            (off + M0Crypto.Thumb.seqSize M0Crypto.Release.Aead.clrA +
              M0Crypto.Thumb.seqSize M0Crypto.Release.Aead.clrL) =
          Option.some
            (M0Crypto.Thumb.Instr.bcond 1
              (M0Crypto.Release.brImm8
                (off + M0Crypto.Thumb.seqSize M0Crypto.Release.Aead.clrA +
                  M0Crypto.Thumb.seqSize M0Crypto.Release.Aead.clrL)
                (off + M0Crypto.Thumb.seqSize M0Crypto.Release.Aead.clrA))) →
        BitVec.toNat base % 4 = 0 →
          BitVec.toNat A % 4 = 0 →
            off % 2 = 0 →
              off + M0Crypto.Thumb.seqSize M0Crypto.Release.Aead.clrA +
                      M0Crypto.Thumb.seqSize M0Crypto.Release.Aead.clrL +
                    M0Crypto.Release.brSize ≤
                  M0Crypto.Artifacts.Release.size →
                ∀ (s : M0Crypto.Armv6M.State),
                  s.pc = base + BitVec.ofNat 32 off →
                    s.regs 13 = A →
                      M0Crypto.Release.Reach base (M0Crypto.Release.Aead.ClearWr A) s
                        (M0Crypto.Release.Aead.ClearPost base A off s)
M0Crypto.Release.Aead.epilogue_reach : ∀ (c : M0Crypto.Release.Aead.ACall),
  M0Crypto.Release.Aead.AValid c →
    ∀ (Wr : M0Crypto.Armv6M.Word → Prop) (dec : Bool) (off : Nat),
      M0Crypto.Thumb.seqAt M0Crypto.Release.B off (M0Crypto.Release.Aead.epilogue dec) = Bool.true →
        M0Crypto.Thumb.instrAt M0Crypto.Release.B (off + M0Crypto.Thumb.seqSize (M0Crypto.Release.Aead.epilogue dec)) =
            Option.some (M0Crypto.Thumb.Instr.pop 240 Bool.true) →
          off % 2 = 0 →
            off + M0Crypto.Thumb.seqSize (M0Crypto.Release.Aead.epilogue dec) +
                  M0Crypto.Thumb.seqSize [M0Crypto.Thumb.Instr.pop 240 Bool.true] ≤
                M0Crypto.Artifacts.Release.size →
              ∀ (s : M0Crypto.Armv6M.State),
                s.pc = c.base + BitVec.ofNat 32 off →
                  s.regs 13 = c.A →
                    M0Crypto.Release.Aead.Hi c s.mem →
                      (∀ (r : M0Crypto.Armv6M.Reg), 8 ≤ ↑r → ↑r < 12 → s.regs r = c.regs0 r) →
                        BitVec.getLsbD (c.regs0 14) 0 = Bool.true →
                          M0Crypto.Release.Reach c.base Wr s fun t =>
                            M0Crypto.Release.Aead.RetPost c (if dec = Bool.true then s.regs 4 else 0#32) t ∧
                              t.mem = s.mem
M0Crypto.Release.Aead.mac_phase : ∀ (c : M0Crypto.Release.Aead.ACall),
  M0Crypto.Release.Aead.AValid c →
    ∀ (Wr : M0Crypto.Armv6M.Word → Prop) (off : Nat) (is : List M0Crypto.Thumb.Instr) (u v : BitVec 8),
      is = [M0Crypto.Thumb.Instr.ldrSp 4 u, M0Crypto.Thumb.Instr.ldrSp 5 v] →
        M0Crypto.Thumb.seqAt M0Crypto.Release.B off is = Bool.true →
          ∀ (i1 i2 : BitVec 25),
            M0Crypto.Release.Aead.MacAt (off + M0Crypto.Thumb.seqSize is) i1 i2 →
              off % 2 = 0 →
                off + M0Crypto.Thumb.seqSize is + M0Crypto.Release.Aead.macSize ≤ M0Crypto.Artifacts.Release.size →
                  ∀ (s : M0Crypto.Armv6M.State),
                    s.pc = c.base + BitVec.ofNat 32 off →
                      ∀ (d n : M0Crypto.Armv6M.Word),
                        M0Crypto.Release.Frame.Disj d (BitVec.toNat n) (c.sp0 - 320#32) 320 →
                          M0Crypto.Armv6M.read32 s.mem (c.A + BitVec.ofNat 32 (4 * u.toNat)) = d →
                            M0Crypto.Armv6M.read32 s.mem (c.A + BitVec.ofNat 32 (4 * v.toNat)) = n →
                              M0Crypto.Release.Aead.Body c Wr s →
                                ∀ (ti : M0Crypto.Armv6M.Mem) (msg : List M0Crypto.Spec.ChaCha20.Byte),
                                  M0Crypto.Release.Aead.PInv c.A ti msg s.mem →
                                    (∀ (y : M0Crypto.Armv6M.Word), M0Crypto.Release.Aead.MacWr c.A y → Wr y) →
                                      M0Crypto.Release.Reach c.base Wr s
                                        (M0Crypto.Release.Aead.PhasePost c Wr
                                          (off + M0Crypto.Thumb.seqSize is + M0Crypto.Release.Aead.macSize) ti
                                          (msg ++
                                            (M0Crypto.Release.Frame.Ctx.bytesAt s.mem d (BitVec.toNat n) ++
                                              M0Crypto.Spec.Aead.pad16
                                                (M0Crypto.Release.Frame.Ctx.bytesAt s.mem d (BitVec.toNat n))))
                                          s)
M0Crypto.Release.Aead.finish_phase : ∀ (c : M0Crypto.Release.Aead.ACall),
  M0Crypto.Release.Aead.AValid c →
    M0Crypto.Release.Aead.ABuf c →
      ∀ (dec : Bool) (off : Nat),
        M0Crypto.Thumb.seqAt M0Crypto.Release.B off (M0Crypto.Release.Aead.finArgs dec) = Bool.true →
          ∀ (i : BitVec 25),
            M0Crypto.Thumb.instrAt M0Crypto.Release.B
                  (off + M0Crypto.Thumb.seqSize (M0Crypto.Release.Aead.finArgs dec)) =
                Option.some (M0Crypto.Thumb.Instr.bl i) →
              M0Crypto.Release.Aead.blTarget (off + M0Crypto.Thumb.seqSize (M0Crypto.Release.Aead.finArgs dec)) i =
                  BitVec.ofNat 32 M0Crypto.Release.Aead.finishOff →
                off % 2 = 0 →
                  off + M0Crypto.Thumb.seqSize (M0Crypto.Release.Aead.finArgs dec) + M0Crypto.Release.blSize ≤
                      M0Crypto.Artifacts.Release.size →
                    ∀ (s : M0Crypto.Armv6M.State),
                      s.pc = c.base + BitVec.ofNat 32 off →
                        s.regs 13 = c.A →
                          M0Crypto.Release.Aead.Hi c s.mem →
                            M0Crypto.Thumb.CodeAt s.mem c.base M0Crypto.Release.B →
                              ∀ (ic : M0Crypto.Release.Poly1305Init.ICtx) (ti : M0Crypto.Armv6M.State),
                                M0Crypto.Release.Poly1305Init.IResult ic ti →
                                  ic.ctx = c.A + 8#32 →
                                    M0Crypto.Release.Frame.Ctx.bytesAt ic.m0 ic.key 32 =
                                        M0Crypto.Spec.Aead.polyKey c.keyB c.nonceB →
                                      ∀ (msg : List M0Crypto.Spec.ChaCha20.Byte),
                                        M0Crypto.Release.Aead.PInv c.A ti.mem msg s.mem →
                                          M0Crypto.Release.Reach c.base
                                            (M0Crypto.Release.Aead.FinishWr c.A
                                              (if dec = Bool.true then c.A + 72#32 else c.tag))
                                            s
                                            (M0Crypto.Release.Aead.FinishPost c
                                              (if dec = Bool.true then c.A + 72#32 else c.tag)
                                              (off + M0Crypto.Thumb.seqSize (M0Crypto.Release.Aead.finArgs dec)) msg s)
M0Crypto.Release.Aead.encrypt_reach : ∀ (c : M0Crypto.Release.Aead.ACall),
  M0Crypto.Release.Aead.AValid c →
    M0Crypto.Release.Aead.ABuf c →
      ∀ (s : M0Crypto.Armv6M.State),
        M0Crypto.Release.Aead.AEntry c M0Crypto.Release.Aead.encOff s →
          BitVec.getLsbD (c.regs0 14) 0 = Bool.true →
            M0Crypto.Release.Reach c.base (M0Crypto.Release.Aead.AWr c) s (M0Crypto.Release.Aead.EncryptResult c)
M0Crypto.Release.Aead.encrypt_correct : ∀ (c : M0Crypto.Release.Aead.ACall) (s : M0Crypto.Armv6M.State),
  M0Crypto.Release.Aead.APre c M0Crypto.Release.Aead.encOff s →
    ∃ n,
      ∀ (fuel : Nat),
        n ≤ fuel →
          ∃ t tr,
            M0Crypto.Thumb.runUntil c.ret fuel s = Except.ok (t, tr) ∧
              M0Crypto.Release.Aead.EncryptResult c t ∧ M0Crypto.Release.WritesTo (M0Crypto.Release.Aead.AWr c) tr
M0Crypto.Release.Aead.crypt_reach_narrow : ∀ (c : M0Crypto.Release.Aead.ACall),
  M0Crypto.Release.Aead.AValid c →
    M0Crypto.Release.Aead.ABuf c →
      ∀ (off : Nat) (i : BitVec 25),
        M0Crypto.Thumb.seqAt M0Crypto.Release.B off M0Crypto.Release.Aead.crypt = Bool.true →
          M0Crypto.Thumb.instrAt M0Crypto.Release.B (off + M0Crypto.Release.Aead.cryptXorOff) =
              Option.some (M0Crypto.Thumb.Instr.bl i) →
            M0Crypto.Release.Aead.blTarget (off + M0Crypto.Release.Aead.cryptXorOff) i =
                BitVec.ofNat 32 M0Crypto.Release.Aead.xorOff →
              off % 2 = 0 →
                off + M0Crypto.Release.Aead.cryptEnd ≤ M0Crypto.Artifacts.Release.size →
                  ∀ (t : M0Crypto.Armv6M.State),
                    t.pc = c.base + BitVec.ofNat 32 off →
                      t.regs 13 = c.A →
                        M0Crypto.Release.Aead.Hi c t.mem →
                          M0Crypto.Armv6M.read32 t.mem c.A = c.nonce →
                            (∀ (y : M0Crypto.Armv6M.Word), ¬M0Crypto.Release.Aead.SWr c.A y → t.mem y = c.m0 y) →
                              M0Crypto.Release.Reach c.base (M0Crypto.Release.Aead.CryptWr c) t
                                (M0Crypto.Release.Aead.CryptPost c off t)
M0Crypto.Release.Aead.clear_return : ∀ (c : M0Crypto.Release.Aead.ACall),
  M0Crypto.Release.Aead.AValid c →
    ∀ (dec : Bool) (off : Nat),
      M0Crypto.Thumb.seqAt M0Crypto.Release.B off M0Crypto.Release.Aead.clrA = Bool.true →
        M0Crypto.Thumb.seqAt M0Crypto.Release.B (off + M0Crypto.Thumb.seqSize M0Crypto.Release.Aead.clrA)
              M0Crypto.Release.Aead.clrL =
            Bool.true →
          M0Crypto.Thumb.instrAt M0Crypto.Release.B
                (off + M0Crypto.Thumb.seqSize M0Crypto.Release.Aead.clrA +
                  M0Crypto.Thumb.seqSize M0Crypto.Release.Aead.clrL) =
              Option.some
                (M0Crypto.Thumb.Instr.bcond 1
                  (M0Crypto.Release.brImm8
                    (off + M0Crypto.Thumb.seqSize M0Crypto.Release.Aead.clrA +
                      M0Crypto.Thumb.seqSize M0Crypto.Release.Aead.clrL)
                    (off + M0Crypto.Thumb.seqSize M0Crypto.Release.Aead.clrA))) →
            M0Crypto.Thumb.seqAt M0Crypto.Release.B
                  (off + M0Crypto.Thumb.seqSize M0Crypto.Release.Aead.clrA +
                      M0Crypto.Thumb.seqSize M0Crypto.Release.Aead.clrL +
                    M0Crypto.Release.brSize)
                  (M0Crypto.Release.Aead.epilogue dec) =
                Bool.true →
              M0Crypto.Thumb.instrAt M0Crypto.Release.B
                    (off + M0Crypto.Thumb.seqSize M0Crypto.Release.Aead.clrA +
                          M0Crypto.Thumb.seqSize M0Crypto.Release.Aead.clrL +
                        M0Crypto.Release.brSize +
                      M0Crypto.Thumb.seqSize (M0Crypto.Release.Aead.epilogue dec)) =
                  Option.some (M0Crypto.Thumb.Instr.pop 240 Bool.true) →
                off % 2 = 0 →
                  off + M0Crypto.Thumb.seqSize M0Crypto.Release.Aead.clrA +
                              M0Crypto.Thumb.seqSize M0Crypto.Release.Aead.clrL +
                            M0Crypto.Release.brSize +
                          M0Crypto.Thumb.seqSize (M0Crypto.Release.Aead.epilogue dec) +
                        M0Crypto.Thumb.seqSize [M0Crypto.Thumb.Instr.pop 240 Bool.true] ≤
                      M0Crypto.Artifacts.Release.size →
                    ∀ (s : M0Crypto.Armv6M.State),
                      s.pc = c.base + BitVec.ofNat 32 off →
                        s.regs 13 = c.A →
                          M0Crypto.Release.Aead.Hi c s.mem →
                            (∀ (r : M0Crypto.Armv6M.Reg), 8 ≤ ↑r → ↑r < 12 → s.regs r = c.regs0 r) →
                              BitVec.getLsbD (c.regs0 14) 0 = Bool.true →
                                M0Crypto.Release.Reach c.base (M0Crypto.Release.Aead.SWr c.A) s fun t =>
                                  M0Crypto.Release.Aead.RetPost c (if dec = Bool.true then s.regs 4 else 0#32) t ∧
                                    (∀ (o : Nat), o < 96 → t.mem (c.A + BitVec.ofNat 32 (8 + o)) = 0#8) ∧
                                      ∀ (y : M0Crypto.Armv6M.Word),
                                        ¬M0Crypto.Release.Aead.ClearWr c.A y → t.mem y = s.mem y
M0Crypto.Release.Aead.compare_loop : ∀ (base tag expected : M0Crypto.Armv6M.Word) (M : M0Crypto.Armv6M.Mem)
  (R : M0Crypto.Armv6M.Reg → M0Crypto.Armv6M.Word),
  BitVec.toNat base % 4 = 0 →
    ∀ (rem k : Nat),
      k + rem = 16 →
        k < 16 →
          ∀ (s : M0Crypto.Armv6M.State),
            s.pc = base + BitVec.ofNat 32 M0Crypto.Release.Aead.decCmpLAt →
              s.regs 1 = tag →
                s.regs 2 = expected →
                  s.regs 4 = BitVec.ofNat 32 k →
                    s.mem = M →
                      (∀ (r : M0Crypto.Armv6M.Reg), 6 ≤ ↑r → ↑r ≠ 15 → s.regs r = R r) →
                        (s.regs 3 = 0#32 ↔
                            ∀ (j : Nat), j < k → M (tag + BitVec.ofNat 32 j) = M (expected + BitVec.ofNat 32 j)) →
                          M0Crypto.Release.Reach base (fun x => False) s fun t =>
                            t.pc = base + BitVec.ofNat 32 M0Crypto.Release.Aead.decVerdictAt ∧
                              t.mem = M ∧
                                (∀ (r : M0Crypto.Armv6M.Reg), 6 ≤ ↑r → ↑r ≠ 15 → t.regs r = R r) ∧
                                  (t.regs 3 = 0#32 ↔
                                    M0Crypto.Release.Frame.Ctx.bytesAt M tag 16 =
                                      M0Crypto.Release.Frame.Ctx.bytesAt M expected 16)
M0Crypto.Release.Aead.compare_reach : ∀ (c : M0Crypto.Release.Aead.ACall),
  M0Crypto.Release.Aead.AValid c →
    ∀ (s : M0Crypto.Armv6M.State),
      s.pc = c.base + BitVec.ofNat 32 M0Crypto.Release.Aead.decCmpAAt →
        s.regs 13 = c.A →
          M0Crypto.Release.Aead.Hi c s.mem →
            M0Crypto.Release.Reach c.base (fun x => False) s fun t =>
              t.pc = c.base + BitVec.ofNat 32 M0Crypto.Release.Aead.decVerdictAt ∧
                t.mem = s.mem ∧
                  (∀ (r : M0Crypto.Armv6M.Reg), 6 ≤ ↑r → ↑r ≠ 15 → t.regs r = s.regs r) ∧
                    (t.regs 3 = 0#32 ↔
                      M0Crypto.Release.Frame.Ctx.bytesAt s.mem c.tag 16 =
                        M0Crypto.Release.Frame.Ctx.bytesAt s.mem (c.A + 72#32) 16)
M0Crypto.Release.Aead.decrypt_reach : ∀ (c : M0Crypto.Release.Aead.ACall),
  M0Crypto.Release.Aead.AValid c →
    M0Crypto.Release.Aead.ABuf c →
      ∀ (s : M0Crypto.Armv6M.State),
        M0Crypto.Release.Aead.AEntry c M0Crypto.Release.Aead.decOff s →
          BitVec.getLsbD (c.regs0 14) 0 = Bool.true →
            M0Crypto.Release.Reach c.base (M0Crypto.Release.Aead.DAllowed c) s (M0Crypto.Release.Aead.DecryptResult c)
M0Crypto.Release.Aead.decrypt_correct : ∀ (c : M0Crypto.Release.Aead.ACall) (s : M0Crypto.Armv6M.State),
  M0Crypto.Release.Aead.APre c M0Crypto.Release.Aead.decOff s →
    ∃ n,
      ∀ (fuel : Nat),
        n ≤ fuel →
          ∃ t tr,
            M0Crypto.Thumb.runUntil c.ret fuel s = Except.ok (t, tr) ∧
              M0Crypto.Release.Aead.DecryptResult c t ∧ M0Crypto.Release.WritesTo (M0Crypto.Release.Aead.DAllowed c) tr
M0Crypto.Release.Aead.rejected_writes : ∀ (c : M0Crypto.Release.Aead.ACall) (tr : List M0Crypto.Thumb.Event),
  M0Crypto.Spec.Aead.decrypt c.keyB c.nonceB c.aadB c.ptB c.tagB = Option.none →
    M0Crypto.Release.WritesTo (M0Crypto.Release.Aead.DAllowed c) tr →
      M0Crypto.Release.WritesTo (M0Crypto.Release.Aead.SWr c.A) tr
M0Crypto.Sym.symExec_sound : ∀ (is : List M0Crypto.Thumb.Instr),
  (∀ (i : M0Crypto.Thumb.Instr), i ∈ is → M0Crypto.Sym.Sound i) →
    ∀ (s0 : M0Crypto.Armv6M.State) (ss : M0Crypto.Sym.SState),
      M0Crypto.Sym.SState.denote s0 (M0Crypto.Sym.symExec is ss) =
        M0Crypto.Thumb.execAll is (M0Crypto.Sym.SState.denote s0 ss)
M0Crypto.Sym.sound_basic : ∀ (i : M0Crypto.Thumb.Instr), M0Crypto.Sym.symBasic i = Bool.true → M0Crypto.Sym.Sound i
M0Crypto.Sym.sound_dp : ∀ (op : M0Crypto.Thumb.DpOp) (dn m : M0Crypto.Armv6M.LowReg),
  M0Crypto.Sym.Sound (M0Crypto.Thumb.Instr.dp op dn m)
M0Crypto.Sym.sound_lslImm : ∀ (d m : M0Crypto.Armv6M.LowReg) (imm5 : BitVec 5),
  M0Crypto.Sym.Sound (M0Crypto.Thumb.Instr.lslImm d m imm5)
M0Crypto.Sym.sound_lsrImm : ∀ (d m : M0Crypto.Armv6M.LowReg) (imm5 : BitVec 5),
  M0Crypto.Sym.Sound (M0Crypto.Thumb.Instr.lsrImm d m imm5)
M0Crypto.Sym.sound_ldrLit : ∀ (t : M0Crypto.Armv6M.LowReg) (imm8 : BitVec 8),
  M0Crypto.Sym.Sound (M0Crypto.Thumb.Instr.ldrLit t imm8)
M0Crypto.Sym.sound_ldrSp : ∀ (t : M0Crypto.Armv6M.LowReg) (imm8 : BitVec 8),
  M0Crypto.Sym.Sound (M0Crypto.Thumb.Instr.ldrSp t imm8)
M0Crypto.Sym.sound_strSp : ∀ (t : M0Crypto.Armv6M.LowReg) (imm8 : BitVec 8),
  M0Crypto.Sym.Sound (M0Crypto.Thumb.Instr.strSp t imm8)
M0Crypto.Sym.sound_memImm : ∀ (op : M0Crypto.Thumb.MemOp) (t n : M0Crypto.Armv6M.LowReg) (imm5 : BitVec 5),
  M0Crypto.Sym.Sound (M0Crypto.Thumb.Instr.memImm op t n imm5)
M0Crypto.Sym.sound_memReg : ∀ (op : M0Crypto.Thumb.MemOp) (t n m : M0Crypto.Armv6M.LowReg),
  M0Crypto.Sym.Sound (M0Crypto.Thumb.Instr.memReg op t n m)
M0Crypto.Sym.sound_push : ∀ (l : BitVec 8) (lr : Bool), M0Crypto.Sym.Sound (M0Crypto.Thumb.Instr.push l lr)
M0Crypto.Sym.sound_pop : ∀ (l : BitVec 8), M0Crypto.Sym.Sound (M0Crypto.Thumb.Instr.pop l Bool.false)
M0Crypto.Sym.sound_stm : ∀ (n : M0Crypto.Armv6M.LowReg) (l : BitVec 8),
  M0Crypto.Sym.Sound (M0Crypto.Thumb.Instr.stm n l)
M0Crypto.Sym.sound_ldm : ∀ (n : M0Crypto.Armv6M.LowReg) (l : BitVec 8),
  M0Crypto.Sym.Sound (M0Crypto.Thumb.Instr.ldm n l)
M0Crypto.Sym.sound_of_falls : ∀ (i : M0Crypto.Thumb.Instr), i.falls = Bool.true → M0Crypto.Sym.Sound i
M0Crypto.Sym.symAccesses_sound : ∀ (i : M0Crypto.Thumb.Instr) (s0 : M0Crypto.Armv6M.State) (ss : M0Crypto.Sym.SState),
  List.map (M0Crypto.Sym.SAccess.denote s0) (M0Crypto.Sym.symAccesses i ss) =
    i.accesses (M0Crypto.Sym.SState.denote s0 ss)
M0Crypto.Sym.symTrace_sound : ∀ (is : List M0Crypto.Thumb.Instr),
  (∀ (i : M0Crypto.Thumb.Instr), i ∈ is → M0Crypto.Sym.Sound i) →
    ∀ (s0 : M0Crypto.Armv6M.State) (ss : M0Crypto.Sym.SState),
      List.map (M0Crypto.Sym.SEvent.denote s0) (M0Crypto.Sym.symTrace is ss) =
        M0Crypto.Thumb.traceAll is (M0Crypto.Sym.SState.denote s0 ss)
M0Crypto.Sym.alignedAll_sym : ∀ (is : List M0Crypto.Thumb.Instr),
  (∀ (i : M0Crypto.Thumb.Instr), i ∈ is → M0Crypto.Sym.Sound i) →
    ∀ (s0 : M0Crypto.Armv6M.State) (ss : M0Crypto.Sym.SState),
      M0Crypto.Thumb.alignedAll is (M0Crypto.Sym.SState.denote s0 ss) =
        (M0Crypto.Sym.symTrace is ss).all fun e => e.snd.snd.all fun a => (M0Crypto.Sym.SAccess.denote s0 a).aligned
M0Crypto.Sym.norm_sound : ∀ (s0 : M0Crypto.Armv6M.State) (e : M0Crypto.Sym.SExpr),
  M0Crypto.Sym.SExpr.denote s0 (M0Crypto.Sym.norm e) = M0Crypto.Sym.SExpr.denote s0 e
M0Crypto.Sym.read32_write32_far : ∀ (m : M0Crypto.Armv6M.Mem) (a b v : M0Crypto.Armv6M.Word),
  4 ≤ BitVec.toNat (a - b) ∧ BitVec.toNat (a - b) ≤ 2 ^ 32 - 4 →
    M0Crypto.Armv6M.read32 (M0Crypto.Armv6M.write32 m b v) a = M0Crypto.Armv6M.read32 m a
M0Crypto.Sym.execAll_regs_norm : ∀ (is : List M0Crypto.Thumb.Instr),
  is.all M0Crypto.Thumb.Instr.falls = Bool.true →
    ∀ (s : M0Crypto.Armv6M.State) (r : M0Crypto.Armv6M.Reg),
      (M0Crypto.Thumb.execAll is s).regs r =
        M0Crypto.Sym.SExpr.denote s (M0Crypto.Sym.norm ((M0Crypto.Sym.symExec is M0Crypto.Sym.SState.init).regs r))
M0Crypto.Sym.demo : ∀ (s : M0Crypto.Armv6M.State), (M0Crypto.Thumb.execAll M0Crypto.Sym.demoBlock s).regs 2 = s.regs 0
M0Crypto.Sym.awcK_sound : ∀ (s0 : M0Crypto.Armv6M.State) (a b : M0Crypto.Sym.SExpr) (c : M0Crypto.Sym.SBool),
  M0Crypto.Sym.SExpr.denote s0 (M0Crypto.Sym.awcK a b c) =
    (M0Crypto.Armv6M.addWithCarry (M0Crypto.Sym.SExpr.denote s0 a) (M0Crypto.Sym.SExpr.denote s0 b)
        (M0Crypto.Sym.SBool.denote s0 c)).fst
M0Crypto.Sym.rorK_sound : ∀ (s0 : M0Crypto.Armv6M.State) (a b : M0Crypto.Sym.SExpr) (c : M0Crypto.Sym.SBool),
  M0Crypto.Sym.SExpr.denote s0 (M0Crypto.Sym.rorK a b c) =
    (M0Crypto.Armv6M.rorC (M0Crypto.Sym.SExpr.denote s0 a) (BitVec.toNat (M0Crypto.Sym.SExpr.denote s0 b) % 256)
        (M0Crypto.Sym.SBool.denote s0 c)).fst
M0Crypto.Sym.initK_denote : ∀ (k : List (M0Crypto.Armv6M.Reg × M0Crypto.Armv6M.Word)) (s : M0Crypto.Armv6M.State),
  (∀ (p : M0Crypto.Armv6M.Reg × M0Crypto.Armv6M.Word), p ∈ k → s.regs p.fst = p.snd) →
    M0Crypto.Sym.SState.denote s (M0Crypto.Sym.SState.initK k) = s
M0Crypto.Sym.execAll_regs_normK : ∀ (is : List M0Crypto.Thumb.Instr),
  is.all M0Crypto.Thumb.Instr.falls = Bool.true →
    ∀ (k : List (M0Crypto.Armv6M.Reg × M0Crypto.Armv6M.Word)) (s : M0Crypto.Armv6M.State),
      (∀ (p : M0Crypto.Armv6M.Reg × M0Crypto.Armv6M.Word), p ∈ k → s.regs p.fst = p.snd) →
        ∀ (r : M0Crypto.Armv6M.Reg),
          (M0Crypto.Thumb.execAll is s).regs r =
            M0Crypto.Sym.SExpr.denote s
              (M0Crypto.Sym.norm ((M0Crypto.Sym.symExec is (M0Crypto.Sym.SState.initK k)).regs r))
M0Crypto.Sym.core_regs_sym : ∀ (s : M0Crypto.Armv6M.State),
  M0Crypto.Release.ChaCha20Round.RotRegs s →
    have s' := M0Crypto.Thumb.execAll M0Crypto.Release.ChaCha20Round.core s;
    (s'.regs 0, s'.regs 1, s'.regs 2, s'.regs 3) =
      M0Crypto.Spec.ChaCha20.quarterRound (s.regs 0) (s.regs 1) (s.regs 2) (s.regs 3)
M0Crypto.Sym.read32_execAll_normK : ∀ (is : List M0Crypto.Thumb.Instr),
  is.all M0Crypto.Thumb.Instr.falls = Bool.true →
    ∀ (k : List (M0Crypto.Armv6M.Reg × M0Crypto.Armv6M.Word)) (s : M0Crypto.Armv6M.State),
      (∀ (p : M0Crypto.Armv6M.Reg × M0Crypto.Armv6M.Word), p ∈ k → s.regs p.fst = p.snd) →
        ∀ (aS : M0Crypto.Sym.SExpr),
          M0Crypto.Armv6M.read32 (M0Crypto.Thumb.execAll is s).mem (M0Crypto.Sym.SExpr.denote s aS) =
            M0Crypto.Sym.SExpr.denote s
              (M0Crypto.Sym.norm
                (M0Crypto.Sym.SExpr.ld32 (M0Crypto.Sym.symExec is (M0Crypto.Sym.SState.initK k)).mem aS))
M0Crypto.Sym.innerBlockF_hi : ∀ (g : Nat → M0Crypto.Armv6M.Word) (k : Nat),
  16 ≤ k → M0Crypto.Proofs.ChaCha20DoubleRound.innerBlockF g k = g k
M0Crypto.Sym.inner_view : ∀ (s : M0Crypto.Armv6M.State) (k : Nat),
  M0Crypto.Sym.SExpr.denote s (M0Crypto.Sym.innerS M0Crypto.Sym.inS k) =
    M0Crypto.Proofs.ChaCha20DoubleRound.innerBlockF (M0Crypto.Release.ChaCha20Round.view (Option.some 2) s) k
M0Crypto.Sym.denote_innerS : ∀ (s : M0Crypto.Armv6M.State) (f : Nat → M0Crypto.Sym.SExpr) (k : Nat),
  M0Crypto.Sym.SExpr.denote s (M0Crypto.Sym.innerS f k) =
    M0Crypto.Proofs.ChaCha20DoubleRound.innerBlockF (fun i => M0Crypto.Sym.SExpr.denote s (f i)) k
M0Crypto.Sym.view_wordS : ∀ (s : M0Crypto.Armv6M.State),
  M0Crypto.Release.ChaCha20Round.RotRegs s →
    ∀ (k : Nat),
      k < 16 →
        M0Crypto.Release.ChaCha20Round.view (Option.some 2)
            (M0Crypto.Thumb.execAll M0Crypto.Release.ChaCha20Round.dround s) k =
          M0Crypto.Sym.SExpr.denote s (M0Crypto.Sym.norm (M0Crypto.Sym.wordS k))
M0Crypto.Sym.dword_0 : M0Crypto.Sym.norm (M0Crypto.Sym.wordS 0) =
  M0Crypto.Sym.norm (M0Crypto.Sym.innerS M0Crypto.Sym.inS 0)
M0Crypto.Sym.dword_15 : M0Crypto.Sym.norm (M0Crypto.Sym.wordS 15) =
  M0Crypto.Sym.norm (M0Crypto.Sym.innerS M0Crypto.Sym.inS 15)
M0Crypto.Sym.dround_word : ∀ (k : Nat),
  k < 16 → M0Crypto.Sym.norm (M0Crypto.Sym.wordS k) = M0Crypto.Sym.norm (M0Crypto.Sym.innerS M0Crypto.Sym.inS k)
M0Crypto.Sym.dround_view_sym : ∀ (s : M0Crypto.Armv6M.State),
  M0Crypto.Release.ChaCha20Round.RotRegs s →
    M0Crypto.Release.ChaCha20Round.view (Option.some 2)
        (M0Crypto.Thumb.execAll M0Crypto.Release.ChaCha20Round.dround s) =
      M0Crypto.Proofs.ChaCha20DoubleRound.innerBlockF (M0Crypto.Release.ChaCha20Round.view (Option.some 2) s)
M0Crypto.Release.ChaCha20Output.ach_mem_sym : ∀ (i : Nat),
  i ∈ List.range 16 →
    (M0Crypto.Sym.symExec (M0Crypto.Release.ChaCha20Output.ach i) (M0Crypto.Sym.SState.initK [])).mem =
      M0Crypto.Release.ChaCha20Output.achMemS i
M0Crypto.Release.ChaCha20Output.ach_regs_sym : ∀ (i : Nat),
  i ∈ List.range 16 →
    ∀ (r : M0Crypto.Armv6M.Reg),
      ↑r ≠ 0 →
        ↑r ≠ 1 →
          ↑r ≠ 15 →
            (M0Crypto.Sym.symExec (M0Crypto.Release.ChaCha20Output.ach i) (M0Crypto.Sym.SState.initK [])).regs r =
              M0Crypto.Sym.SExpr.reg0 r
M0Crypto.Release.ChaCha20Output.ach_effect : ∀ (t : M0Crypto.Armv6M.State) (i : Nat),
  i < 16 →
    have u := M0Crypto.Thumb.execAll (M0Crypto.Release.ChaCha20Output.ach i) t;
    u.mem =
        M0Crypto.Armv6M.write32 t.mem (t.regs 3 + BitVec.ofNat 32 (4 * i))
          (M0Crypto.Armv6M.read32 t.mem (M0Crypto.Armv6M.slot (t.regs 13) i) +
              M0Crypto.Armv6M.read32 t.mem
                (M0Crypto.Armv6M.slot (t.regs 13) (M0Crypto.Release.ChaCha20Layout.slotJ + i)) ^^^
            M0Crypto.Armv6M.read32 t.mem (t.regs 2 + BitVec.ofNat 32 (4 * i))) ∧
      ∀ (r : M0Crypto.Armv6M.Reg), ↑r ≠ 0 → ↑r ≠ 1 → ↑r ≠ 15 → u.regs r = t.regs r
M0Crypto.Sym.peel_sound : ∀ (s0 : M0Crypto.Armv6M.State) (e : M0Crypto.Sym.SExpr) (r : M0Crypto.Armv6M.Reg)
  (k : M0Crypto.Armv6M.Word), M0Crypto.Sym.peel e = Option.some (r, k) → M0Crypto.Sym.SExpr.denote s0 e = s0.regs r + k
M0Crypto.Sym.add_toNat_mod_of_dvd : ∀ (x y : M0Crypto.Armv6M.Word) (w : Nat),
  w ∣ 2 ^ 32 → BitVec.toNat x % w = 0 → BitVec.toNat y % w = 0 → BitVec.toNat (x + y) % w = 0
M0Crypto.Sym.accAligned_sound : ∀ (s0 : M0Crypto.Armv6M.State) (al : List (M0Crypto.Armv6M.Reg × Nat)),
  (∀ (p : M0Crypto.Armv6M.Reg × Nat), p ∈ al → BitVec.toNat (s0.regs p.fst) % p.snd = 0) →
    ∀ (a : M0Crypto.Sym.SAccess),
      M0Crypto.Sym.accAligned al a = Bool.true → (M0Crypto.Sym.SAccess.denote s0 a).aligned = Bool.true
M0Crypto.Sym.add_sub_rearr : ∀ (R q k X : M0Crypto.Armv6M.Word), R + k + X = R + q + (k - q + X)
M0Crypto.Sym.accCovered_sound : ∀ (s0 : M0Crypto.Armv6M.State)
  (rg : List (M0Crypto.Armv6M.Reg × M0Crypto.Armv6M.Word × Nat)) (a : M0Crypto.Sym.SAccess),
  M0Crypto.Sym.accCovered rg a = Bool.true →
    ∀ (y : M0Crypto.Armv6M.Word),
      M0Crypto.Thumb.Writes [M0Crypto.Sym.SAccess.denote s0 a] y →
        ∃ p, p ∈ rg ∧ ∃ o, o < p.snd.snd ∧ y = s0.regs p.fst + p.snd.fst + BitVec.ofNat 32 o
M0Crypto.Sym.alignChk_sound : ∀ (al : List (M0Crypto.Armv6M.Reg × Nat)) (is : List M0Crypto.Thumb.Instr),
  (∀ (i : M0Crypto.Thumb.Instr), i ∈ is → M0Crypto.Sym.Sound i) →
    ∀ (s : M0Crypto.Armv6M.State),
      (∀ (p : M0Crypto.Armv6M.Reg × Nat), p ∈ al → BitVec.toNat (s.regs p.fst) % p.snd = 0) →
        M0Crypto.Sym.alignChk al is = Bool.true → M0Crypto.Thumb.alignedAll is s = Bool.true
M0Crypto.Sym.writeChk_sound : ∀ (rg : List (M0Crypto.Armv6M.Reg × M0Crypto.Armv6M.Word × Nat))
  (is : List M0Crypto.Thumb.Instr),
  (∀ (i : M0Crypto.Thumb.Instr), i ∈ is → M0Crypto.Sym.Sound i) →
    ∀ (s : M0Crypto.Armv6M.State),
      M0Crypto.Sym.writeChk rg is = Bool.true →
        ∀ (e : M0Crypto.Thumb.Event),
          e ∈ M0Crypto.Thumb.traceAll is s →
            ∀ (y : M0Crypto.Armv6M.Word),
              M0Crypto.Thumb.Writes e.accesses y →
                ∃ p, p ∈ rg ∧ ∃ o, o < p.snd.snd ∧ y = s.regs p.fst + p.snd.fst + BitVec.ofNat 32 o
@M0Crypto.Release.Reach.symBlock : ∀ {base : M0Crypto.Armv6M.Word} {Wr : M0Crypto.Armv6M.Word → Prop}
  {s : M0Crypto.Armv6M.State} {Q : M0Crypto.Armv6M.State → Prop},
  BitVec.toNat base % 2 = 0 →
    ∀ (al : List (M0Crypto.Armv6M.Reg × Nat)) (rg : List (M0Crypto.Armv6M.Reg × M0Crypto.Armv6M.Word × Nat))
      (is : List M0Crypto.Thumb.Instr) (off : Nat),
      s.pc = base + BitVec.ofNat 32 off →
        off % 2 = 0 →
          M0Crypto.Thumb.seqAt M0Crypto.Release.B off is = Bool.true →
            is.all M0Crypto.Thumb.Instr.falls = Bool.true →
              (∀ (p : M0Crypto.Armv6M.Reg × Nat), p ∈ al → BitVec.toNat (s.regs p.fst) % p.snd = 0) →
                (∀ (p : M0Crypto.Armv6M.Reg × M0Crypto.Armv6M.Word × Nat),
                    p ∈ rg → ∀ (o : Nat), o < p.snd.snd → Wr (s.regs p.fst + p.snd.fst + BitVec.ofNat 32 o)) →
                  M0Crypto.Sym.alignChk al is = Bool.true →
                    M0Crypto.Sym.writeChk rg is = Bool.true →
                      M0Crypto.Release.Reach base Wr (M0Crypto.Thumb.execAll is s) Q →
                        M0Crypto.Release.Reach base Wr s Q
@M0Crypto.Release.Reach.aligned_one : ∀ {s : M0Crypto.Armv6M.State} {r : M0Crypto.Armv6M.Reg} {a : Nat},
  BitVec.toNat (s.regs r) % a = 0 →
    ∀ (p : M0Crypto.Armv6M.Reg × Nat), p ∈ [(r, a)] → BitVec.toNat (s.regs p.fst) % p.snd = 0
@M0Crypto.Release.Reach.region_one : ∀ {Wr : M0Crypto.Armv6M.Word → Prop} {s : M0Crypto.Armv6M.State}
  {r : M0Crypto.Armv6M.Reg} {k : M0Crypto.Armv6M.Word} {n : Nat},
  (∀ (o : Nat), o < n → Wr (s.regs r + k + BitVec.ofNat 32 o)) →
    ∀ (p : M0Crypto.Armv6M.Reg × M0Crypto.Armv6M.Word × Nat),
      p ∈ [(r, k, n)] → ∀ (o : Nat), o < p.snd.snd → Wr (s.regs p.fst + p.snd.fst + BitVec.ofNat 32 o)
M0Crypto.Release.ChaCha20Xor.clear_mem : ∀ (t : M0Crypto.Armv6M.State),
  (M0Crypto.Thumb.execAll M0Crypto.Release.ChaCha20Xor.clr t).mem =
    (M0Crypto.Thumb.execAll (M0Crypto.Release.ChaCha20Xor.stores M0Crypto.Release.ChaCha20Layout.chFrameWords)
        (t.setReg 0 0)).mem
M0Crypto.Release.ChaCha20Xor.clear_regs : ∀ (t : M0Crypto.Armv6M.State),
  have u := M0Crypto.Thumb.execAll M0Crypto.Release.ChaCha20Xor.clr t;
  u.regs 0 = 0 ∧ u.regs 1 = 0 ∧ u.regs 2 = 0 ∧ u.regs 3 = 0 ∧ u.regs 12 = 0 ∧ u.regs 13 = t.regs 13
M0Crypto.Release.ChaCha20Xor.clear_accesses : ∀ (t : M0Crypto.Armv6M.State),
  List.flatMap M0Crypto.Thumb.Event.accesses (M0Crypto.Thumb.traceAll M0Crypto.Release.ChaCha20Xor.clr t) =
    List.map (fun i => { kind := M0Crypto.Thumb.Kind.write, addr := M0Crypto.Armv6M.slot (t.regs 13) i, width := 4 })
      (List.range M0Crypto.Release.ChaCha20Layout.chFrameWords)
M0Crypto.Release.ChaCha20Xor.clear_aligned : ∀ (t : M0Crypto.Armv6M.State),
  BitVec.toNat (t.regs 13) % 4 = 0 → M0Crypto.Thumb.alignedAll M0Crypto.Release.ChaCha20Xor.clr t = Bool.true
M0Crypto.Release.ConstantTime.aligned_chunk_write_pc : ∀ (t : M0Crypto.Armv6M.State) (i : Nat)
  (e : M0Crypto.Thumb.Event),
  e ∈ M0Crypto.Thumb.traceAll (M0Crypto.Release.ChaCha20Output.ach i) t →
    ∀ (y : M0Crypto.Armv6M.Word),
      M0Crypto.Thumb.Writes e.accesses y →
        e.pc = t.pc + BitVec.ofNat 32 (M0Crypto.Thumb.seqSize (M0Crypto.Release.ChaCha20Output.ach i).dropLast)
M0Crypto.Release.ConstantTime.aligned_chunk_read_addresses : ∀ (t : M0Crypto.Armv6M.State) (i : Nat),
  i < 16 →
    ∀ (e : M0Crypto.Thumb.Event),
      e ∈ M0Crypto.Thumb.traceAll (M0Crypto.Release.ChaCha20Output.ach i) t →
        ∀ (y : M0Crypto.Armv6M.Word),
          M0Crypto.Thumb.Reads e.accesses y →
            ∃ q,
              q < 4 ∧
                (y = t.regs 13 + BitVec.ofNat 32 (4 * (M0Crypto.Release.ChaCha20Layout.slotX + i)) + BitVec.ofNat 32 q ∨
                  y =
                      t.regs 13 + BitVec.ofNat 32 (4 * (M0Crypto.Release.ChaCha20Layout.slotJ + i)) +
                        BitVec.ofNat 32 q ∨
                    y = t.regs 2 + BitVec.ofNat 32 (4 * i) + BitVec.ofNat 32 q)
M0Crypto.Release.ConstantTime.aligned_chunk_policy : ∀ (c : M0Crypto.Release.Frame.Ctx),
  M0Crypto.Release.Frame.Valid c →
    ∀ (k i : Nat) (t : M0Crypto.Armv6M.State),
      i < 16 →
        t.regs 3 = c.out + BitVec.ofNat 32 (64 * k) →
          64 * k + 4 * i + 4 ≤ BitVec.toNat c.len →
            ∀ (allowed : M0Crypto.Armv6M.Word → M0Crypto.Thumb.Kind → M0Crypto.Armv6M.Word → Prop),
              (∀ (y : M0Crypto.Armv6M.Word),
                  c.oidx y < BitVec.toNat c.len →
                    allowed
                      (t.pc + BitVec.ofNat 32 (M0Crypto.Thumb.seqSize (M0Crypto.Release.ChaCha20Output.ach i).dropLast))
                      M0Crypto.Thumb.Kind.write y) →
                (∀ (pc : M0Crypto.Armv6M.Word) (q : Nat),
                    q < 4 →
                      allowed pc M0Crypto.Thumb.Kind.read
                          (t.regs 13 + BitVec.ofNat 32 (4 * (M0Crypto.Release.ChaCha20Layout.slotX + i)) +
                            BitVec.ofNat 32 q) ∧
                        allowed pc M0Crypto.Thumb.Kind.read
                            (t.regs 13 + BitVec.ofNat 32 (4 * (M0Crypto.Release.ChaCha20Layout.slotJ + i)) +
                              BitVec.ofNat 32 q) ∧
                          allowed pc M0Crypto.Thumb.Kind.read
                            (t.regs 2 + BitVec.ofNat 32 (4 * i) + BitVec.ofNat 32 q)) →
                  M0Crypto.Release.ConstantTime.EventAccessesTo allowed
                    (M0Crypto.Thumb.traceAll (M0Crypto.Release.ChaCha20Output.ach i) t)
M0Crypto.Release.ConstantTime.chacha20_code_stack_disjoint : ∀ (c : M0Crypto.Release.Frame.Ctx),
  M0Crypto.Release.Frame.Valid c →
    M0Crypto.Release.Frame.Disj c.base M0Crypto.Artifacts.Release.bytes.length
      (c.sp0 - BitVec.ofNat 32 M0Crypto.Release.ConstantTime.chacha20Env.win.below)
      (M0Crypto.Release.ConstantTime.chacha20Env.win.below + M0Crypto.Release.ConstantTime.chacha20Env.win.above)
M0Crypto.Release.ConstantTime.aead_code_stack_disjoint : ∀ (c : M0Crypto.Release.Aead.ACall),
  M0Crypto.Release.Aead.AValid c →
    M0Crypto.Release.Frame.Disj c.base M0Crypto.Artifacts.Release.bytes.length
      (c.sp0 - BitVec.ofNat 32 M0Crypto.Release.ConstantTime.encryptEnv.win.below)
      (M0Crypto.Release.ConstantTime.encryptEnv.win.below + M0Crypto.Release.ConstantTime.encryptEnv.win.above)
M0Crypto.Release.ConstantTime.chacha20_code_no_wrap : ∀ (c : M0Crypto.Release.Frame.Ctx),
  M0Crypto.Release.Frame.Valid c → BitVec.toNat c.base + M0Crypto.Artifacts.Release.bytes.length ≤ 2 ^ 32
M0Crypto.Release.ConstantTime.aead_code_no_wrap : ∀ (c : M0Crypto.Release.Aead.ACall),
  M0Crypto.Release.Aead.AValid c → BitVec.toNat c.base + M0Crypto.Artifacts.Release.bytes.length ≤ 2 ^ 32
