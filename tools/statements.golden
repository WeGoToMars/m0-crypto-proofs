@M0Crypto.Release.Blake2sCompress.compress_correct : ∀ {base : M0Crypto.Armv6M.Word} {s : M0Crypto.Armv6M.State},
  M0Crypto.Release.Blake2sCompress.Entry base s →
    (∀ (i : Nat), i < M0Crypto.Artifacts.Release.size → s.regs 14 &&& ~~~1#32 ≠ base + BitVec.ofNat 32 i) →
      ∃ n,
        ∀ (fuel : Nat),
          n ≤ fuel →
            ∃ t tr,
              M0Crypto.Thumb.runUntil (s.regs 14 &&& ~~~1#32) fuel s = Except.ok (t, tr) ∧
                M0Crypto.Release.Blake2sCompress.Post s t ∧
                  M0Crypto.Release.WritesTo (M0Crypto.Release.Blake2sCompress.WrOf s) tr
@M0Crypto.Release.Blake2sCompress.compress_constant_time : ∀ {base : M0Crypto.Armv6M.Word}
  {s₁ s₂ : M0Crypto.Armv6M.State},
  M0Crypto.Release.Blake2sCompress.Entry base s₁ →
    M0Crypto.Release.Blake2sCompress.Entry base s₂ →
      M0Crypto.Release.Blake2sCompress.CtExtra base s₁ →
        (∀ (i : Nat), i < M0Crypto.Artifacts.Release.size → s₁.regs 14 &&& ~~~1#32 ≠ base + BitVec.ofNat 32 i) →
          s₂.pc = s₁.pc →
            s₂.regs 13 = s₁.regs 13 →
              s₂.regs 14 = s₁.regs 14 →
                (∀ (r : M0Crypto.Armv6M.Reg), ↑r < 4 → s₂.regs r = s₁.regs r) →
                  M0Crypto.Armv6M.read32 s₂.mem (s₁.regs 13) = M0Crypto.Armv6M.read32 s₁.mem (s₁.regs 13) →
                    ∀ (fuel : Nat),
                      Except.map Prod.snd (M0Crypto.Thumb.runUntil (s₁.regs 14 &&& ~~~1#32) fuel s₁) =
                        Except.map Prod.snd (M0Crypto.Thumb.runUntil (s₁.regs 14 &&& ~~~1#32) fuel s₂)
