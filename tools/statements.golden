@M0Crypto.Thumb.decode_at : ∀ {m : M0Crypto.Armv6M.Mem} {base : M0Crypto.Armv6M.Word} {bytes : List (BitVec 8)},
  M0Crypto.Thumb.CodeAt m base bytes →
    ∀ (off : Nat) (i : M0Crypto.Thumb.Instr),
      M0Crypto.Thumb.instrAt bytes off = Option.some i →
        off + i.size ≤ bytes.length →
          M0Crypto.Thumb.decode (M0Crypto.Thumb.fetch16 m (base + BitVec.ofNat 32 off))
              (M0Crypto.Thumb.fetch16 m (base + BitVec.ofNat 32 off + 2#32)) =
            Option.some i
@M0Crypto.Thumb.step_of_instrAt : ∀ {s s' : M0Crypto.Armv6M.State} {base : M0Crypto.Armv6M.Word}
  {bytes : List (BitVec 8)},
  M0Crypto.Thumb.CodeAt s.mem base bytes →
    ∀ (off : Nat) (i : M0Crypto.Thumb.Instr),
      s.pc = base + BitVec.ofNat 32 off →
        BitVec.getLsbD (base + BitVec.ofNat 32 off) 0 = Bool.false →
          M0Crypto.Thumb.instrAt bytes off = Option.some i →
            off + i.size ≤ bytes.length →
              (i.accesses s).all M0Crypto.Thumb.Access.aligned = Bool.true →
                i.exec s = Except.ok s' →
                  M0Crypto.Thumb.step s = Except.ok (s', { pc := s.pc, instr := i, accesses := i.accesses s })
M0Crypto.Thumb.exec_mem_other : ∀ (i : M0Crypto.Thumb.Instr) (s s' : M0Crypto.Armv6M.State),
  i.exec s = Except.ok s' → ∀ (y : M0Crypto.Armv6M.Word), ¬M0Crypto.Thumb.Writes (i.accesses s) y → s'.mem y = s.mem y
M0Crypto.Thumb.exec_reads_only : ∀ (i : M0Crypto.Thumb.Instr) (s : M0Crypto.Armv6M.State) (m : M0Crypto.Armv6M.Mem),
  (∀ (y : M0Crypto.Armv6M.Word), M0Crypto.Thumb.Reads (i.accesses s) y → m y = s.mem y) →
    match i.exec s, i.exec { regs := s.regs, n := s.n, z := s.z, c := s.c, v := s.v, mem := m } with
    | Except.ok t, Except.ok t' =>
      t'.regs = t.regs ∧
        t'.n = t.n ∧
          t'.z = t.z ∧
            t'.c = t.c ∧
              t'.v = t.v ∧
                ∀ (y : M0Crypto.Armv6M.Word),
                  m y = s.mem y ∨ M0Crypto.Thumb.Writes (i.accesses s) y → t'.mem y = t.mem y
    | Except.error e, Except.error e' => e' = e
    | x, x_1 => False
