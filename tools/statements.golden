  M0Crypto.Thumb.runFast stop fuel s = M0Crypto.Thumb.runUntil stop fuel s
M0Crypto.Artifacts.Release.bytes_length : M0Crypto.Artifacts.Release.bytes.length = M0Crypto.Artifacts.Release.size
@M0Crypto.Thumb.step_of_stepH : ∀ {bytes : List (BitVec 8)} {base : M0Crypto.Armv6M.Word} {s s' : M0Crypto.Armv6M.State}
  {e : M0Crypto.Thumb.Event},
  M0Crypto.Thumb.CodeAt s.mem base bytes →
    M0Crypto.Thumb.stepH bytes base s = Except.ok (s', e) → M0Crypto.Thumb.step s = Except.ok (s', e)
@M0Crypto.Thumb.runUntil_of_runH : ∀ {bytes : List (BitVec 8)} {base stop : M0Crypto.Armv6M.Word} (n fuel : Nat)
  (s s' : M0Crypto.Armv6M.State) (tr : List M0Crypto.Thumb.Event),
  M0Crypto.Thumb.CodeAt s.mem base bytes →
    M0Crypto.Thumb.runH bytes base n s = Except.ok (s', tr) →
      M0Crypto.Thumb.TraceMissesCode bytes base tr →
        (∀ (e : M0Crypto.Thumb.Event), e ∈ tr → e.pc ≠ stop) →
          s'.pc = stop → n ≤ fuel → M0Crypto.Thumb.runUntil stop fuel s = Except.ok (s', tr)
@M0Crypto.Thumb.runH_add : ∀ {bytes : List (BitVec 8)} {base : M0Crypto.Armv6M.Word} (m n : Nat)
  (s : M0Crypto.Armv6M.State),
  M0Crypto.Thumb.runH bytes base (m + n) s =
    match M0Crypto.Thumb.runH bytes base m s with
    | Except.error e => Except.error e
    | Except.ok (s1, t1) =>
      match M0Crypto.Thumb.runH bytes base n s1 with
      | Except.error e => Except.error e
      | Except.ok (s2, t2) => Except.ok (s2, t1 ++ t2)
@M0Crypto.Thumb.runH_seq : ∀ {bytes : List (BitVec 8)} {base : M0Crypto.Armv6M.Word},
  BitVec.toNat base % 2 = 0 →
    bytes.length < 2 ^ 32 →
      ∀ (is : List M0Crypto.Thumb.Instr) (off : Nat) (s : M0Crypto.Armv6M.State),
        s.pc = base + BitVec.ofNat 32 off →
          off % 2 = 0 →
            M0Crypto.Thumb.seqAt bytes off is = Bool.true →
              is.all M0Crypto.Thumb.Instr.falls = Bool.true →
                M0Crypto.Thumb.runH bytes base is.length s = M0Crypto.Thumb.runSeq is s
M0Crypto.Thumb.runSeq_eq : ∀ (is : List M0Crypto.Thumb.Instr) (s : M0Crypto.Armv6M.State),
  is.all M0Crypto.Thumb.Instr.falls = Bool.true →
    M0Crypto.Thumb.alignedAll is s = Bool.true →
      M0Crypto.Thumb.runSeq is s = Except.ok (M0Crypto.Thumb.execAll is s, M0Crypto.Thumb.traceAll is s)
