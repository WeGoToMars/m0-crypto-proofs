def M0Crypto.Release.Blake2sHash.PubEq : Nat → M0Crypto.Armv6M.State → M0Crypto.Armv6M.State → Prop :=
fun np s s' =>
  s'.pc = s.pc ∧
    s'.regs 13 = s.regs 13 ∧ s'.regs 14 = s.regs 14 ∧ ∀ (r : M0Crypto.Armv6M.Reg), ↑r < np → s'.regs r = s.regs r
def M0Crypto.Release.Blake2sHash.TraceEq : M0Crypto.Armv6M.State → M0Crypto.Armv6M.State → Prop :=
fun s s' =>
  ∀ (fuel : Nat),
    Except.map Prod.snd (M0Crypto.Thumb.runUntil (s.regs 14 &&& ~~~1#32) fuel s) =
      Except.map Prod.snd (M0Crypto.Thumb.runUntil (s.regs 14 &&& ~~~1#32) fuel s')
